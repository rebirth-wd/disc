---
// Preview page for the global agent: header (top + scrolled state), Button variants, Starfield, footer.
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import Starfield from '@components/graphics/stars/Starfield.astro';
import LogoMark from '@components/layout/LogoMark.astro';
---
<BaseLayout title="Preview — global" active="services">
  <section data-section="preview-hero" data-nav-trigger class="relative h-[870px] overflow-hidden bg-deep-indigo">
    <Starfield density={1.2} />
    <div class="relative flex h-full flex-col items-center justify-center gap-24">
      <h1 class="font-display text-display leading-display tracking-display font-bold uppercase text-white">Global preview</h1>
      <div class="flex flex-wrap items-center justify-center gap-24" data-button-row>
        <Button variant="white" href="#" icon="download">Start your website</Button>
        <Button variant="blurple" href="#">See our recent launches</Button>
        <Button variant="white" href="#">Plain white</Button>
        <Button variant="nav" href="#">Contact</Button>
      </div>
      <div class="flex items-center gap-24 text-white"><LogoMark size={64} /><LogoMark size={32} /><LogoMark size={16} /></div>
    </div>
  </section>
  <section data-section="preview-starfield" class="relative mx-auto my-128 h-[610px] max-w-[1240px] overflow-hidden rounded-5xl bg-black">
    <Starfield density={2} seed={11} />
  </section>
  <section data-section="preview-tall" class="relative h-[2400px]">
    <Starfield density={0.6} seed={3} />
  </section>
</BaseLayout>
