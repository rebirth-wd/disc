---
import BaseLayout from '@layouts/BaseLayout.astro';
import Starfield from '@components/graphics/stars/Starfield.astro';
import FeatureAssistant from '@components/sections/home/FeatureAssistant.astro';
import FeatureSpeed from '@components/sections/home/FeatureSpeed.astro';
import FeatureMonitoring from '@components/sections/home/FeatureMonitoring.astro';
---
<BaseLayout title="Preview — home features A" chrome={false}>
  <div class="relative bg-deep-indigo">
    <Starfield density={2} seed={11} />
    <div class="h-[400px]"></div>
    <FeatureAssistant />
    <FeatureSpeed />
    <FeatureMonitoring />
    <div class="h-[400px]"></div>
  </div>
</BaseLayout>
