import Feature1 from '@components/home/Feature1.astro';
import Feature2 from '@components/home/Feature2.astro';
import Feature3 from '@components/home/Feature3.astro';
---
<BaseLayout title="Preview — home features A" chrome={false}>
  <div class="relative bg-deep-indigo">
    <Starfield density={2} seed={11} />
    <div class="h-[400px]"></div>
    <Feature1 />
    <Feature2 />
    <Feature3 />
    <div class="h-[400px]"></div>
  </div>
</BaseLayout>
