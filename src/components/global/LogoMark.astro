---
// Rebirth mark — an original "rising spark" glyph: a chunky rounded tile with a
// phoenix-like chevron wing and a pixel star cut out of it. Uses currentColor.
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: cls = '' } = Astro.props;
---

<svg
  data-logo-mark
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    fill="currentColor"
    fill-rule="evenodd"
    d="M9 2h14a7 7 0 0 1 7 7v14a7 7 0 0 1-7 7H9a7 7 0 0 1-7-7V9a7 7 0 0 1 7-7Zm7 4.5 1.6 3.9 3.9 1.6-3.9 1.6L16 17.5l-1.6-3.9-3.9-1.6 3.9-1.6L16 6.5ZM6.5 15.5 16 25l9.5-9.5v5L16 30l-9.5-9.5v-5Z"
  />
</svg>
