---
// Global footer. Reference: `div.footer_new` (854px at 1680; 861px on the home page).
// Motion (reference IX2): "Arrow-move 3" (language chevron 180deg / 200ms),
// "Footer-drop 3" (<=767px column accordions: height 0 -> auto 200ms + chevron 180deg / 200ms).
import LogoMark from './LogoMark.astro';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const cols = [
  { title: 'Product', links: [['Services', '/download'], ['Plans', '/nitro'], ['Status', '#'], ['Showcase', '#'], ['Care Plans', '#']] },
  { title: 'Company', links: [['About', '#'], ['Careers', '/careers'], ['Brand', '#'], ['Newsroom', '#']] },
  { title: 'Resources', links: [['Support', '#'], ['Stack', '#'], ['Blog', '#'], ['Creators', '#'], ['Community', '#'], ['AI Toolkit', '#'], ['Growth', '/ads/quests'], ['Bundaberg Web Design', '#'], ['Feedback', '#']] },
  { title: 'Policies', links: [['Terms', '#'], ['Privacy', '#'], ['Cookie Settings', '#'], ['Guidelines', '#'], ['Acknowledgements', '#'], ['Licences', '#'], ['Company Information', '#']] },
];
const langs = ['English', 'English (AU)', 'English (UK)', 'Deutsch', 'Español', 'Français', 'Italiano', '日本語'];
const socials = ['Chat', 'Photos', 'Community', 'Video', 'Feed'];
---
<footer class:list={['rb-footer', isHome && 'rb-footer--home']} data-section="global-footer">
  <div class="rb-footer__container">
    <div class="rb-footer__grid">
      <div class="rb-footer__left">
        <a href="/" class="rb-footer__logo" aria-label="Rebirth Web Design — home"><LogoMark size={44} /></a>
        <div class="rb-footer__label" id="rb-lang-label">Language</div>
        <div class="rb-lang" data-lang>
          <button type="button" class="rb-lang__btn" data-lang-btn aria-haspopup="listbox" aria-expanded="false" aria-labelledby="rb-lang-label rb-lang-name">
            <span id="rb-lang-name" data-lang-name>English</span>
            <svg data-lang-arrow width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 9l-6 6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <ul class="rb-lang__list" data-lang-list role="listbox" aria-labelledby="rb-lang-label" hidden>
            {langs.map((l, i) => <li role="option" tabindex="0" aria-selected={i === 0 ? 'true' : 'false'} class="rb-lang__item">{l}</li>)}
          </ul>
        </div>
        <div class="rb-footer__social rb-footer__social--desk">
          <div class="rb-footer__label">Social</div>
          <div class="rb-footer__icons">
            {socials.map((s, i) => (
              <a href="#" class="rb-footer__icon" aria-label={s}>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  {i === 0 && <path fill="currentColor" d="M5 3h14a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-6l-5 4v-4H5a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm2 5v2h10V8H7Zm0 4v2h6v-2H7Z" />}
                  {i === 1 && <path fill="currentColor" fill-rule="evenodd" d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm5 5.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Zm0 2.2a2.3 2.3 0 1 1 0 4.6 2.3 2.3 0 0 1 0-4.6ZM17.5 5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z" />}
                  {i === 2 && <path fill="currentColor" fill-rule="evenodd" d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20Zm0 4a3.2 3.2 0 1 0 0 6.4A3.2 3.2 0 0 0 12 6Zm0 8c-2.6 0-4.8 1.2-6 3a8 8 0 0 0 12 0c-1.2-1.8-3.4-3-6-3Z" />}
                  {i === 3 && <path fill="currentColor" fill-rule="evenodd" d="M5 4h14a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H5a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4Zm5 4.5v7l6-3.5-6-3.5Z" />}
                  {i === 4 && <path fill="currentColor" d="M4 3a17 17 0 0 1 17 17h-3.4A13.6 13.6 0 0 0 4 6.4V3Zm0 7a10 10 0 0 1 10 10h-3.4A6.6 6.6 0 0 0 4 13.4V10Zm2.5 5.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z" />}
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="rb-footer__menulabel">Menu</div>
      {cols.map((c, i) => (
        <div class:list={['rb-footer__col', `rb-footer__col--${i + 1}`]} data-fcol>
          <h3 class="rb-footer__heading">{c.title}</h3>
          <button type="button" class="rb-footer__toggle" data-fcol-toggle aria-expanded="false" aria-controls={`rb-fcol-${i}`}>
            <span>{c.title}</span>
            <svg data-fcol-arrow width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 9l-6 6-6-6" stroke="currentColor" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <nav class="rb-footer__links" id={`rb-fcol-${i}`} data-fcol-list aria-label={c.title}>
            {c.links.map(([label, href]) => <a href={href} class="rb-footer__link">{label}</a>)}
          </nav>
        </div>
      ))}

      <div class="rb-footer__social rb-footer__social--mob">
        <div class="rb-footer__label">Social</div>
        <div class="rb-footer__icons" data-icons-clone></div>
      </div>
    </div>
  </div>

  <div class="rb-footer__word" aria-hidden="true">
    <svg viewBox="0 0 1600 254" preserveAspectRatio="none" role="presentation">
      <text x="-16" y="252" textLength="1632" lengthAdjust="spacingAndGlyphs">REBIRTH</text>
    </svg>
  </div>
</footer>

<style>
  .rb-footer {
    /* measured on the reference footer gradient image: #1a185e (top) -> #5562ed (bottom), black base */
    --rb-footer-top: #1a185e;
    position: relative; z-index: 98; display: flex; flex-direction: column; align-items: center;
    padding-top: var(--spacing-20);
    background-color: var(--color-black);
    background-image:
      radial-gradient(120% 70% at 50% 45%, rgba(88, 101, 242, 0.12), rgba(88, 101, 242, 0) 70%),
      linear-gradient(180deg, var(--rb-footer-top) 0%, #1f1e6a 23%, #2b2e89 46%, #3f46b7 70%, #4e5adc 93%, var(--color-blurple) 108%);
    color: var(--color-white); font-family: var(--font-abc-ginto-discord);
  }
  .rb-footer__container { position: relative; box-sizing: border-box; width: 100%; margin-top: 80px; padding: 0 var(--page-gutter); }
  .rb-footer__grid { display: grid; grid-template-columns: repeat(4, 1fr) repeat(8, 90px); gap: var(--spacing-20); align-items: start; }
  .rb-footer__left { grid-column: span 4; display: flex; flex-direction: column; align-items: flex-start; }
  .rb-footer__col { grid-column: span 2; }
  .rb-footer__logo { display: block; width: 59px; height: 51px; margin-bottom: var(--spacing-40); color: var(--color-white); }
  .rb-footer__label, .rb-footer__heading, .rb-footer__menulabel {
    margin: 0; color: var(--color-white-70); font-family: var(--font-abc-ginto-discord); text-transform: none; letter-spacing: 0;
    font-size: var(--text-label); line-height: var(--leading-label); font-weight: var(--font-weight-regular);
  }
  .rb-footer__menulabel, .rb-footer__toggle, .rb-footer__social--mob { display: none; }

  .rb-lang { position: relative; z-index: 3; width: 100%; max-width: 314px; margin-top: var(--spacing-16); }
  .rb-lang__btn {
    display: flex; justify-content: space-between; align-items: center; gap: var(--spacing-8); box-sizing: border-box; width: 100%; height: 56px;
    padding: 17.5px var(--spacing-16) 17.5px var(--spacing-24); border: 0; border-radius: var(--radius-inputs);
    background: var(--color-white-10); color: var(--color-white); cursor: pointer; text-align: left;
    font-family: inherit; font-size: 16px; line-height: 24px; font-weight: var(--font-weight-regular); transition: all 0.3s;
  }
  .rb-lang__btn:focus-visible { outline: 2px solid var(--color-blurple); outline-offset: 4px; }
  .rb-lang__list {
    position: absolute; left: 0; right: 0; top: 100%; margin: 11px 0 0; padding: var(--spacing-8); list-style: none;
    max-height: 264px; overflow-y: auto; border-radius: 24px; background: #5b62c7;
  }
  .rb-lang__item { padding: 17.5px var(--spacing-16); border-radius: var(--radius-lg); cursor: pointer; font-size: 16px; line-height: 24px; }
  .rb-lang__item:hover, .rb-lang__item:focus-visible { background: var(--color-white-10); outline: none; }

  .rb-footer__social--desk { margin-top: var(--spacing-48); }
  .rb-footer__icons { display: flex; align-items: flex-start; margin-top: var(--spacing-16); height: 32px; }
  .rb-footer__icon { display: block; width: 24px; height: 32px; margin-right: 29px; color: var(--color-white); }
  .rb-footer__icon:focus-visible, .rb-footer__link:focus-visible, .rb-footer__logo:focus-visible { outline: 2px solid var(--color-white); outline-offset: 2px; }

  .rb-footer__links { display: block; }
  .rb-footer__link {
    display: block; margin-top: var(--spacing-12); color: var(--color-white); text-decoration: none;
    font-size: var(--text-body); line-height: var(--leading-body); font-weight: var(--font-weight-regular); transition: all 0.3s;
  }
  .rb-footer__link:hover { text-decoration: underline; }

  /* oversized wordmark: 1600 x 254 box at 1680 (aspect 6.3:1), padding 76/40/40, pale lavender */
  .rb-footer__word { box-sizing: border-box; width: 100%; max-width: 1762px; margin-top: var(--spacing-40); padding: 76px var(--page-gutter) var(--spacing-40); }
  .rb-footer--home .rb-footer__word { padding-bottom: 47px; }
  .rb-footer__word svg { display: block; width: 100%; height: auto; aspect-ratio: 1600 / 254; overflow: visible; }
  .rb-footer__word text {
    fill: #e0e3ff; font-family: var(--font-abc-ginto-discord-nord); font-weight: 900; font-size: 334px; letter-spacing: 0;
  }

  @media (min-width: 1920px) {
    .rb-footer__container, .rb-footer__word { max-width: 1762px; padding-left: 0; padding-right: 0; }
  }
  @media (max-width: 1439px) {
    .rb-footer__grid { grid-template-columns: repeat(12, 1fr); }
  }
  @media (max-width: 991px) {
    .rb-footer { z-index: 10; overflow: clip; }
    .rb-footer__grid { grid-template-columns: 269px 153px auto; column-gap: 79px; row-gap: 62px; justify-content: start; padding-bottom: 62px; }
    .rb-footer__left { grid-column: 1; grid-row: 1 / span 3; width: 269px; }
    .rb-lang { max-width: 269px; }
    .rb-footer__col { grid-column: auto; }
    .rb-footer__col--1, .rb-footer__col--3 { grid-column: 2; }
    .rb-footer__col--2, .rb-footer__col--4 { grid-column: 3; }
    .rb-footer__social--desk { display: none; }
    .rb-footer__social--mob { display: block; grid-column: 2 / span 2; }
    .rb-footer__word, .rb-footer--home .rb-footer__word { margin-top: 0; padding: var(--spacing-20); }
  }
  @media (max-width: 767px) {
    .rb-footer { z-index: 97; }
    .rb-footer__container { padding: 0 var(--spacing-24); }
    .rb-footer__grid { display: block; padding-bottom: 0; }
    .rb-footer__left { width: auto; }
    .rb-footer__logo { width: 33px; height: 24px; }
    .rb-footer__logo :global(svg) { width: 24px; height: 24px; }
    .rb-footer__label, .rb-footer__menulabel { font-size: 14px; line-height: 18px; }
    .rb-lang { max-width: 342px; margin-top: var(--spacing-12); margin-bottom: var(--spacing-56); }
    .rb-footer__menulabel { display: block; margin-top: var(--spacing-24); }
    .rb-footer__heading { display: none; }
    .rb-footer__col { padding-bottom: var(--spacing-24); background: linear-gradient(var(--color-white-10), var(--color-white-10)) bottom / 100% 2px no-repeat; overflow: clip; }
    .rb-footer__col--4 { background: none; }
    .rb-footer__toggle {
      display: flex; justify-content: space-between; align-items: center; gap: var(--spacing-24); width: 100%; padding: var(--spacing-24) 0 0; border: 0; background: none;
      color: var(--color-white-70); cursor: pointer; font-family: inherit; font-size: 18px; line-height: 20px; font-weight: var(--font-weight-medium); text-align: left;
    }
    .rb-footer__toggle svg { height: 20px; }
    .rb-footer__toggle:focus-visible { outline: 2px solid var(--color-white); outline-offset: 2px; }
    .rb-footer__links { height: 0; overflow: hidden; }
    .rb-footer__links > :first-child { margin-top: var(--spacing-12); }
    .rb-footer__link { margin: 0; padding: var(--spacing-16) 0; font-size: 14px; line-height: 18px; }
    .rb-footer__social--mob { margin-top: 80px; }
    .rb-footer__icons { height: 24px; }
    .rb-footer__icon { height: 24px; }
    .rb-footer__word, .rb-footer--home .rb-footer__word { padding: 80px var(--spacing-24) var(--spacing-24); }
  }
</style>

<script>
  import gsap from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-section="global-footer"]');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const T = (s: number) => (reduce ? 0 : s);

    // one icon row in the markup, mirrored for the <=991 layout
    const src = root.querySelector('.rb-footer__social--desk .rb-footer__icons');
    const dst = root.querySelector('[data-icons-clone]');
    if (src && dst) dst.innerHTML = src.innerHTML;

    /* language select — IX2 "Arrow-move 3": chevron 0 -> 180deg, 200ms */
    const lang = root.querySelector<HTMLElement>('[data-lang]')!;
    const btn = lang.querySelector<HTMLElement>('[data-lang-btn]')!;
    const list = lang.querySelector<HTMLElement>('[data-lang-list]')!;
    const arrow = lang.querySelector('[data-lang-arrow]');
    const name = lang.querySelector<HTMLElement>('[data-lang-name]')!;
    const setLang = (open: boolean) => {
      list.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      gsap.to(arrow, { rotation: open ? 180 : 0, transformOrigin: '50% 50%', duration: T(0.2), ease: 'none', overwrite: true });
    };
    btn.addEventListener('click', () => setLang(list.hidden));
    const pick = (li: HTMLElement) => {
      list.querySelectorAll('[role="option"]').forEach((o) => o.setAttribute('aria-selected', String(o === li)));
      name.textContent = li.textContent;
      setLang(false);
      btn.focus();
    };
    list.addEventListener('click', (e) => { const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]'); if (li) pick(li); });
    list.addEventListener('keyup', (e) => { if (e.key === 'Enter') { const li = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]'); if (li) pick(li); } });
    document.addEventListener('click', (e) => { if (!lang.contains(e.target as Node) && !list.hidden) setLang(false); });
    document.addEventListener('keyup', (e) => { if (e.key === 'Escape' && !list.hidden) setLang(false); });

    /* <=767: column accordions — IX2 "Footer-drop 3": height 0 -> auto 200ms, chevron 180deg 200ms */
    const mm = gsap.matchMedia();
    mm.add('(max-width: 767px)', () => {
      const offs: Array<() => void> = [];
      root.querySelectorAll<HTMLElement>('[data-fcol]').forEach((col) => {
        const toggle = col.querySelector<HTMLElement>('[data-fcol-toggle]')!;
        const links = col.querySelector<HTMLElement>('[data-fcol-list]')!;
        const chev = col.querySelector('[data-fcol-arrow]');
        const on = () => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          toggle.setAttribute('aria-expanded', String(open));
          gsap.to(links, { height: open ? 'auto' : 0, duration: T(0.2), ease: 'none', overwrite: true });
          gsap.to(chev, { rotation: open ? 180 : 0, transformOrigin: '50% 50%', duration: T(0.2), ease: 'none', overwrite: true });
        };
        toggle.addEventListener('click', on);
        offs.push(() => { toggle.removeEventListener('click', on); toggle.setAttribute('aria-expanded', 'false'); gsap.set([links, chev], { clearProps: 'all' }); });
      });
      return () => offs.forEach((f) => f());
    });
  }
</script>
