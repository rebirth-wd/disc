---
// Global header. Reference: `header.nav` (80px transparent bar, fixed logo lockup left,
// centred link row with dropdown panels, fixed white nav button right, scrolled pill state,
// burger menu under 992px). Motion parameters come from the reference IX2 lists
// "Nav-dd-open/close", "scroll-logo-bg", "Navbar BG color changes when scrolling",
// "Nav Menu [open]/[close]" (+ MOBILE variants).
import Button from './Button.astro';
import LogoMark from './LogoMark.astro';

interface Props { active?: string }
const { active = '' } = Astro.props;

type Link = { label: string; href: string; ext?: boolean };
type List = { title: string; links: Link[] };
type Item =
  | { kind: 'link'; id: string; label: string; href: string }
  | { kind: 'dd'; id: string; label: string; href: string; decor: string; cols: List[][] };

const L = (label: string, href = '#', ext = false): Link => ({ label, href, ext });

// Same item count / order / dropdown shapes as the reference row
// (2 links, 6 dropdowns, 1 link). The five built routes are real, the rest are "#".
const items: Item[] = [
  { kind: 'link', id: 'download', label: 'Services', href: '/download' },
  { kind: 'link', id: 'nitro', label: 'Plans', href: '/nitro' },
  { kind: 'dd', id: 'showcase', label: 'Showcase', href: '#', decor: 'plane',
    cols: [[{ title: 'Our work', links: [L('Recent Launches'), L('Case Studies')] }]] },
  { kind: 'dd', id: 'stack', label: 'Stack', href: '#', decor: 'shield',
    cols: [
      [{ title: 'Platform', links: [L('Built on Astro'), L('GitHub Workflow'), L('Cloudflare Edge'), L('Static-first'), L('Security by Design')] }],
      [{ title: 'Guides', links: [L('Speed Guide'), L('SEO Guide'), L('Hosting Guide'), L('Maintenance Guide'), L('AI Readiness')] }],
    ] },
  { kind: 'dd', id: 'quests', label: 'Growth', href: '/ads/quests', decor: 'rocket',
    cols: [[{ title: 'Resources', links: [L('Campaigns', '/ads/quests'), L('Success Stories'), L('Growth FAQ')] }]] },
  { kind: 'dd', id: 'support', label: 'Support', href: '#', decor: 'buoy',
    cols: [[{ title: 'Resources', links: [L('Help Centre'), L('Feedback'), L('Start a Project')] }]] },
  { kind: 'dd', id: 'blog', label: 'Blog', href: '#', decor: 'pencil',
    cols: [[{ title: 'Collections', links: [L('Featured'), L('Bundaberg'), L('Rebirth HQ'), L('Engineering & Stack'), L('How to Launch'), L('SEO & Speed'), L('AI & Automation')] }]] },
  { kind: 'dd', id: 'ai', label: 'AI Toolkit', href: '#', decor: 'cube',
    cols: [[
      { title: 'Learn', links: [L('AI for Local Business'), L('Integrations'), L('Personalisation'), L('Agents & Crawlers'), L('Toolkit Newsletter'), L('Toolkit Case Studies')] },
      { title: 'Build', links: [L('Open Source Starters', '#', true), L('Client Portal', '#', true), L('Documentation', '#', true), L('Developer Help Desk', '#', true)] },
    ]] },
  { kind: 'link', id: 'careers', label: 'Careers', href: '/careers' },
];
const isActive = (id: string) => active === id || (id === 'quests' && active === 'quests');
---
<header class="rb-nav" data-section="global-header" data-active={active}>
  <div class="rb-nav__pad">
    <div class="rb-nav__wrap">
      <a href="#main" class="rb-skip" data-skip>Skip to main content</a>

      <a href="/" class="rb-brand" data-brand aria-label="Rebirth Web Design — home">
        <span class="rb-brand__light" data-brand-light>
          <LogoMark size={28} />
          <span class="rb-brand__word">Rebirth</span>
        </span>
        <span class="rb-brand__pill" data-brand-pill aria-hidden="true">
          <LogoMark size={22} />
          <span class="rb-brand__word rb-brand__word--sm">Rebirth</span>
        </span>
      </a>

      <nav class="rb-menu" aria-label="Primary">
        <ul class="rb-menu__list" role="list">
          {items.map((it) => it.kind === 'link' ? (
            <li><a href={it.href} class="rb-link" aria-current={isActive(it.id) ? 'page' : undefined}>{it.label}</a></li>
          ) : (
            <li class="rb-dd" data-dd>
              <a href={it.href} class="rb-dd__trigger" data-dd-trigger aria-haspopup="true" aria-expanded="false"
                aria-controls={`rb-dd-${it.id}`} aria-current={isActive(it.id) ? 'page' : undefined}>
                <span>{it.label}</span>
                <span class="rb-dd__arrow" data-dd-arrow>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M12 6L8 10L4 6" stroke="currentColor" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </a>
              <div class="rb-dd__list" id={`rb-dd-${it.id}`} data-dd-list>
                <div class="rb-dd__card">
                  <div class:list={['rb-dd__layout', it.cols.length > 1 && 'rb-dd__layout--2']}>
                    {it.cols.map((col, ci) => (
                      <div class:list={['rb-dd__group', it.cols.length > 1 && ci === 0 && 'rb-dd__group--rule']}>
                        {col.map((list, li) => (
                          <>
                            {li > 0 && <div class="rb-dd__line" />}
                            <div class="rb-dd__links">
                              <div class="rb-dd__title">{list.title}</div>
                              {list.links.map((l) => (
                                <a href={l.href} class="rb-dd__link">
                                  <span>{l.label}</span>
                                  {l.ext && <svg class="rb-dd__ext" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 4H12M12 4V11M12 4L4 12" stroke="currentColor" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>}
                                </a>
                              ))}
                            </div>
                          </>
                        ))}
                      </div>
                    ))}
                  </div>
                  <div class:list={['rb-dd__decor', `rb-dd__decor--${it.decor}`]} data-dd-decor aria-hidden="true">
                    {it.decor === 'plane' && (
                      <svg viewBox="0 0 140 140" fill="none"><path d="M12 62 128 14 96 126 66 88 12 62Z" fill="#e0e3ff"/><path d="M128 14 66 88l-6 34-14-44 82-64Z" fill="#b7bcff"/><path d="M60 122 66 88l16 20-22 14Z" fill="#8b93ff"/><path d="M128 14 46 78 12 62 128 14Z" fill="#fff"/><rect x="18" y="104" width="8" height="8" fill="#57f287"/><rect x="112" y="118" width="6" height="6" fill="#eb459e"/></svg>
                    )}
                    {it.decor === 'shield' && (
                      <svg viewBox="0 0 200 200" fill="none"><path d="M100 18 168 44v52c0 44-28 74-68 88-40-14-68-44-68-88V44l68-26Z" fill="#57f287"/><path d="M100 18 168 44v52c0 44-28 74-68 88V18Z" fill="#35ed7e"/><path d="M100 46 144 62v34c0 28-18 48-44 58-26-10-44-30-44-58V62l44-16Z" fill="#1a2081"/><path d="m82 100 14 14 26-30" stroke="#fff" stroke-width="12" stroke-linecap="square"/><rect x="150" y="150" width="12" height="12" fill="#eb459e" transform="rotate(20 156 156)"/><rect x="30" y="26" width="8" height="8" fill="#fee75c"/></svg>
                    )}
                    {it.decor === 'rocket' && (
                      <svg viewBox="0 0 140 140" fill="none"><path d="M96 12c18 2 30 14 32 32L92 96 44 48 96 12Z" fill="#fff"/><path d="M128 44c-2-18-14-30-32-32l-10 7 35 35 7-10Z" fill="#eb459e"/><circle cx="88" cy="52" r="12" fill="#1a2081"/><circle cx="88" cy="52" r="6" fill="#57f287"/><path d="M44 48 20 56l18 18 6-26Zm48 48-8 24-18-18 26-6Z" fill="#b7bcff"/><path d="m40 82 18 18-34 24 16-42Z" fill="#fee75c"/><path d="m44 90 6 6-16 12 10-18Z" fill="#eb459e"/></svg>
                    )}
                    {it.decor === 'buoy' && (
                      <svg viewBox="0 0 150 150" fill="none"><circle cx="75" cy="75" r="60" fill="#fff"/><path d="M75 15a60 60 0 0 1 42.4 17.6L91 59a22.6 22.6 0 0 0-16-6.6V15Zm60 60a60 60 0 0 1-17.6 42.4L91 91a22.6 22.6 0 0 0 6.6-16H135ZM75 135a60 60 0 0 1-42.4-17.6L59 91a22.6 22.6 0 0 0 16 6.6V135ZM15 75a60 60 0 0 1 17.6-42.4L59 59a22.6 22.6 0 0 0-6.6 16H15Z" fill="#eb459e"/><circle cx="75" cy="75" r="24" fill="#5865f2"/><rect x="118" y="10" width="10" height="10" fill="#57f287"/></svg>
                    )}
                    {it.decor === 'pencil' && (
                      <svg viewBox="0 0 190 190" fill="none"><path d="m138 22 30 30-98 98-30-30 98-98Z" fill="#fee75c"/><path d="m153 37 15 15-98 98-15-15 98-98Z" fill="#f0b232"/><path d="m138 22 12-12c6-6 16-6 22 0l8 8c6 6 6 16 0 22l-12 12-30-30Z" fill="#eb459e"/><path d="m40 120 30 30-46 16 16-46Z" fill="#fff"/><path d="m30 150 10 10-16 6 6-16Z" fill="#1a2081"/><rect x="24" y="30" width="12" height="12" fill="#57f287"/><rect x="150" y="150" width="8" height="8" fill="#fff"/></svg>
                    )}
                    {it.decor === 'cube' && (
                      <svg viewBox="0 0 190 190" fill="none"><path d="M95 16 166 56v80l-71 40-71-40V56l71-40Z" fill="#b7bcff"/><path d="M95 96v80l-71-40V56l71 40Z" fill="#e0e3ff"/><path d="M95 16 166 56 95 96 24 56 95 16Z" fill="#fff"/><path d="m95 40 28 16-28 16-28-16 28-16Z" fill="#57f287"/><path d="M44 84 76 102v34L44 118V84Z" fill="#eb459e"/><path d="M114 110 146 92v14l-32 18v-14Zm0 28 32-18v14l-32 18v-14Z" fill="#1a2081"/><rect x="160" y="160" width="10" height="10" fill="#fee75c"/></svg>
                    )}
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </nav>

      <div class="rb-nav__cta">
        <Button variant="nav" href="#" class="rb-nav__btn">Contact</Button>
      </div>

      <button class="rb-burger-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="rb-burger" data-burger-open>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 6h14M5 12h14M5 18h7" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>

  <div class="rb-nav__blur" data-nav-blur aria-hidden="true"></div>

  <div class="rb-burger" id="rb-burger" data-burger role="dialog" aria-modal="true" aria-label="Menu">
    <div class="rb-burger__panel" data-burger-panel>
      <div class="rb-burger__top">
        <a href="/" class="rb-burger__brand" aria-label="Rebirth Web Design — home"><LogoMark size={32} /></a>
        <button class="rb-burger__close" type="button" aria-label="Close menu" data-burger-close>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
      </div>
      <ul class="rb-burger__list" role="list">
        {items.map((it) => it.kind === 'link' ? (
          <li class="rb-burger__item"><a href={it.href} class="rb-burger__link">{it.label}</a></li>
        ) : (
          <li class="rb-burger__item" data-acc>
            <button type="button" class="rb-burger__trigger" data-acc-trigger aria-expanded="false" aria-controls={`rb-acc-${it.id}`}>
              <span>{it.label}</span>
              <span class="rb-burger__arrow" data-acc-arrow>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M12 6L8 10L4 6" stroke="currentColor" stroke-opacity="0.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </button>
            <div class="rb-burger__sub" id={`rb-acc-${it.id}`} data-acc-list hidden>
              {it.cols.flat().map((list, gi) => (
                <div class="rb-burger__group">
                  {gi === 0 && <a href={it.href} class="rb-burger__grouptitle">{it.label}</a>}
                  <div class="rb-burger__sublinks">
                    <div class="rb-burger__subtitle">{list.title}</div>
                    {list.links.map((l) => <a href={l.href} class="rb-burger__sublink">{l.label}</a>)}
                  </div>
                </div>
              ))}
            </div>
          </li>
        ))}
      </ul>
      <div class="rb-burger__bottom">
        <div class="rb-burger__grad"></div>
        <a href="#" class="rb-burger__cta rb-burger__cta--ghost">Contact</a>
        <a href="/download" class="rb-burger__cta">Start your website</a>
      </div>
    </div>
  </div>
</header>

<style>
  /* ---------- bar ---------- */
  .rb-nav { position: absolute; inset: 0 0 auto 0; z-index: 99; font-family: var(--font-abc-ginto-discord); }
  .rb-nav__pad { position: relative; z-index: 2; padding: 0 var(--page-gutter); }
  .rb-nav__wrap { display: flex; justify-content: space-between; align-items: flex-end; height: 80px; margin: 0 auto; }

  .rb-skip {
    position: absolute; top: 12px; left: 12px; z-index: 100;
    padding: 13px var(--spacing-24); border-radius: var(--radius-md);
    background: var(--color-signal-green); color: var(--color-black);
    font-size: 16px; line-height: 22px; font-weight: var(--font-weight-medium); text-decoration: none;
    opacity: 0; pointer-events: none; transform: translateY(-20px);
    transition: transform 0.25s, opacity 0.25s;
  }
  .rb-skip:focus-visible { opacity: 1; pointer-events: auto; transform: translate(0); outline: none; }

  /* ---------- brand lockup (146 x 40, fixed) ---------- */
  .rb-brand {
    position: fixed; left: var(--page-gutter); top: 40px; z-index: 3;
    display: block; width: 146px; height: 40px; color: var(--color-white); text-decoration: none;
  }
  .rb-brand:focus-visible { outline: 2px solid var(--color-blurple); outline-offset: 2px; border-radius: var(--radius-lg); }
  .rb-brand__light, .rb-brand__pill { position: absolute; display: flex; align-items: center; }
  .rb-brand__light { inset: 0; gap: var(--spacing-10); }
  .rb-brand__pill {
    inset: 1px 0; justify-content: center; gap: var(--spacing-8);
    border-radius: var(--radius-nav-controls); background: var(--surface-white-control); color: var(--color-black);
    opacity: 0;
  }
  .rb-brand__word {
    font-family: var(--font-abc-ginto-discord-nord); font-weight: var(--font-weight-extrabold);
    font-size: 19.5px; line-height: 1; letter-spacing: -0.01em; text-transform: uppercase; white-space: nowrap;
  }
  .rb-brand__word--sm { font-size: 15px; }

  /* ---------- link row ---------- */
  .rb-menu { margin: 0 auto; }
  .rb-menu__list { display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; margin: 0; padding: 0; list-style: none; }
  .rb-menu__list > li { position: relative; }
  .rb-link, .rb-dd__trigger {
    display: flex; align-items: center; justify-content: center; min-height: 38px; box-sizing: border-box;
    padding: var(--spacing-10) var(--spacing-16);
    border-radius: var(--radius-md); color: var(--color-white); text-decoration: none; white-space: nowrap;
    font-size: var(--text-nav); line-height: var(--leading-nav); font-weight: var(--font-weight-medium);
    transition: background-color 0.4s;
  }
  .rb-link { gap: var(--spacing-8); }
  .rb-dd__trigger { gap: var(--spacing-4); position: relative; cursor: pointer; }
  .rb-link:hover, .rb-dd.is-open > .rb-dd__trigger { background-color: var(--color-blurple); }
  .rb-link:focus-visible, .rb-dd__trigger:focus-visible { outline: 2px solid var(--color-white); outline-offset: -2px; }
  .rb-dd__arrow { display: flex; width: 16px; height: 16px; }

  /* ---------- dropdown panel ---------- */
  .rb-dd__list {
    position: absolute; top: 36px; left: 50%; width: 522px; margin-left: -261px; z-index: 900;
    display: flex; justify-content: center; align-items: flex-start;
    opacity: 0; visibility: hidden; pointer-events: none;
  }
  .rb-dd.is-open > .rb-dd__list { pointer-events: auto; }
  .rb-dd__card { position: relative; margin-top: 7px; padding: var(--spacing-40); border-radius: 40px; background: var(--color-blurple); }
  .rb-dd__layout { position: relative; z-index: 2; display: grid; grid-template-columns: auto; gap: 30px; max-width: 982px; }
  .rb-dd__layout--2 { grid-template-columns: auto 1fr; gap: var(--spacing-40); }
  .rb-dd__group { position: relative; }
  .rb-dd__group--rule { min-width: 168px; padding-right: 21px; }
  .rb-dd__group--rule::after { content: ''; position: absolute; top: 0; right: 0; bottom: 0; width: 1px; background: var(--color-white-10); }
  .rb-dd__layout--2 .rb-dd__group:last-child { padding-right: var(--spacing-20); }
  .rb-dd__links { display: flex; flex-direction: column; gap: var(--spacing-12); }
  .rb-dd__title { margin-bottom: var(--spacing-4); color: var(--color-white); opacity: 0.5; font-size: 16px; line-height: 1.3; font-weight: var(--font-weight-regular); white-space: nowrap; }
  .rb-dd__link {
    display: flex; align-items: center; gap: var(--spacing-4); color: var(--color-white); text-decoration: none; white-space: nowrap;
    font-size: 16px; line-height: 1.2; font-weight: var(--font-weight-medium); transition: opacity 0.35s;
  }
  .rb-dd__link:hover { opacity: 0.65; }
  .rb-dd__link:focus-visible { outline: 2px solid var(--color-white); outline-offset: 2px; }
  .rb-dd__ext { transition: transform 0.3s; }
  .rb-dd__link:hover .rb-dd__ext { transform: translate(2px, -2px); }
  .rb-dd__line { height: 1px; margin: var(--spacing-24) 0; background: var(--color-white); opacity: 0.1; }
  .rb-dd__decor { position: absolute; right: 0; bottom: 0; width: 140px; margin: 0 -72px -98px 0; pointer-events: none; opacity: 0; }
  .rb-dd__decor svg { display: block; width: 100%; height: auto; }
  .rb-dd__decor--plane { margin: 0 -54px -46px 0; }
  .rb-dd__decor--shield { width: 200px; margin: 0 -92px -122px 0; }
  .rb-dd__decor--buoy { width: 150px; margin: 0 -94px -80px 0; }
  .rb-dd__decor--pencil { width: 190px; margin: 0 -80px -100px 0; }
  .rb-dd__decor--cube { width: 190px; margin: 0 -100px -120px 0; }

  .rb-nav__blur {
    position: fixed; inset: 0; z-index: 1; height: 100vh;
    background: rgba(0, 0, 0, 0.8); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
    opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.4s, visibility 0.4s;
  }
  .rb-nav:has(.rb-dd.is-open) .rb-nav__blur { opacity: 1; visibility: visible; }

  /* ---------- right-hand button (fixed) ---------- */
  .rb-nav__cta { position: fixed; right: var(--page-gutter); top: 41px; z-index: 3; }
  .rb-nav__cta :global(.rb-btn) { transition: background-color 0.25s; }

  /* ---------- burger ---------- */
  .rb-burger-btn, .rb-burger__close {
    display: none; flex: none; align-items: center; justify-content: center; width: 40px; height: 40px; padding: 0; border: 0;
    border-radius: 14px; background: var(--color-white-10); color: var(--color-white); cursor: pointer; transition: background-color 0.5s;
  }
  .rb-burger-btn:hover, .rb-burger__close:hover { background: rgba(255, 255, 255, 0.3); }
  .rb-burger__close { display: flex; background: rgba(255, 255, 255, 0.3); transition-duration: 0.4s; }
  .rb-burger-btn:focus-visible, .rb-burger__close:focus-visible, .rb-burger__trigger:focus-visible, .rb-burger__link:focus-visible { outline: 2px solid var(--color-white); outline-offset: 2px; }
  .rb-burger {
    display: none; position: fixed; inset: 0; z-index: 100; height: 100dvh; opacity: 0;
    background: rgba(0, 0, 0, 0.8); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
  }
  .rb-burger__panel {
    position: relative; display: flex; flex-direction: column; box-sizing: border-box; width: 50%; height: 100%; margin-left: auto; padding: 32px;
    border-radius: 40px 0 0 40px; background: var(--color-blurple); color: var(--color-white);
  }
  .rb-burger__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-48); }
  .rb-burger__brand { display: flex; align-items: center; height: 40px; color: var(--color-white); }
  .rb-burger__list { flex: 1; min-height: 0; margin: 0 0 var(--spacing-128); padding: 0; list-style: none; overflow-y: auto; scrollbar-width: none; }
  .rb-burger__list::-webkit-scrollbar { width: 0; }
  .rb-burger__item { background: linear-gradient(rgba(255, 255, 255, 0.063), rgba(255, 255, 255, 0.063)) bottom / 100% 1px no-repeat; padding-bottom: 1px; }
  .rb-burger__link, .rb-burger__trigger {
    display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 100%; padding: var(--spacing-24) 0; border: 0; background: none;
    color: var(--color-white); text-decoration: none; text-align: left; cursor: pointer;
    font-family: inherit; font-size: 16px; line-height: 1; font-weight: var(--font-weight-medium);
  }
  .rb-burger__trigger { padding-right: var(--spacing-16); line-height: 1.2; }
  .rb-burger__arrow { display: flex; width: 16px; height: 16px; }
  .rb-burger__sub { padding-top: var(--spacing-8); }
  .rb-burger__group { padding-bottom: var(--spacing-40); }
  .rb-burger__group + .rb-burger__group { padding-top: var(--spacing-40); background: linear-gradient(var(--color-white-10), var(--color-white-10)) top / 100% 1px no-repeat; }
  .rb-burger__grouptitle { display: inline-block; margin-bottom: var(--spacing-24); color: var(--color-white); text-decoration: none; font-size: 18px; line-height: 1.3; font-weight: var(--font-weight-medium); }
  .rb-burger__sublinks { display: flex; flex-direction: column; gap: var(--spacing-12); }
  .rb-burger__subtitle { margin-bottom: var(--spacing-4); opacity: 0.5; font-size: 18px; line-height: 1.3; font-weight: var(--font-weight-medium); }
  .rb-burger__sublink { color: var(--color-white); text-decoration: none; font-size: 18px; line-height: 1.2; font-weight: var(--font-weight-medium); }
  .rb-burger__bottom { position: absolute; inset: auto 0 0 0; z-index: 3; display: flex; flex-direction: column; gap: var(--spacing-12); padding: 0 32px 32px; }
  .rb-burger__grad { position: absolute; inset: -48px 0 auto 0; height: 32px; pointer-events: none; background: linear-gradient(180deg, rgba(88, 101, 242, 0) 43%, var(--color-blurple) 77%); }
  .rb-burger__cta {
    display: flex; justify-content: center; align-items: center; padding: var(--spacing-12) var(--spacing-16); border-radius: var(--radius-nav-controls);
    background: var(--surface-white-control); color: var(--color-black); text-decoration: none;
    font-size: 14px; line-height: 1.3; font-weight: var(--font-weight-medium); letter-spacing: var(--tracking-button); transition: background-color 0.4s;
  }
  .rb-burger__cta:hover { background: var(--color-fog); }
  /* 2px ring measured on the reference's tablet "ghost" menu button */
  .rb-burger__cta--ghost { background: transparent; color: var(--color-white); border: 2px solid var(--color-white-10); }
  .rb-burger__cta--ghost:hover { background: transparent; }

  /* ---------- 1280–1439: tighter link padding (reference .nav_link 0.75rem) ---------- */
  @media (max-width: 1439px) {
    .rb-link { padding-left: var(--spacing-12); padding-right: var(--spacing-12); }
  }
  /* ---------- 992–1279: compact desktop row (70px bar, 14px links) ---------- */
  @media (max-width: 1279px) {
    .rb-nav__pad { padding: 0 32px; }
    .rb-nav__wrap { height: 70px; }
    .rb-brand { top: 30px; }
    .rb-nav__cta { top: 31px; right: 32px; }
    .rb-nav__cta :global(.rb-btn) { padding-top: 9px; padding-bottom: 9px; line-height: 1.3; letter-spacing: 0; transition-duration: 0.2s; }
    .rb-menu__list { max-width: 660px; }
    .rb-link, .rb-dd__trigger { padding: var(--spacing-10) 7.2px; font-size: 14px; line-height: 16px; letter-spacing: -0.01em; }
    .rb-dd__trigger { padding-right: var(--spacing-4); line-height: 19.2px; max-height: 38px; }
    .rb-dd__arrow, .rb-dd__arrow svg { width: 12px; height: 12px; }
    .rb-dd__list { width: 480px; margin-left: -240px; top: 37px; }
    .rb-dd__card { padding: 32px; }
    .rb-dd__link, .rb-dd__title { font-size: 14px; }
  }
  /* ---------- <= 991: fixed bar + burger ---------- */
  @media (max-width: 991px) {
    .rb-nav { position: fixed; z-index: 101; }
    .rb-nav__wrap { height: 100px; align-items: center; }
    .rb-menu { display: none; }
    .rb-brand { position: relative; left: auto; top: auto; flex: none; }
    .rb-brand__pill { display: none; }
    .rb-nav__cta { position: relative; right: auto; top: auto; margin: 0 var(--spacing-24) 0 auto; }
    .rb-burger-btn { display: flex; }
    .rb-nav__blur { display: none; }
  }
  @media (max-width: 767px) {
    .rb-nav__cta { display: none; }
    .rb-burger-btn { margin-left: auto; }
    .rb-burger__panel { width: 100%; border-radius: 0; }
    .rb-burger__cta--ghost { display: none; }
  }
  @media (max-width: 479px) {
    .rb-nav__pad { padding: 0 var(--spacing-24); }
    .rb-nav__wrap { height: 64px; }
    .rb-burger__panel { padding: var(--spacing-24); }
    .rb-burger__top { margin-bottom: 39px; }
    .rb-burger__list { margin-bottom: 117px; }
    .rb-burger__link, .rb-burger__trigger { font-size: 18px; line-height: 31.2px; }
    .rb-burger__bottom { padding: 0 35px var(--spacing-24); }
    .rb-burger__cta { font-size: 15.6px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { CustomEase } from 'gsap/CustomEase';
  gsap.registerPlugin(ScrollTrigger, CustomEase);

  const root = document.querySelector<HTMLElement>('[data-section="global-header"]');
  if (root) {
    // Easings named as in the reference IX2 data.
    const ease = CustomEase.create('rb-ease', '0.25,0.1,0.25,1'); // "ease"
    const inQuad = 'power1.in';
    const swingTo = 'back.out(1.70158)';
    const inSine = 'sine.in';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const T = (s: number) => (reduce ? 0 : s);
    const desktop = window.matchMedia('(min-width: 992px)');

    /* ---- skip link: focus <main> like the reference script ---- */
    const main = document.querySelector<HTMLElement>('main');
    if (main && !main.id) main.id = 'main';
    root.querySelector('[data-skip]')?.addEventListener('click', (e) => {
      if (!main) return;
      e.preventDefault();
      main.setAttribute('tabindex', '-1');
      main.focus();
      main.addEventListener('blur', () => main.removeAttribute('tabindex'), { once: true });
    });

    /* ---- dropdowns (IX2 "Nav-dd-open" / "Nav-dd close") ---- */
    const dds = [...root.querySelectorAll<HTMLElement>('[data-dd]')];
    const setDd = (dd: HTMLElement, open: boolean) => {
      if (dd.classList.contains('is-open') === open) return;
      dd.classList.toggle('is-open', open);
      const list = dd.querySelector('[data-dd-list]');
      const arrow = dd.querySelector('[data-dd-arrow]');
      const decor = dd.querySelector('[data-dd-decor]');
      dd.querySelector('[data-dd-trigger]')?.setAttribute('aria-expanded', String(open));
      gsap.killTweensOf([list, arrow, decor]);
      if (open) {
        gsap.to(list, { autoAlpha: 1, duration: T(0.25), ease });
        gsap.to(arrow, { rotation: 180, duration: T(0.25), ease });
        gsap.fromTo(decor, { autoAlpha: 0 }, { autoAlpha: 1, duration: T(0.3), ease: inQuad });
        gsap.fromTo(decor, { y: 50 }, { y: 0, duration: T(0.6), delay: T(0.1), ease: swingTo });
      } else {
        gsap.to(list, { autoAlpha: 0, duration: T(0.25), ease });
        gsap.to(arrow, { rotation: 0, duration: T(0.25), ease });
        gsap.to(decor, { autoAlpha: 0, y: 50, duration: T(0.25), ease: 'none' });
      }
    };
    const closeAll = (except?: HTMLElement) => dds.forEach((d) => d !== except && setDd(d, false));
    dds.forEach((dd) => {
      const trigger = dd.querySelector<HTMLAnchorElement>('[data-dd-trigger]')!;
      dd.addEventListener('mouseenter', () => { closeAll(dd); setDd(dd, true); });
      dd.addEventListener('mouseleave', () => setDd(dd, false));
      dd.addEventListener('focusin', () => { closeAll(dd); setDd(dd, true); });
      dd.addEventListener('focusout', (e) => { if (!dd.contains(e.relatedTarget as Node)) setDd(dd, false); });
      trigger.addEventListener('click', (e) => {
        if (trigger.getAttribute('href') !== '#') return; // real route: navigate, like the reference overlay link
        e.preventDefault();
        const hoverable = window.matchMedia('(hover: hover)').matches;
        if (!hoverable) { const open = !dd.classList.contains('is-open'); closeAll(dd); setDd(dd, open); }
      });
      trigger.addEventListener('keydown', (e) => {
        if (e.key === ' ' || e.key === 'ArrowDown') { e.preventDefault(); setDd(dd, true); dd.querySelector<HTMLElement>('.rb-dd__link')?.focus(); }
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = dds.find((d) => d.classList.contains('is-open'));
      if (open) { open.querySelector<HTMLElement>('[data-dd-trigger]')?.focus(); setDd(open, false); (document.activeElement as HTMLElement)?.blur(); }
      if (burgerOpen) toggleBurger(false);
    });
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) closeAll(); });

    /* ---- scrolled state ----
       >= 992: IX2 "scroll-logo-bg": the white lockup swaps to the white pill once the page's
       `.menu-animation.is_brand` trigger (the hero box) has scrolled out; links scroll away
       with the absolutely-positioned bar, logo + button stay fixed.
       <= 991: IX2 "Navbar BG color changes when scrolling": fixed bar turns blurple after 0.1% scroll. */
    const light = root.querySelector('[data-brand-light]');
    const pill = root.querySelector('[data-brand-pill]');
    const threshold = () => {
      const t = document.querySelector<HTMLElement>('[data-nav-trigger]') || (main?.firstElementChild as HTMLElement | null);
      if (!t) return 870;
      const r = t.getBoundingClientRect();
      const y = r.bottom + window.scrollY;
      return y > 200 ? y : 870;
    };
    let scrolled: boolean | null = null;
    let tinted: boolean | null = null;
    const onScroll = () => {
      const y = window.scrollY;
      if (desktop.matches) {
        if (tinted) { tinted = false; gsap.set(root, { backgroundColor: 'rgba(88,101,242,0)' }); }
        const s = y >= threshold();
        if (s !== scrolled) {
          const first = scrolled === null;
          scrolled = s;
          root.classList.toggle('is-scrolled', s);
          gsap.to(light, { opacity: s ? 0 : 1, duration: first ? 0 : T(0.2), ease: 'none', overwrite: true });
          gsap.to(pill, { opacity: s ? 1 : 0, duration: first ? 0 : T(0.2), ease: 'none', overwrite: true });
        }
      } else {
        if (scrolled) { scrolled = null; root.classList.remove('is-scrolled'); gsap.set(light, { opacity: 1 }); gsap.set(pill, { opacity: 0 }); }
        const t = y > 0;
        if (t !== tinted) {
          const first = tinted === null;
          tinted = t;
          gsap.to(root, { backgroundColor: t ? 'rgba(88,101,242,1)' : 'rgba(88,101,242,0)', duration: first ? 0 : T(0.2), ease: 'none', overwrite: true });
        }
      }
    };
    ScrollTrigger.create({ start: 0, end: 'max', onUpdate: onScroll, onRefresh: onScroll });
    window.addEventListener('scroll', onScroll, { passive: true });
    desktop.addEventListener('change', () => { scrolled = null; tinted = null; closeAll(); if (burgerOpen) toggleBurger(false, true); onScroll(); });
    onScroll();

    /* ---- burger menu (IX2 "Nav Menu [open]" / "[close]" + MOBILE variants) ---- */
    const burger = root.querySelector<HTMLElement>('[data-burger]')!;
    const panel = root.querySelector<HTMLElement>('[data-burger-panel]')!;
    const openBtn = root.querySelector<HTMLElement>('[data-burger-open]')!;
    const closeBtn = root.querySelector<HTMLElement>('[data-burger-close]')!;
    let burgerOpen = false;
    function toggleBurger(open: boolean, instant = false) {
      burgerOpen = open;
      const phone = window.matchMedia('(max-width: 767px)').matches;
      const d = (s: number) => (instant ? 0 : T(s));
      openBtn.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      gsap.killTweensOf([burger, panel]);
      if (open) {
        gsap.set(burger, { display: 'block' });
        gsap.fromTo(burger, { opacity: 0 }, { opacity: 1, duration: d(0.2), ease: inSine });
        gsap.fromTo(panel, { xPercent: 100 }, { xPercent: 0, duration: d(0.35), ease });
        if (phone) gsap.fromTo(panel, { opacity: 0 }, { opacity: 1, duration: d(0.35), delay: d(0.1), ease: 'none' });
        else gsap.set(panel, { opacity: 1 });
        closeBtn.focus({ preventScroll: true });
      } else {
        gsap.to(panel, { xPercent: 100, duration: d(0.25), ease });
        if (phone) gsap.to(panel, { opacity: 0, duration: d(0.25), ease });
        gsap.to(burger, { opacity: 0, duration: d(phone ? 0.25 : 0.35), delay: d(phone ? 0.2 : 0), ease: 'none', onComplete: () => gsap.set(burger, { display: 'none' }) });
        if (!instant) openBtn.focus({ preventScroll: true });
      }
    }
    openBtn.addEventListener('click', () => toggleBurger(true));
    closeBtn.addEventListener('click', () => toggleBurger(false));
    burger.addEventListener('click', (e) => { if (e.target === burger) toggleBurger(false); });
    burger.querySelectorAll('a[href]').forEach((a) => a.addEventListener('click', () => toggleBurger(false, true)));

    // accordions inside the burger: instant list toggle (Webflow dropdown) + 200ms arrow turn
    burger.querySelectorAll<HTMLElement>('[data-acc]').forEach((acc) => {
      const trig = acc.querySelector<HTMLElement>('[data-acc-trigger]')!;
      const list = acc.querySelector<HTMLElement>('[data-acc-list]')!;
      const arrow = acc.querySelector('[data-acc-arrow]');
      trig.addEventListener('click', () => {
        const open = list.hidden;
        burger.querySelectorAll<HTMLElement>('[data-acc]').forEach((o) => {
          if (o === acc) return;
          o.querySelector<HTMLElement>('[data-acc-list]')!.hidden = true;
          o.querySelector('[data-acc-trigger]')!.setAttribute('aria-expanded', 'false');
          gsap.to(o.querySelector('[data-acc-arrow]'), { rotation: 0, duration: T(0.2), ease: 'none' });
        });
        list.hidden = !open;
        trig.setAttribute('aria-expanded', String(open));
        gsap.to(arrow, { rotation: open ? 180 : 0, duration: T(0.2), ease: 'none' });
      });
    });
  }
</script>
