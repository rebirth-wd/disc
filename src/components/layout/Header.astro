    font-weight: var(--font-weight-medium);
  }
  .header__burger-bottom {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
    padding: 0 32px 32px;
  }
  .header__burger-grad {
    position: absolute;
    inset: -48px 0 auto 0;
    height: 32px;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(88, 101, 242, 0) 43%, var(--color-blurple) 77%);
  }
  .header__burger-cta {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--spacing-12) var(--spacing-16);
    border-radius: var(--radius-nav-controls);
    background: var(--surface-white-control);
    color: var(--color-black);
    text-decoration: none;
    font-size: 14px;
    line-height: 1.3;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-button);
    transition: background-color 0.4s;
  }
  .header__burger-cta:hover {
    background: var(--color-fog);
  }
  /* 2px ring tablet "ghost" menu button */
  .header__burger-cta--ghost {
    background: transparent;
    color: var(--color-white);
    border: 2px solid var(--color-white-10);
  }
  .header__burger-cta--ghost:hover {
    background: transparent;
  }

  /* ---------- 1280–1439: tighter link padding (0.75rem) ---------- */
  @media (max-width: 1439px) {
    .header__link {
      padding-left: var(--spacing-12);
      padding-right: var(--spacing-12);
    }
  }
  /* ---------- 992–1279: compact desktop row (70px bar, 14px links) ---------- */
  @media (max-width: 1279px) {
    .header__pad {
      padding: 0 32px;
    }
    .header__wrap {
      height: 70px;
    }
    .header__brand {
      top: 30px;
    }
    .header__cta {
      top: 31px;
      right: 32px;
    }
    .header__cta :global(.button) {
      padding-top: 9px;
      padding-bottom: 9px;
      line-height: 1.3;
      letter-spacing: 0;
      transition-duration: 0.2s;
    }
    .header__menu-list {
      max-width: 660px;
    }
    .header__link,
    .header__dd-trigger {
      padding: var(--spacing-10) 7.2px;
      font-size: 14px;
      line-height: 16px;
      letter-spacing: -0.01em;
    }
    .header__dd-trigger {
      padding-right: var(--spacing-4);
      line-height: 19.2px;
      max-height: 38px;
    }
    .header__dd-arrow,
    .header__dd-arrow svg {
      width: 12px;
      height: 12px;
    }
    .header__dd-list {
      width: 480px;
      margin-left: -240px;
      top: 37px;
    }
    .header__dd-card {
      padding: 32px;
    }
    .header__dd-link,
    .header__dd-title {
      font-size: 14px;
    }
  }
  /* ---------- <= 991: fixed bar + burger ---------- */
  @media (max-width: 991px) {
    .header {
      position: fixed;
      z-index: 101;
    }
    .header__wrap {
      height: 100px;
      align-items: center;
    }
    .header__menu {
      display: none;
    }
    .header__brand {
      position: relative;
      left: auto;
      top: auto;
      flex: none;
    }
    .header__brand-pill {
      display: none;
    }
    .header__cta {
      position: relative;
      right: auto;
      top: auto;
      margin: 0 var(--spacing-24) 0 auto;
    }
    .header__burger-btn {
      display: flex;
    }
    .header__blur {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .header__cta {
      display: none;
    }
    .header__burger-btn {
      margin-left: auto;
    }
    .header__burger-panel {
      width: 100%;
      border-radius: 0;
    }
    .header__burger-cta--ghost {
      display: none;
    }
  }
  @media (max-width: 479px) {
    .header__pad {
      padding: 0 var(--spacing-24);
    }
    .header__wrap {
      height: 64px;
    }
    .header__burger-panel {
      padding: var(--spacing-24);
    }
    .header__burger-top {
      margin-bottom: 39px;
    }
    .header__burger-list {
      margin-bottom: 117px;
    }
    .header__burger-link,
    .header__burger-trigger {
      font-size: 18px;
      line-height: 31.2px;
    }
    .header__burger-bottom {
      padding: 0 35px var(--spacing-24);
    }
    .header__burger-cta {
      font-size: 15.6px;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, ease, media, onPage, reducedMotion, MQ } from '@lib/motion';

  onPage(() => {
    const root = document.querySelector<HTMLElement>('[data-section="global-header"]');
    if (root) {
      const inQuad = 'power1.in';
      const swingTo = 'back.out(1.70158)';
      const inSine = 'sine.in';
      const reduce = reducedMotion();
      const T = (s: number) => (reduce ? 0 : s);
      const desktop = window.matchMedia(MQ.lg);

      /* ---- skip link: focus <main> ---- */
      const main = document.querySelector<HTMLElement>('main');
      if (main && !main.id) main.id = 'main';
      root.querySelector('[data-skip]')?.addEventListener('click', (e) => {
        if (!main) return;
        e.preventDefault();
        main.setAttribute('tabindex', '-1');
        main.focus();
        main.addEventListener('blur', () => main.removeAttribute('tabindex'), { once: true });
      });

      /* ---- dropdowns ---- */
      const dds = [...root.querySelectorAll<HTMLElement>('[data-dd]')];
      const setDd = (dd: HTMLElement, open: boolean) => {
        if (dd.classList.contains('is-open') === open) return;
        dd.classList.toggle('is-open', open);
        const list = dd.querySelector('[data-dd-list]');
        const arrow = dd.querySelector('[data-dd-arrow]');
        const decor = dd.querySelector('[data-dd-decor]');
        dd.querySelector('[data-dd-trigger]')?.setAttribute('aria-expanded', String(open));
        gsap.killTweensOf([list, arrow, decor]);
        if (open) {
          gsap.to(list, { autoAlpha: 1, duration: T(0.25), ease: ease.css });
          gsap.to(arrow, { rotation: 180, duration: T(0.25), ease: ease.css });
          gsap.fromTo(decor, { autoAlpha: 0 }, { autoAlpha: 1, duration: T(0.3), ease: inQuad });
          gsap.fromTo(decor, { y: 50 }, { y: 0, duration: T(0.6), delay: T(0.1), ease: swingTo });
        } else {
          gsap.to(list, { autoAlpha: 0, duration: T(0.25), ease: ease.css });
          gsap.to(arrow, { rotation: 0, duration: T(0.25), ease: ease.css });
          gsap.to(decor, { autoAlpha: 0, y: 50, duration: T(0.25), ease: 'none' });
        }
      };
      const closeAll = (except?: HTMLElement) =>
        dds.forEach((d) => d !== except && setDd(d, false));
      dds.forEach((dd) => {
        const trigger = dd.querySelector<HTMLAnchorElement>('[data-dd-trigger]')!;
        dd.addEventListener('mouseenter', () => {
          closeAll(dd);
          setDd(dd, true);
        });
        dd.addEventListener('mouseleave', () => setDd(dd, false));
        dd.addEventListener('focusin', () => {
          closeAll(dd);
          setDd(dd, true);
        });
        dd.addEventListener('focusout', (e) => {
          if (!dd.contains(e.relatedTarget as Node)) setDd(dd, false);
        });
        trigger.addEventListener('click', (e) => {
          if (trigger.getAttribute('href') !== '#') return; // real route: navigate
          e.preventDefault();
          const hoverable = window.matchMedia('(hover: hover)').matches;
          if (!hoverable) {
            const open = !dd.classList.contains('is-open');
            closeAll(dd);
            setDd(dd, open);
          }
        });
        trigger.addEventListener('keydown', (e) => {
          if (e.key === ' ' || e.key === 'ArrowDown') {
            e.preventDefault();
            setDd(dd, true);
            dd.querySelector<HTMLElement>('.header__dd-link')?.focus();
          }
        });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const open = dds.find((d) => d.classList.contains('is-open'));
        if (open) {
          open.querySelector<HTMLElement>('[data-dd-trigger]')?.focus();
          setDd(open, false);
          (document.activeElement as HTMLElement)?.blur();
        }
        if (burgerOpen) toggleBurger(false);
      });
      document.addEventListener('click', (e) => {
        if (!root.contains(e.target as Node)) closeAll();
      });

      /* ---- scrolled state ----
       >= 992: the white lockup swaps to the white pill once the page's
       `.menu-animation.is_brand` trigger (the hero box) has scrolled out; links scroll away
       with the absolutely-positioned bar, logo + button stay fixed.
       <= 991: fixed bar turns blurple after 0.1% scroll. */
      const light = root.querySelector('[data-brand-light]');
      const pill = root.querySelector('[data-brand-pill]');
      const threshold = () => {
        const t =
          document.querySelector<HTMLElement>('[data-nav-trigger]') ||
          (main?.firstElementChild as HTMLElement | null);
        if (!t) return 870;
        const r = t.getBoundingClientRect();
        const y = r.bottom + window.scrollY;
        return y > 200 ? y : 870;
      };
      let scrolled: boolean | null = null;
      let tinted: boolean | null = null;
      const onScroll = () => {
        const y = window.scrollY;
        if (desktop.matches) {
          if (tinted) {
            tinted = false;
            gsap.set(root, { backgroundColor: 'rgba(88,101,242,0)' });
          }
          const s = y >= threshold();
          if (s !== scrolled) {
            const first = scrolled === null;
            scrolled = s;
            root.classList.toggle('is-scrolled', s);
            gsap.to(light, {
              opacity: s ? 0 : 1,
              duration: first ? 0 : T(0.2),
              ease: 'none',
              overwrite: true,
            });
            gsap.to(pill, {
              opacity: s ? 1 : 0,
              duration: first ? 0 : T(0.2),
              ease: 'none',
              overwrite: true,
            });
          }
        } else {
          if (scrolled) {
            scrolled = null;
            root.classList.remove('is-scrolled');
            gsap.set(light, { opacity: 1 });
            gsap.set(pill, { opacity: 0 });
          }
          const t = y > 0;
          if (t !== tinted) {
            const first = tinted === null;
            tinted = t;
            gsap.to(root, {
              backgroundColor: t ? 'rgba(88,101,242,1)' : 'rgba(88,101,242,0)',
              duration: first ? 0 : T(0.2),
              ease: 'none',
              overwrite: true,
            });
          }
        }
      };
      media(
        root,
        () => {
          ScrollTrigger.create({ start: 0, end: 'max', onUpdate: onScroll, onRefresh: onScroll });
        },
        MQ.always,
      );
      window.addEventListener('scroll', onScroll, { passive: true });
      desktop.addEventListener('change', () => {
        scrolled = null;
        tinted = null;
        closeAll();
        if (burgerOpen) toggleBurger(false, true);
        onScroll();
      });
      onScroll();

      /* ---- burger menu ---- */
      const burger = root.querySelector<HTMLElement>('[data-burger]')!;
      const panel = root.querySelector<HTMLElement>('[data-burger-panel]')!;
      const openBtn = root.querySelector<HTMLElement>('[data-burger-open]')!;
      const closeBtn = root.querySelector<HTMLElement>('[data-burger-close]')!;
      let burgerOpen = false;
      function toggleBurger(open: boolean, instant = false) {
        burgerOpen = open;
        const phone = window.matchMedia(MQ.sm).matches;
        const d = (s: number) => (instant ? 0 : T(s));
        openBtn.setAttribute('aria-expanded', String(open));
        document.documentElement.style.overflow = open ? 'hidden' : '';
        gsap.killTweensOf([burger, panel]);
        if (open) {
          gsap.set(burger, { display: 'block' });
          gsap.fromTo(burger, { opacity: 0 }, { opacity: 1, duration: d(0.2), ease: inSine });
          gsap.fromTo(panel, { xPercent: 100 }, { xPercent: 0, duration: d(0.35), ease: ease.css });
          if (phone)
            gsap.fromTo(
              panel,
              { opacity: 0 },
              { opacity: 1, duration: d(0.35), delay: d(0.1), ease: 'none' },
            );
          else gsap.set(panel, { opacity: 1 });
          closeBtn.focus({ preventScroll: true });
        } else {
          gsap.to(panel, { xPercent: 100, duration: d(0.25), ease: ease.css });
          if (phone) gsap.to(panel, { opacity: 0, duration: d(0.25), ease: ease.css });
          gsap.to(burger, {
            opacity: 0,
            duration: d(phone ? 0.25 : 0.35),
            delay: d(phone ? 0.2 : 0),
            ease: 'none',
            onComplete: () => gsap.set(burger, { display: 'none' }),
          });
          if (!instant) openBtn.focus({ preventScroll: true });
        }
      }
      openBtn.addEventListener('click', () => toggleBurger(true));
      closeBtn.addEventListener('click', () => toggleBurger(false));
      burger.addEventListener('click', (e) => {
        if (e.target === burger) toggleBurger(false);
      });
      burger
        .querySelectorAll('a[href]')
        .forEach((a) => a.addEventListener('click', () => toggleBurger(false, true)));

      // accordions inside the burger: instant list toggle + 200ms arrow turn
      burger.querySelectorAll<HTMLElement>('[data-acc]').forEach((acc) => {
        const trig = acc.querySelector<HTMLElement>('[data-acc-trigger]')!;
        const list = acc.querySelector<HTMLElement>('[data-acc-list]')!;
        const arrow = acc.querySelector('[data-acc-arrow]');
        trig.addEventListener('click', () => {
          const open = list.hidden;
          burger.querySelectorAll<HTMLElement>('[data-acc]').forEach((o) => {
            if (o === acc) return;
            o.querySelector<HTMLElement>('[data-acc-list]')!.hidden = true;
            o.querySelector('[data-acc-trigger]')!.setAttribute('aria-expanded', 'false');
            gsap.to(o.querySelector('[data-acc-arrow]'), {
              rotation: 0,
              duration: T(0.2),
              ease: 'none',
            });
          });
          list.hidden = !open;
          trig.setAttribute('aria-expanded', String(open));
          gsap.to(arrow, { rotation: open ? 180 : 0, duration: T(0.2), ease: 'none' });
        });
      });
    }
  });
</script>
