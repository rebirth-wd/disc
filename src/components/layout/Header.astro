---
// Global header: 80px transparent bar, fixed logo lockup left, centred link row with dropdown panels,
// fixed white nav button right, scrolled pill state, burger menu under 992px.
import Button from '@components/ui/Button.astro';
import LogoMark from './LogoMark.astro';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

type Link = { label: string; href: string; ext?: boolean };
type List = { title: string; links: Link[] };
type Item =
  | { kind: 'link'; id: string; label: string; href: string }
  | { kind: 'dd'; id: string; label: string; href: string; decor: string; cols: List[][] };

const L = (label: string, href = '#', ext = false): Link => ({ label, href, ext });

// 2 links, 6 dropdowns, 1 link. The built routes are real, the rest are "#".
const items: Item[] = [
  { kind: 'link', id: 'services', label: 'Services', href: '/services' },
  { kind: 'link', id: 'plans', label: 'Plans', href: '/plans' },
  {
    kind: 'dd',
    id: 'showcase',
    label: 'Showcase',
    href: '#',
    decor: 'plane',
    cols: [[{ title: 'Our work', links: [L('Recent Launches'), L('Case Studies')] }]],
  },
  {
    kind: 'dd',
    id: 'stack',
    label: 'Stack',
    href: '#',
    decor: 'shield',
    cols: [
      [
        {
          title: 'Platform',
          links: [
            L('Built on Astro'),
            L('GitHub Workflow'),
            L('Cloudflare Edge'),
            L('Static-first'),
            L('Security by Design'),
          ],
        },
      ],
      [
        {
          title: 'Guides',
          links: [
            L('Speed Guide'),
            L('SEO Guide'),
            L('Hosting Guide'),
            L('Maintenance Guide'),
            L('AI Readiness'),
          ],
        },
      ],
    ],
  },
  {
    kind: 'dd',
    id: 'launch',
    label: 'Growth',
    href: '/launch',
    decor: 'rocket',
    cols: [
      [
        {
          title: 'Resources',
          links: [L('Campaigns', '/launch'), L('Success Stories'), L('Growth FAQ')],
        },
      ],
    ],
  },
  {
    kind: 'dd',
    id: 'support',
    label: 'Support',
    href: '#',
    decor: 'buoy',
    cols: [
      [{ title: 'Resources', links: [L('Help Centre'), L('Feedback'), L('Start a Project')] }],
    ],
  },
  {
    kind: 'dd',
    id: 'blog',
    label: 'Blog',
    href: '#',
    decor: 'pencil',
    cols: [
      [
        {
          title: 'Collections',
          links: [
            L('Featured'),
            L('Bundaberg'),
            L('Rebirth HQ'),
            L('Engineering & Stack'),
            L('How to Launch'),
            L('SEO & Speed'),
            L('AI & Automation'),
          ],
        },
      ],
    ],
  },
  {
    kind: 'dd',
    id: 'ai',
    label: 'AI Toolkit',
    href: '#',
    decor: 'cube',
    cols: [
      [
        {
          title: 'Learn',
          links: [
            L('AI for Local Business'),
            L('Integrations'),
            L('Personalisation'),
            L('Agents & Crawlers'),
            L('Toolkit Newsletter'),
            L('Toolkit Case Studies'),
          ],
        },
        {
          title: 'Build',
          links: [
            L('Open Source Starters', '#', true),
            L('Client Portal', '#', true),
            L('Documentation', '#', true),
            L('Developer Help Desk', '#', true),
          ],
        },
      ],
    ],
  },
  { kind: 'link', id: 'careers', label: 'Careers', href: '/careers' },
];
const isActive = (id: string) => active === id;
---

<header class="header" data-section="global-header" data-active={active}>
  <div class="header__pad">
    <div class="header__wrap">
      <a href="#main" class="header__skip" data-skip>
        Skip to main content
      </a>

      <a href="/" class="header__brand" data-brand aria-label="Rebirth Web Design — home">
        <span class="header__brand-light" data-brand-light>
          <LogoMark size={28} />
          <span class="header__brand-word">Rebirth</span>
        </span>
        <span class="header__brand-pill" data-brand-pill aria-hidden="true">
          <LogoMark size={22} />
          <span class="header__brand-word header__brand-word--sm">Rebirth</span>
        </span>
      </a>

      <nav class="header__menu" aria-label="Primary">
        <ul class="header__menu-list" role="list">
          {items.map((it) =>
            it.kind === 'link' ? (
              <li>
                <a
                  href={it.href}
                  class="header__link"
                  aria-current={isActive(it.id) ? 'page' : undefined}
                >
                  {it.label}
                </a>
              </li>
            ) : (
              <li class="header__dd" data-dd>
                <a
                  href={it.href}
                  class="header__dd-trigger"
                  data-dd-trigger
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls={`header-dd-${it.id}`}
                  aria-current={isActive(it.id) ? 'page' : undefined}
                >
                  <span>{it.label}</span>
                  <span class="header__dd-arrow" data-dd-arrow>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path
                        d="M12 6L8 10L4 6"
                        stroke="currentColor"
                        stroke-opacity="0.5"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </a>
                <div class="header__dd-list" id={`header-dd-${it.id}`} data-dd-list>
                  <div class="header__dd-card">
                    <div
                      class:list={[
                        'header__dd-layout',
                        it.cols.length > 1 && 'header__dd-layout--2',
                      ]}
                    >
                      {it.cols.map((col, ci) => (
                        <div
                          class:list={[
                            'header__dd-group',
                            it.cols.length > 1 && ci === 0 && 'header__dd-group--rule',
                          ]}
                        >
                          {col.map((list, li) => (
                            <>
                              {li > 0 && <div class="header__dd-line" />}
                              <div class="header__dd-links">
                                <div class="header__dd-title">{list.title}</div>
                                {list.links.map((l) => (
                                  <a href={l.href} class="header__dd-link">
                                    <span>{l.label}</span>
                                    {l.ext && (
                                      <svg
                                        class="header__dd-ext"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 16 16"
                                        fill="none"
                                        aria-hidden="true"
                                      >
                                        <path
                                          d="M5 4H12M12 4V11M12 4L4 12"
                                          stroke="currentColor"
                                          stroke-opacity="0.5"
                                          stroke-width="2"
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                        />
                                      </svg>
                                    )}
                                  </a>
                                ))}
                              </div>
                            </>
                          ))}
                        </div>
                      ))}
                    </div>
                    <div
                      class:list={['header__dd-decor', `header__dd-decor--${it.decor}`]}
                      data-dd-decor
                      aria-hidden="true"
                    >
                      {it.decor === 'plane' && (
                        <svg viewBox="0 0 140 140" fill="none">
                          <path d="M12 62 128 14 96 126 66 88 12 62Z" fill="#e0e3ff" />
                          <path d="M128 14 66 88l-6 34-14-44 82-64Z" fill="#b7bcff" />
                          <path d="M60 122 66 88l16 20-22 14Z" fill="#8b93ff" />
                          <path d="M128 14 46 78 12 62 128 14Z" fill="#fff" />
                          <rect x="18" y="104" width="8" height="8" fill="#57f287" />
                          <rect x="112" y="118" width="6" height="6" fill="#eb459e" />
                        </svg>
                      )}
                      {it.decor === 'shield' && (
                        <svg viewBox="0 0 200 200" fill="none">
                          <path
                            d="M100 18 168 44v52c0 44-28 74-68 88-40-14-68-44-68-88V44l68-26Z"
                            fill="#57f287"
                          />
                          <path d="M100 18 168 44v52c0 44-28 74-68 88V18Z" fill="#35ed7e" />
                          <path
                            d="M100 46 144 62v34c0 28-18 48-44 58-26-10-44-30-44-58V62l44-16Z"
                            fill="#1a2081"
                          />
                          <path
                            d="m82 100 14 14 26-30"
                            stroke="#fff"
                            stroke-width="12"
                            stroke-linecap="square"
                          />
                          <rect
                            x="150"
                            y="150"
                            width="12"
                            height="12"
                            fill="#eb459e"
                            transform="rotate(20 156 156)"
                          />
                          <rect x="30" y="26" width="8" height="8" fill="#fee75c" />
                        </svg>
                      )}
                      {it.decor === 'rocket' && (
                        <svg viewBox="0 0 140 140" fill="none">
                          <path d="M96 12c18 2 30 14 32 32L92 96 44 48 96 12Z" fill="#fff" />
                          <path d="M128 44c-2-18-14-30-32-32l-10 7 35 35 7-10Z" fill="#eb459e" />
                          <circle cx="88" cy="52" r="12" fill="#1a2081" />
                          <circle cx="88" cy="52" r="6" fill="#57f287" />
                          <path
                            d="M44 48 20 56l18 18 6-26Zm48 48-8 24-18-18 26-6Z"
                            fill="#b7bcff"
                          />
                          <path d="m40 82 18 18-34 24 16-42Z" fill="#fee75c" />
                          <path d="m44 90 6 6-16 12 10-18Z" fill="#eb459e" />
                        </svg>
                      )}
                      {it.decor === 'buoy' && (
                        <svg viewBox="0 0 150 150" fill="none">
                          <circle cx="75" cy="75" r="60" fill="#fff" />
                          <path
                            d="M75 15a60 60 0 0 1 42.4 17.6L91 59a22.6 22.6 0 0 0-16-6.6V15Zm60 60a60 60 0 0 1-17.6 42.4L91 91a22.6 22.6 0 0 0 6.6-16H135ZM75 135a60 60 0 0 1-42.4-17.6L59 91a22.6 22.6 0 0 0 16 6.6V135ZM15 75a60 60 0 0 1 17.6-42.4L59 59a22.6 22.6 0 0 0-6.6 16H15Z"
                            fill="#eb459e"
                          />
                          <circle cx="75" cy="75" r="24" fill="#5865f2" />
                          <rect x="118" y="10" width="10" height="10" fill="#57f287" />
                        </svg>
                      )}
                      {it.decor === 'pencil' && (
                        <svg viewBox="0 0 190 190" fill="none">
                          <path d="m138 22 30 30-98 98-30-30 98-98Z" fill="#fee75c" />
                          <path d="m153 37 15 15-98 98-15-15 98-98Z" fill="#f0b232" />
                          <path
                            d="m138 22 12-12c6-6 16-6 22 0l8 8c6 6 6 16 0 22l-12 12-30-30Z"
                            fill="#eb459e"
                          />
                          <path d="m40 120 30 30-46 16 16-46Z" fill="#fff" />
                          <path d="m30 150 10 10-16 6 6-16Z" fill="#1a2081" />
                          <rect x="24" y="30" width="12" height="12" fill="#57f287" />
                          <rect x="150" y="150" width="8" height="8" fill="#fff" />
                        </svg>
                      )}
                      {it.decor === 'cube' && (
                        <svg viewBox="0 0 190 190" fill="none">
                          <path d="M95 16 166 56v80l-71 40-71-40V56l71-40Z" fill="#b7bcff" />
                          <path d="M95 96v80l-71-40V56l71 40Z" fill="#e0e3ff" />
                          <path d="M95 16 166 56 95 96 24 56 95 16Z" fill="#fff" />
                          <path d="m95 40 28 16-28 16-28-16 28-16Z" fill="#57f287" />
                          <path d="M44 84 76 102v34L44 118V84Z" fill="#eb459e" />
                          <path
                            d="M114 110 146 92v14l-32 18v-14Zm0 28 32-18v14l-32 18v-14Z"
                            fill="#1a2081"
                          />
                          <rect x="160" y="160" width="10" height="10" fill="#fee75c" />
                        </svg>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            ),
          )}
        </ul>
      </nav>

      <div class="header__cta">
        <Button variant="nav" href="#" class="header__btn">
          Contact
        </Button>
      </div>

      <button
        class="header__burger-btn"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="header-burger"
        data-burger-open
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M5 6h14M5 12h14M5 18h7"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>

  <div class="header__blur" data-nav-blur aria-hidden="true"></div>

  <div
    class="header__burger"
    id="header-burger"
    data-burger
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
  >
    <div class="header__burger-panel" data-burger-panel>
      <div class="header__burger-top">
        <a href="/" class="header__burger-brand" aria-label="Rebirth Web Design — home">
          <LogoMark size={32} />
        </a>
        <button
          class="header__burger-close"
          type="button"
          aria-label="Close menu"
          data-burger-close
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M18 6 6 18M6 6l12 12"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
      <ul class="header__burger-list" role="list">
        {items.map((it) =>
          it.kind === 'link' ? (
            <li class="header__burger-item">
              <a href={it.href} class="header__burger-link">
                {it.label}
              </a>
            </li>
          ) : (
            <li class="header__burger-item" data-acc>
              <button
                type="button"
                class="header__burger-trigger"
                data-acc-trigger
                aria-expanded="false"
                aria-controls={`header-acc-${it.id}`}
              >
                <span>{it.label}</span>
                <span class="header__burger-arrow" data-acc-arrow>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path
                      d="M12 6L8 10L4 6"
                      stroke="currentColor"
                      stroke-opacity="0.5"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </button>
              <div class="header__burger-sub" id={`header-acc-${it.id}`} data-acc-list hidden>
                {it.cols.flat().map((list, gi) => (
                  <div class="header__burger-group">
                    {gi === 0 && (
                      <a href={it.href} class="header__burger-grouptitle">
                        {it.label}
                      </a>
                    )}
                    <div class="header__burger-sublinks">
                      <div class="header__burger-subtitle">{list.title}</div>
                      {list.links.map((l) => (
                        <a href={l.href} class="header__burger-sublink">
                          {l.label}
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </li>
          ),
        )}
      </ul>
      <div class="header__burger-bottom">
        <div class="header__burger-grad"></div>
        <a href="#" class="header__burger-cta header__burger-cta--ghost">
          Contact
        </a>
        <a href="/services" class="header__burger-cta">
          Start your website
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* ---------- bar ---------- */
  .header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 99;
    font-family: var(--font-abc-ginto-discord);
  }
  .header__pad {
    position: relative;
    z-index: 2;
    padding: 0 var(--page-gutter);
  }
  .header__wrap {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    height: 80px;
    margin: 0 auto;
  }

  .header__skip {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 13px var(--spacing-24);
    border-radius: var(--radius-md);
    background: var(--color-signal-green);
    color: var(--color-black);
    font-size: 16px;
    line-height: 22px;
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-20px);
    transition:
      transform 0.25s,
      opacity 0.25s;
  }
  .header__skip:focus-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translate(0);
    outline: none;
  }

  /* ---------- brand lockup (146 x 40, fixed) ---------- */
  .header__brand {
    position: fixed;
    left: var(--page-gutter);
    top: 40px;
    z-index: 3;
    display: block;
    width: 146px;
    height: 40px;
    color: var(--color-white);
    text-decoration: none;
  }
  .header__brand:focus-visible {
    outline: 2px solid var(--color-blurple);
    outline-offset: 2px;
    border-radius: var(--radius-lg);
  }
  .header__brand-light,
  .header__brand-pill {
    position: absolute;
    display: flex;
    align-items: center;
  }
  .header__brand-light {
    inset: 0;
    gap: var(--spacing-10);
  }
  .header__brand-pill {
    inset: 1px 0;
    justify-content: center;
    gap: var(--spacing-8);
    border-radius: var(--radius-nav-controls);
    background: var(--surface-white-control);
    color: var(--color-black);
    opacity: 0;
  }
  .header__brand-word {
    font-family: var(--font-abc-ginto-discord-nord);
    font-weight: var(--font-weight-extrabold);
    font-size: 19.5px;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .header__brand-word--sm {
    font-size: 15px;
  }

  /* ---------- link row ---------- */
  .header__menu {
    margin: 0 auto;
  }
  .header__menu-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header__menu-list > li {
    position: relative;
  }
  .header__link,
  .header__dd-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    box-sizing: border-box;
    padding: var(--spacing-10) var(--spacing-16);
    border-radius: var(--radius-md);
    color: var(--color-white);
    text-decoration: none;
    white-space: nowrap;
    font-size: var(--text-nav);
    line-height: var(--leading-nav);
    font-weight: var(--font-weight-medium);
    transition: background-color 0.4s;
  }
  .header__link {
    gap: var(--spacing-8);
  }
  .header__dd-trigger {
    gap: var(--spacing-4);
    position: relative;
    cursor: pointer;
  }
  .header__link:hover,
  .header__dd.is-open > .header__dd-trigger {
    background-color: var(--color-blurple);
  }
  .header__link:focus-visible,
  .header__dd-trigger:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: -2px;
  }
  .header__dd-arrow {
    display: flex;
    width: 16px;
    height: 16px;
  }

  /* ---------- dropdown panel ---------- */
  .header__dd-list {
    position: absolute;
    top: 36px;
    left: 50%;
    width: 522px;
    margin-left: -261px;
    z-index: 900;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .header__dd.is-open > .header__dd-list {
    pointer-events: auto;
  }
  .header__dd-card {
    position: relative;
    margin-top: 7px;
    padding: var(--spacing-40);
    border-radius: 40px;
    background: var(--color-blurple);
  }
  .header__dd-layout {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto;
    gap: 30px;
    max-width: 982px;
  }
  .header__dd-layout--2 {
    grid-template-columns: auto 1fr;
    gap: var(--spacing-40);
  }
  .header__dd-group {
    position: relative;
  }
  .header__dd-group--rule {
    min-width: 168px;
    padding-right: 21px;
  }
  .header__dd-group--rule::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-white-10);
  }
  .header__dd-layout--2 .header__dd-group:last-child {
    padding-right: var(--spacing-20);
  }
  .header__dd-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }
  .header__dd-title {
    margin-bottom: var(--spacing-4);
    color: var(--color-white);
    opacity: 0.5;
    font-size: 16px;
    line-height: 1.3;
    font-weight: var(--font-weight-regular);
    white-space: nowrap;
  }
  .header__dd-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    color: var(--color-white);
    text-decoration: none;
    white-space: nowrap;
    font-size: 16px;
    line-height: 1.2;
    font-weight: var(--font-weight-medium);
    transition: opacity 0.35s;
  }
  .header__dd-link:hover {
    opacity: 0.65;
  }
  .header__dd-link:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }
  .header__dd-ext {
    transition: transform 0.3s;
  }
  .header__dd-link:hover .header__dd-ext {
    transform: translate(2px, -2px);
  }
  .header__dd-line {
    height: 1px;
    margin: var(--spacing-24) 0;
    background: var(--color-white);
    opacity: 0.1;
  }
  .header__dd-decor {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 140px;
    margin: 0 -72px -98px 0;
    pointer-events: none;
    opacity: 0;
  }
  .header__dd-decor svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .header__dd-decor--plane {
    margin: 0 -54px -46px 0;
  }
  .header__dd-decor--shield {
    width: 200px;
    margin: 0 -92px -122px 0;
  }
  .header__dd-decor--buoy {
    width: 150px;
    margin: 0 -94px -80px 0;
  }
  .header__dd-decor--pencil {
    width: 190px;
    margin: 0 -80px -100px 0;
  }
  .header__dd-decor--cube {
    width: 190px;
    margin: 0 -100px -120px 0;
  }

  .header__blur {
    position: fixed;
    inset: 0;
    z-index: 1;
    height: 100vh;
    background: rgba(0, 0, 0, 0.8);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.4s,
      visibility 0.4s;
  }
  .header:has(.header__dd.is-open) .header__blur {
    opacity: 1;
    visibility: visible;
  }

  /* ---------- right-hand button (fixed) ---------- */
  .header__cta {
    position: fixed;
    right: var(--page-gutter);
    top: 41px;
    z-index: 3;
  }
  .header__cta :global(.button) {
    transition: background-color 0.25s;
  }

  /* ---------- burger ---------- */
  .header__burger-btn,
  .header__burger-close {
    display: none;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: var(--color-white-10);
    color: var(--color-white);
    cursor: pointer;
    transition: background-color 0.5s;
  }
  .header__burger-btn:hover,
  .header__burger-close:hover {
    background: rgba(255, 255, 255, 0.3);
  }
  .header__burger-close {
    display: flex;
    background: rgba(255, 255, 255, 0.3);
    transition-duration: 0.4s;
  }
  .header__burger-btn:focus-visible,
  .header__burger-close:focus-visible,
  .header__burger-trigger:focus-visible,
  .header__burger-link:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
