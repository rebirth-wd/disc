<style>
  .cast {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .cast :global(.cb-eye),
  .cast :global(.cb-tuft),
  .cast :global(.cb-wave),
  .cast :global(.cb-flame),
  .cast :global(.cb-crest),
  .cast :global(.cb-ghost),
  .cast :global(.cb-poof rect) {
    transform-box: fill-box;
  }
  .cb-eye {
    transform-origin: 50% 50%;
  }
  .cb-tuft {
    transform-origin: 50% 100%;
  }
  .cb-wave {
    transform-origin: 0% 100%;
  }
  .cb-wave--b {
    transform-origin: 0% 50%;
  }
  .cb-flame {
    transform-origin: 50% 0%;
  }
  .cb-crest {
    transform-origin: 50% 100%;
  }
  .cb-ghost {
    transform-origin: 50% 50%;
  }
  .cb-glitch,
  .cb-poof rect {
    opacity: 0;
  }
  .cb-ghost-wrap {
    cursor: pointer;
    outline: none;
  }
  .cb-ghost-wrap:focus-visible .cb-ghost-body {
    stroke: var(--color-signal-green);
    stroke-width: 3;
  }
  .cb-ghost-wrap[data-done] {
    pointer-events: none;
  }
  @media (max-width: 767px) {
    .cast :global(g[data-char]:not([data-char='hatch'])) {
      display: none;
    }
  }
</style>
