---
/**
 * Media loop for Feature5 — original "content queue": a phone with a mosaic of drafted posts; suggestion
 * cards pop out over its edge and tiles shuffle. 7.5s seamless GSAP loop (reference clip: 7.5s).
 */
import { Image } from 'astro:assets';
import Stage from './Stage.astro';
import glow from '../../../assets/photos/featB-glow-room.jpg';
import violet from '../../../assets/photos/featB-violet-room.jpg';
import laptop from '../../../assets/photos/featB-purple-laptop.jpg';
---
<Stage>
  <div class="cd" data-fbx-contentdeck>
    <div class="cd-phone">
      <div class="cd-top">
        <svg viewBox="0 0 10 10" width="10" height="10"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="#fff" stroke-width="1.4" /></svg>
        <span>Queue</span>
        <i class="is-on"></i><i></i><i></i>
      </div>
      <div class="cd-tile" data-cd-tile="0" style="left:11px;top:68px;height:243px;">
        <Image src={glow} alt="" width={240} class="cd-img" /><em>Blog</em>
      </div>
      <div class="cd-tile" data-cd-tile="1" style="left:138px;top:66px;height:119px;">
        <Image src={violet} alt="" width={240} class="cd-img" /><em>Reel</em><b data-cd-ring></b>
      </div>
      <div class="cd-tile" data-cd-tile="2" style="left:138px;top:195px;height:116px;">
        <Image src={laptop} alt="" width={240} class="cd-img" /><em>Post</em>
      </div>
      <div class="cd-tile cd-tile--chart" data-cd-tile="3" style="left:10px;top:321px;height:119px;">
        <svg viewBox="0 0 118 119" preserveAspectRatio="none"><path d="M0 96 22 80 40 88 62 56 82 64 118 22V119H0Z" fill="#0d6b45" /><path d="M0 96 22 80 40 88 62 56 82 64 118 22" fill="none" stroke="#eafff3" stroke-width="4" stroke-linejoin="round" /></svg>
        <em class="is-light">+38% searches</em>
      </div>
      <div class="cd-tile cd-tile--draft" data-cd-tile="4" style="left:139px;top:323px;height:117px;">
        <span class="cd-face"><i></i><i></i></span><em>Draft</em>
      </div>
      <div class="cd-bar"><i></i><i></i><i></i><i></i><i class="is-go"><svg viewBox="0 0 16 16" width="16" height="16"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="#06301f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></i></div>
    </div>
    <div class="cd-card cd-card--a" data-cd-card>
      <span class="cd-badge"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M13 2 5 13h5l-1 9 8-11h-5z" fill="#fff" /></svg></span>
      <strong>Publish</strong>
    </div>
    <div class="cd-card cd-card--b" data-cd-card>
      <svg viewBox="0 0 20 20" width="20" height="20"><path d="M4 12v4h12v-4M10 13V3m0 0L6 7m4-4 4 4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>Push to your socials</span>
    </div>
  </div>
</Stage>

<style>
  .cd { position: absolute; inset: 0; color: #fff; }
  .cd-phone { position: absolute; left: 184px; top: 31px; width: 270px; height: 540px; border-radius: 30px 30px 0 0; background: #050507; }
  .cd-top { position: absolute; left: 16px; right: 16px; top: 16px; height: 22px; display: flex; align-items: center; gap: 8px; font-size: 12px; }
  .cd-top span { flex: 1; }
  .cd-top i { width: 22px; height: 22px; border-radius: 7px; background: rgba(255, 255, 255, 0.14); }
  .cd-top i.is-on { background: #fff; }
  .cd-tile { position: absolute; width: 118px; border-radius: 6px; overflow: hidden; background: #1c1c26; }
  .cd-tile :global(.cd-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cd-tile em { position: absolute; left: 50%; bottom: 8px; transform: translateX(-50%); font-style: normal; font-size: 9.5px; line-height: 1; padding: 4px 7px; border-radius: 5px; background: rgba(20, 20, 28, 0.78); white-space: nowrap; }
  .cd-tile em.is-light { background: #fff; color: #10321f; bottom: auto; top: 52px; }
  .cd-tile b { position: absolute; inset: 0; border-radius: 6px; outline: 3px solid var(--color-spring-green); outline-offset: -3px; opacity: 0; }
  .cd-tile--chart { background: var(--color-signal-green); }
  .cd-tile--chart svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cd-tile--draft { background: #c7a6f5; }
  .cd-face { position: absolute; left: 50%; top: 34px; width: 44px; height: 44px; margin-left: -22px; border-radius: 12px; background: var(--color-fuchsia); display: flex; align-items: center; justify-content: center; gap: 8px; }
  .cd-face i { width: 7px; height: 11px; border-radius: 2px; background: #fff; }
  .cd-bar { position: absolute; left: 22px; right: 22px; top: 458px; height: 58px; border-radius: 16px; background: #1c1c22; display: flex; align-items: center; justify-content: space-around; padding: 0 12px; }
  .cd-bar i { width: 22px; height: 22px; border-radius: 6px; background: rgba(255, 255, 255, 0.85); display: grid; place-items: center; }
  .cd-bar i:nth-child(2n) { border-radius: 50%; width: 18px; height: 18px; }
  .cd-bar i.is-go { width: 34px; height: 34px; border-radius: 10px; background: var(--color-spring-green); }
  .cd-card { position: absolute; left: 414px; border-radius: 14px; background: #25252c; display: flex; align-items: center; }
  .cd-card--a { top: 160px; width: 230px; height: 100px; justify-content: center; gap: 12px; }
  .cd-card--a strong { font-family: var(--font-abc-ginto-discord-nord); font-weight: 700; font-size: 22px; letter-spacing: -0.01em; text-transform: uppercase; }
  .cd-badge { width: 46px; height: 34px; border-radius: 10px; background: var(--color-fuchsia); display: grid; place-items: center; }
  .cd-card--b { top: 327px; width: 202px; height: 72px; gap: 12px; padding: 0 22px; font-size: 13px; }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll<HTMLElement>('[data-fbx-contentdeck]').forEach((root) => {
    const cards = gsap.utils.toArray<HTMLElement>('[data-cd-card]', root);
    const tile = (n: number) => root.querySelector<HTMLElement>(`[data-cd-tile="${n}"]`);
    const ring = root.querySelector('[data-cd-ring]');
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.set(cards, { scale: 0.5, opacity: 0, transformOrigin: '0% 50%' });
      const tl = gsap.timeline({ repeat: -1, paused: true });
      tl.to(ring, { opacity: 1, duration: 0.2, ease: 'none' }, 0.5)
        .to(cards[0], { scale: 1, opacity: 1, duration: 0.45, ease: 'back.out(1.7)' }, 0.9)
        .to(cards[1], { scale: 1, opacity: 1, duration: 0.45, ease: 'back.out(1.7)' }, 2.1)
        // shuffle: right-column tiles swap vertically, bottom tiles swap sideways
        .to(tile(1), { y: 126, duration: 0.6, ease: 'power2.inOut' }, 3.5)
        .to(tile(2), { y: -129, duration: 0.6, ease: 'power2.inOut' }, 3.5)
        .to(tile(3), { x: 129, y: 2, duration: 0.6, ease: 'power2.inOut' }, 3.7)
        .to(tile(4), { x: -129, y: -2, duration: 0.6, ease: 'power2.inOut' }, 3.7)
        .to(cards[1], { scale: 0.5, opacity: 0, duration: 0.28, ease: 'back.in(1.6)' }, 5.3)
        .to(cards[0], { scale: 0.5, opacity: 0, duration: 0.28, ease: 'back.in(1.6)' }, 5.5)
        .to(ring, { opacity: 0, duration: 0.2, ease: 'none' }, 5.8)
        .to([tile(1), tile(2), tile(3), tile(4)], { x: 0, y: 0, duration: 0.6, ease: 'power2.inOut' }, 6.2)
        .to({}, { duration: 0.01 }, 7.49);
      const st = ScrollTrigger.create({ trigger: root, start: 'top bottom', end: 'bottom top', onToggle: (s) => (s.isActive ? tl.play() : tl.pause()) });
      return () => { st.kill(); tl.kill(); };
    });
  });
</script>
