---
/**
 * Fixed-size design stage (727×554 = the media inset at desktop) that scales uniformly with its parent,
 * so the animated graphics keep their proportions when the inset shrinks on smaller viewports.
 */
interface Props { w?: number; h?: number; class?: string }
const { w = 727, h = 554, class: cls = '' } = Astro.props;
---
<div class:list={['fbx-stage-wrap', cls]} data-fbx-stage-wrap data-w={w} aria-hidden="true">
  <div class="fbx-stage" data-fbx-stage style={`width:${w}px;height:${h}px;`}>
    <slot />
  </div>
</div>

<style>
  .fbx-stage-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .fbx-stage {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    transform: scale(var(--fbx-s, 1));
    font-family: var(--font-abc-ginto-discord);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-fbx-stage-wrap]').forEach((wrap) => {
    const w = Number(wrap.dataset.w) || 727;
    const apply = () => {
      const cw = wrap.clientWidth;
      if (cw) wrap.style.setProperty('--fbx-s', String(cw / w));
    };
    apply();
    new ResizeObserver(apply).observe(wrap);
  });
</script>
