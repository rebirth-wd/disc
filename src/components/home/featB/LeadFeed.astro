---
/**
 * Media loop for Feature4 — original "live enquiry feed": a cursor walks down a list of scored leads and a
 * detail card opens beside the hovered row. 7.4s seamless GSAP loop (reference clip: 7.375s).
 */
import Stage from './Stage.astro';
const leads = [
  {
    n: 'Olivia M.',
    s: 'Chat · wants a quote',
    c: '#c4a7ff',
    i: 'OM',
    score: 92,
    note: 'Needs a 6-page site before March. Budget confirmed.',
    tag: 'Ready to buy',
  },
  {
    n: "Dan's Diesel",
    s: 'Form · new website',
    c: '#57f287',
    i: 'DD',
    score: 88,
    note: 'Old site is slow on mobile. Asked for a call back.',
    tag: 'Ready to buy',
  },
  {
    n: 'Reef Tours',
    s: 'Call-back · bookings',
    c: '#6fb1ff',
    i: 'RT',
    score: 81,
    note: 'Wants online bookings live before peak season.',
    tag: 'Warm lead',
  },
  {
    n: 'Marlo Café',
    s: 'Chat · menu update',
    c: '#e3e4ea',
    i: 'MC',
    score: 64,
    note: 'Existing client. Small content change requested.',
    tag: 'Quick win',
  },
];
const idle = ['Guest 2214', 'Guest 0937', 'Guest 5120'];
const idleC = ['#5b6fb8', '#3f8f6b', '#8a5aa0'];
---

<Stage>
  <div class="lf" data-fbx-leadfeed>
    <div class="lf-panel">
      <div class="lf-head">
        <span>Hot leads — 4</span>
        <svg viewBox="0 0 12 12" width="12" height="12">
          <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </div>
      {leads.map((l, k) => (
        <div class="lf-row" style={`top:${46 + k * 45}px`}>
          <i class="lf-hl" data-lf-hl></i>
          <span class="lf-av" style={`background:${l.c}`}>
            {l.i}
            <b></b>
          </span>
          <span class="lf-txt">
            <em style={`color:${l.c}`}>{l.n}</em>
            <small>{l.s}</small>
          </span>
        </div>
      ))}
      <div class="lf-head lf-head--2">
        <span>Just browsing — 3</span>
      </div>
      {idle.map((n, k) => (
        <div class="lf-row is-idle" style={`top:${277 + k * 42}px`}>
          <span class="lf-av" style={`background:${idleC[k]}`}></span>
          <span class="lf-txt">
            <em style={`color:${idleC[k]}`}>{n}</em>
          </span>
        </div>
      ))}
    </div>
    {leads.map((l, k) => (
      <div class="lf-pop" data-lf-pop style={`top:${60 + k * 45}px`}>
        <div class="lf-pop-top">
          <span class="lf-av lf-av--sm" style={`background:${l.c}`}>
            {l.i}
          </span>
          <span class="lf-pop-name">
            {l.n}
            <small>{l.tag}</small>
          </span>
          <span class="lf-score">{l.score}</span>
        </div>
        <p>{l.note}</p>
        <div class="lf-bar">
          <i style={`width:${l.score}%`}></i>
        </div>
        <div class="lf-reply">Reply drafted</div>
      </div>
    ))}
    <svg class="lf-cursor" data-lf-cursor viewBox="0 0 36 36" width="36" height="36">
      <path
        d="M4 3 31 16 19 20 14 32Z"
        fill="#fff"
        stroke="#15151c"
        stroke-width="2.5"
        stroke-linejoin="round"
      />
    </svg>
  </div>
</Stage>

<style>
  .lf {
    position: absolute;
    inset: 0;
    color: #fff;
  }
  .lf-panel {
    position: absolute;
    left: 89px;
    top: 45px;
    width: 274px;
    height: 447px;
    border-radius: 16px;
    background: #1b1b22;
  }
  .lf-head {
    position: absolute;
    left: 21px;
    right: 18px;
    top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    line-height: 16px;
    color: #b9bac6;
  }
  .lf-head--2 {
    top: 247px;
  }
  .lf-row {
    position: absolute;
    left: 20px;
    width: 233px;
    height: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 4px;
  }
  .lf-row.is-idle {
    opacity: 0.55;
  }
  .lf-hl {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    opacity: 0;
  }
  .lf-av {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 500;
    color: #1b1b22;
  }
  .lf-av b {
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-signal-green);
    outline: 3px solid #1b1b22;
  }
  .lf-av--sm {
    width: 24px;
    height: 24px;
    font-size: 9px;
  }
  .lf-txt {
    position: relative;
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .lf-txt em {
    font-style: normal;
    font-size: 16px;
  }
  .lf-txt small {
    font-size: 11.5px;
    color: #c9cad3;
    margin-top: 2px;
  }
  .lf-pop {
    position: absolute;
    left: 382px;
    width: 230px;
    padding: 10px 12px 12px;
    border-radius: 10px;
    background: #24242c;
    opacity: 0;
  }
  .lf-pop-top {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lf-pop-name {
    flex: 1;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.15;
    display: flex;
    flex-direction: column;
  }
  .lf-pop-name small {
    font-size: 9.5px;
    font-weight: 400;
    color: #b9bac6;
  }
  .lf-score {
    font-size: 11px;
    font-weight: 500;
    color: #10321f;
    background: var(--color-spring-green);
    border-radius: 6px;
    padding: 2px 6px;
  }
  .lf-pop p {
    margin: 9px 0 8px;
    font-size: 10.5px;
    line-height: 1.35;
    color: #dcdde4;
  }
  .lf-bar {
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .lf-bar i {
    display: block;
    height: 100%;
    background: var(--color-fuchsia);
    border-radius: 2px;
  }
  .lf-reply {
    margin-top: 9px;
    font-size: 10px;
    text-align: center;
    padding: 5px 0;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: #b9bac6;
  }
  .lf-cursor {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(318px, 232px);
    overflow: visible;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll<HTMLElement>('[data-fbx-leadfeed]').forEach((root) => {
    const cursor = root.querySelector('[data-lf-cursor]');
    const hls = gsap.utils.toArray<HTMLElement>('[data-lf-hl]', root);
    const pops = gsap.utils.toArray<HTMLElement>('[data-lf-pop]', root);
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const STEP = 1.85; // 4 rows × 1.85s = 7.4s
      const pos = (k: number) => ({ x: 318 - (k % 2) * 14, y: 97 + k * 45 });
      gsap.set(cursor, pos(3)); // loop starts where it ends
      gsap.set(pops, { opacity: 0, y: 8, scale: 0.96, transformOrigin: '0% 20%' });
      const tl = gsap.timeline({ repeat: -1, paused: true });
      hls.forEach((hl, k) => {
        const t = k * STEP;
        tl.to(cursor, { ...pos(k), duration: 0.5, ease: 'power2.inOut' }, t)
          .to(hl, { opacity: 1, duration: 0.15, ease: 'none' }, t + 0.4)
          .to(pops[k], { opacity: 1, y: 0, scale: 1, duration: 0.28, ease: 'power2.out' }, t + 0.5)
          .to(
            pops[k],
            { opacity: 0, y: 8, scale: 0.96, duration: 0.2, ease: 'power1.in' },
            t + STEP - 0.2,
          )
          .to(hl, { opacity: 0, duration: 0.15, ease: 'none' }, t + STEP - 0.05);
      });
      // last highlight fades during the first 0.1s of the next cycle → wrap it so the loop is exact
      tl.set(hls[hls.length - 1], { opacity: 0 }, 4 * STEP);
      const st = ScrollTrigger.create({
        trigger: root,
        start: 'top bottom',
        end: 'bottom top',
        onToggle: (s) => (s.isActive ? tl.play() : tl.pause()),
      });
      return () => {
        st.kill();
        tl.kill();
      };
    });
    // reduced motion / no JS: show the first lead's card
    mm.add('(prefers-reduced-motion: reduce)', () => {
      gsap.set(cursor, { x: 318, y: 97 });
      gsap.set(hls[0], { opacity: 1 });
      gsap.set(pops[0], { opacity: 1 });
    });
  });
</script>
