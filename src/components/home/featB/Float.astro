---
/**
 * A floating decor object with the reference's scroll parallax (IX2 SCROLLING_IN_VIEW, smoothing 80):
 * translateY goes `from` → `to` while an invisible 2000px-tall trigger travels through the viewport
 * (progress 0 when the trigger's top meets the viewport bottom, 1 when its bottom leaves the top).
 * The inner element carries an idle float loop (addition asked for in the brief; the reference objects
 * only move with scroll).
 *
 * Position the object with `class` (styles live in the Feature component). `triggerTop` is a CSS length for the
 * trigger's offset from the section top (the decor layer spans the section).
 */
interface Props {
  class?: string;
  from: number;
  to: number;
  ease?: 'none' | 'ease';
  triggerTop: string;
  triggerHeight?: number;
  front?: boolean;
  floatY?: number;
  floatRot?: number;
  floatDur?: number;
}
const { class: cls = '', from, to, ease = 'none', triggerTop, triggerHeight = 2000, front = false, floatY = 8, floatRot = 3, floatDur = 3.6 } = Astro.props;
---
<div class="fbx-trigger" data-fbx-trigger style={`top:${triggerTop};height:${triggerHeight}px;`}></div>
<div
  class:list={['fbx-float', cls]}
  data-fbx-float
  data-from={from}
  data-to={to}
  data-ease={ease}
  data-float-y={floatY}
  data-float-rot={floatRot}
  data-float-dur={floatDur}
  {...(front ? { 'data-decor-front': '' } : {})}
>
  <div class="fbx-float-inner" data-fbx-float-inner><slot /></div>
</div>

<style>
  .fbx-trigger {
    position: absolute;
    left: 0;
    width: 0;
    pointer-events: none;
  }
  .fbx-float {
    will-change: transform;
  }
  .fbx-float-inner {
    width: 100%;
    height: 100%;
  }
  .fbx-float-inner :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { CustomEase } from 'gsap/CustomEase';
  gsap.registerPlugin(ScrollTrigger, CustomEase);

  // CSS `ease` — the easing IX2 applies between the coin's two keyframes
  const cssEase = CustomEase.create('fbxCssEase', '0.25,0.1,0.25,1');

  document.querySelectorAll<HTMLElement>('[data-fbx-float]').forEach((el, i) => {
    const trigger = el.previousElementSibling as HTMLElement | null;
    const inner = el.querySelector<HTMLElement>('[data-fbx-float-inner]');
    const from = Number(el.dataset.from);
    const to = Number(el.dataset.to);
    const mm = gsap.matchMedia();

    // scroll parallax — reference runs it on ≥768 only (IX2 media queries: main, medium)
    mm.add('(prefers-reduced-motion: no-preference) and (min-width: 768px)', () => {
      if (!trigger) return;
      const tween = gsap.fromTo(
        el,
        { y: from },
        {
          y: to,
          ease: el.dataset.ease === 'ease' ? cssEase : 'none',
          scrollTrigger: { trigger, start: 'top bottom', end: 'bottom top', scrub: 0.8 },
        },
      );
      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        gsap.set(el, { clearProps: 'transform' });
      };
    });

    // idle float
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      if (!inner) return;
      const dy = Number(el.dataset.floatY) || 0;
      const rot = Number(el.dataset.floatRot) || 0;
      const dur = Number(el.dataset.floatDur) || 3.6;
      const tween = gsap.fromTo(
        inner,
        { y: -dy, rotation: -rot },
        { y: dy, rotation: rot, duration: dur, ease: 'sine.inOut', repeat: -1, yoyo: true, delay: -i * 0.9 },
      );
      return () => {
        tween.kill();
        gsap.set(inner, { clearProps: 'transform' });
      };
    });
  });
</script>
