---
/**
 * Reference: div.home--5section (y 3590–4526, 936 tall, padding 190 / 136) — text left, fuchsia inset right.
 * Decor: the blurred coin behind the slab's lower-left corner (in the reference DOM it belongs to the next
 * section but paints behind this slab; the shell isolates sections, so it lives here).
 */
import FeatureBlock from './FeatureBlock.astro';
import LeadFeed from './featB/LeadFeed.astro';
import Stars from './featB/Stars.astro';
import Float from './featB/Float.astro';
---
<FeatureBlock name="leads" heading="Know who's<br>ready to<br>buy now" reverse sectionHeight={936} padTop={190} insetFill="fuchsia" textPadRight={4} padLg={[235, 165]} padMd={[154, 130]} padSm={[144, 106]} class="featb featb-leads">
  <LeadFeed slot="media" />
  Every enquiry — chat, form, or call-back — gets read, summarised, and scored before it hits your inbox. You see who's ready to buy and who's browsing.
  <Fragment slot="decor">
    <Stars />
    <!-- coin: IX2 a-632, y -240 → 100, CSS ease, trigger starts 448.5px above the next section's top -->
    <Float class="featb-coin" from={-240} to={100} ease="ease" triggerTop="calc(100% - 448.5px)" floatY={6} floatRot={4} floatDur={4.2}>
      <svg viewBox="0 0 210 210">
        <defs>
          <linearGradient id="fbCoinA" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#b9a8ff" /><stop offset="1" stop-color="#6a4be0" /></linearGradient>
          <linearGradient id="fbCoinB" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8f8bff" /><stop offset="1" stop-color="#5865f2" /></linearGradient>
        </defs>
        <g transform="rotate(-20 105 105)">
          <ellipse cx="113" cy="110" rx="78" ry="92" fill="#a05bd8" />
          <ellipse cx="100" cy="104" rx="78" ry="92" fill="url(#fbCoinA)" />
          <ellipse cx="100" cy="104" rx="60" ry="72" fill="url(#fbCoinB)" />
          <path d="M100 58a40 46 0 1 1-34 22" fill="none" stroke="#e9e4ff" stroke-width="12" stroke-linecap="round" />
          <path d="M84 110l12 14 24-30" fill="none" stroke="#e9e4ff" stroke-width="11" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </svg>
    </Float>
  </Fragment>
</FeatureBlock>

<style is:global>
  /* glass texture of this slab: bright upper-left, navy towards the inset (sampled from the reference) */
  section.featb-leads [data-fb-slab] {
    background-image:
      radial-gradient(60% 80% at 18% 0%, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 70%),
      linear-gradient(95deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.16) 38%, rgba(255, 255, 255, 0.05) 62%, rgba(12, 12, 48, 0.4) 100%);
  }
  @media (min-width: 1440px) {
    /* measured: text x=273 / inset x=699 on the reversed blocks; inset x=248 / text x=1016 on the mirrored one */
    section.featb .fb-slab.is-reverse { padding-left: 53px; padding-right: 34px; }
    section.featb .fb-slab:not(.is-reverse) { column-gap: 41px; }
  }
  .featb-coin { left: calc(var(--fb-cx) - 96px); bottom: -106px; width: 210px; height: 211px; filter: blur(5px); }
  @media (max-width: 1439px) {
    .featb-coin { bottom: -128px; width: 142px; height: 143px; filter: blur(4px); }
  }
  @media (max-width: 767px) {
    .featb-coin { left: -52px; bottom: -100px; width: 132px; height: 133px; }
  }
</style>
