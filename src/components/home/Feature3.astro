---
// Reference: div.home--4section (y 2556–3451, h 895, padding 95/190). Media left, text right, indigo inset.
import FeatureBlock from './FeatureBlock.astro';
import PipelineLoop from './featA/PipelineLoop.astro';
import Objects from './featA/Objects.astro';
import Twinkles from './featA/Twinkles.astro';
---
<FeatureBlock
  name="feature-3"
  heading="A site that<br>monitors and<br>repairs itself"
  sectionHeight={895}
  padTop={95}
  padLg={[154, 197]}
  padMd={[130, 180]}
  padSm={[130, 80]}
  insetFill="indigo"
  textPadRight={11.2}
  class="z-[3]"
>
  <PipelineLoop slot="media" />
  Security scanning and patching, uptime monitoring with instant alerts, and backups that run without anyone remembering to run them.
  <Fragment slot="decor">
    <Twinkles stars={[[1334, -45, 20, 1], [319, -18, 20, 2], [845, -63, 6, 2], [173, 134, 6, 2], [476, -27, 6, 3], [1148, -81, 6, 2], [290, 125, 8, 3], [1501, -54, 6, 1], [1476, 90, 4, 3], [569, 90, 4, 3]]} />
    <div data-decor-front style="right:calc(var(--fb-cx) + 20.8px);top:calc(var(--fb-cy) - 117.6px)"><Objects kind="stack" /></div>
  </Fragment>
</FeatureBlock>
