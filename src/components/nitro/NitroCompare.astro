---
import Button from '../global/Button.astro';
import NitroObject from './NitroObject.astro';
type Cell = boolean | string;
type Row = [string, Cell, Cell];
const groups: { title: string; link?: boolean; tall?: boolean; rows: Row[] }[] = [
  { title: 'Care Rewards', link: true, tall: true, rows: [
    ['AI Site Assistant (Starter Edition)', false, true],
    ['Monthly performance tuning', false, true],
    ['Monthly content refresh', false, true],
  ] },
  { title: 'Always online', rows: [
    ['Managed edge hosting', true, true],
    ['Uptime monitoring with instant alerts', false, true],
    ['Self-repairing site checks', false, true],
    ['Tested preview deploys', false, true],
  ] },
  { title: 'Keep your site safe', rows: [
    ['Daily automatic backups', true, true],
    ['Security scanning and patching, plus framework updates', true, true],
    ['Version control', true, true],
    ['Dependency updates on a schedule', false, true],
    ['20+ tested integrations', false, true],
  ] },
  { title: 'No limits, all fast', rows: [
    ['Speed Multiplier', false, true],
    ['Monthly Reports', false, true],
    ['Backup retention', '30 days', '1 year'],
    ['Core Web Vitals audits', true, true],
    ['SSL certificate', true, true],
    ['AI lead scoring', false, true],
    ['2 content edits + 30% off extra edits', false, true],
    ['3 blog posts drafted', false, true],
    ['Market-shift suggestions, and copy changes', false, true],
    ['Priority Support', false, true],
    ['Direct line to the developer, same day', false, true],
    ['AI tools in your workplace', false, true],
  ] },
];
---
<section data-section="nitro-compare" id="compare" class="nc">
  <div class="nitro-pad">
    <div class="nitro-wrap nitro-wrap--wide">
      <NitroObject name="cloud" par="windy" class="nc__cloud" />
      <h2 class="nitro-h2 nc__title" data-par-trigger="plan">Pick your plan</h2>
      <NitroObject name="disks" par="battery" class="nc__disks" />

      <div class="nc__table" role="table" aria-label="Care plan comparison">
        <div class="nc__head" role="row">
          <div class="nc__features" role="columnheader">Features</div>
          <div class="nc__plan" role="columnheader">
            <h3 class="nc__name">Care<br /><span>Basic</span></h3>
            <Button variant="white" href="#" class="nitro-btn nitro-btn--ghost nitro-btn--lift nc__btn">Subscribe</Button>
          </div>
          <div class="nc__plan nc__plan--care" role="columnheader">
            <h3 class="nc__name">Care<br /><span aria-hidden="true" style="opacity:0">-</span></h3>
            <Button variant="white" href="#" class="nitro-btn nitro-btn--lift nc__btn">Subscribe</Button>
          </div>
        </div>

        {groups.map((g) => (
          <>
            <div class="nc__group" role="row">
              <div class="nc__grouptitle" role="cell">
                <div class="nitro-h4">{g.title}</div>
                {g.link && <div class="nc__terms"><a href="#faq" class="nitro-link">Terms and eligibility rules apply.</a></div>}
              </div>
              <div role="cell"></div><div role="cell"></div>
            </div>
            {g.rows.map((r) => (
              <div class:list={['nc__row', g.tall && 'nc__row--tall']} role="row">
                <div class="nc__label" role="cell"><p class="nitro-xl">{r[0]}</p></div>
                {[r[1], r[2]].map((c, i) => (
                  <div class="nc__cell" role="cell">
                    {typeof c === 'string' ? <span class="nitro-xl">{c}</span>
                      : c ? <svg class="nc__yes" viewBox="0 0 28 28" fill="none" role="img" aria-label="Included"><path d="m6.5 14.5 5 5 10-11.5" stroke={i ? '#ff5ae0' : '#4aa3ff'} stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      : <svg class="nc__no" viewBox="0 0 24 24" fill="none" role="img" aria-label="Not included"><path d="m5.5 5.5 13 13m0-13-13 13" stroke="#e3e4e8" stroke-width="2" stroke-linecap="round" /></svg>}
                  </div>
                ))}
              </div>
            ))}
          </>
        ))}

        <div class="nc__col nc__col--basic" aria-hidden="true"><div></div></div>
        <div class="nc__col nc__col--care" aria-hidden="true"><div><i class="nc__pop">POPULAR</i><b class="nc__glowtop"></b></div></div>
      </div>
    </div>
  </div>
</section>

<style>
  .nc { position: relative; padding-bottom: 226px; --col: 251px; }
  .nc__title { margin-bottom: 0 !important; }
  .nc .nitro-wrap :global(.nc__cloud) { top: -246px; right: -50px; width: 250px; height: 250px; }
  .nc .nitro-wrap :global(.nc__disks) { top: -25px; left: -26px; width: 250px; height: 250px; }
  .nc__table { position: relative; margin-top: 231px; }
  .nc__head, .nc__row, .nc__group { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) var(--col) var(--col); column-gap: var(--spacing-16); }
  .nc__head { align-items: end; padding-bottom: 19px; }
  .nc__features { font-family: var(--font-abc-ginto-discord-nord); font-weight: var(--font-weight-bold); font-style: italic; font-size: 24px; line-height: 28px; letter-spacing: 0.24px; text-transform: uppercase; margin-bottom: 23px; }
  .nc__features { grid-column: 1; }
  .nc__plan { grid-column: 2; display: flex; flex-direction: column; align-items: center; }
  .nc__plan--care { grid-column: 3; }
  .nc__plan--care { position: relative; top: 1px; z-index: 3; }
  .nc__name { font-family: var(--font-abc-ginto-discord-nord); font-weight: var(--font-weight-bold); font-style: italic; font-size: 32px; line-height: 32px; letter-spacing: normal; text-transform: uppercase; text-align: center; margin: 0 0 30px; }
  .nc__name span { display: block; font-size: 14px; line-height: 18.2px; }
  .nc__plan :global(.nc__btn) { padding: 13.5px 20.5px; line-height: 16px; }
  .nc__group { margin-left: -37px; padding: var(--spacing-8) 0 var(--spacing-8) 37px; min-height: 111px; align-items: center; overflow: clip; border-radius: 20px 0 0 20px; border: 1px solid rgba(255, 255, 255, 0.6); border-right: 0;
    background: linear-gradient(90deg, #5a2a7c 0%, #2c1a5c 14%, #100c38 30%, rgba(8, 6, 30, 0) 48%); }
  .nc__grouptitle { display: flex; flex-direction: column; gap: var(--spacing-4); }
  .nc__terms { font-size: var(--text-body); line-height: 21px; color: var(--color-white); }
  .nc__row { border-bottom: 1px solid rgba(255, 255, 255, 0.15); }
  .nc__label { display: flex; flex-direction: column; align-items: flex-start; padding: var(--spacing-48) 0; }
  .nc__row--tall .nc__label { padding: var(--spacing-56) 0 var(--spacing-48); }
  .nc__cell { display: flex; align-items: center; justify-content: center; }
  .nc__row--tall .nc__cell { padding-top: var(--spacing-10); }
  .nc__yes { width: 28px; height: 28px; }
  .nc__no { width: 24px; height: 24px; }
  .nc__col { position: absolute; z-index: 0; top: -65.6px; bottom: -66.4px; width: var(--col); padding: 1px; border-radius: 40px; pointer-events: none; }
  .nc__col > div { position: relative; width: 100%; height: 100%; border-radius: 39px; }
  .nc__col--basic { right: calc(var(--col) + var(--spacing-16)); background: linear-gradient(180deg, rgba(255, 255, 255, 0.25) 20%, rgba(255, 255, 255, 0.15)); }
  .nc__col--basic > div { background: linear-gradient(180deg, #131314 0%, #0d0d0e 50%, #080808 100%); }
  .nc__col--care { right: 0; background: linear-gradient(180deg, #5969f4 2%, #68bdff 36%, #e0e4ff 100%); }
  .nc__col--care > div { background: #000 linear-gradient(180deg, rgba(255, 112, 249, 0.2), rgba(156, 89, 233, 0.2) 49%, rgba(52, 66, 217, 0.2)); }
  .nc__glowtop { position: absolute; inset: 0 0 auto 0; height: 395px; border-radius: 39px 39px 0 0; background: linear-gradient(180deg, rgba(196, 104, 214, 0.9) 0%, rgba(150, 84, 214, 0.75) 30%, rgba(74, 70, 205, 0.5) 58%, rgba(52, 40, 120, 0) 100%); }
  .nc__pop { position: absolute; z-index: 1; top: -15px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; justify-content: center; width: 82px; height: 33.75px; border-radius: 10px; font-family: var(--font-abc-ginto-discord); font-style: normal; font-size: 12px; line-height: 12px; font-weight: var(--font-weight-medium); letter-spacing: 0.24px; color: var(--color-white);
    background: linear-gradient(86deg, rgba(255, 255, 255, 0.2) 11%, rgba(255, 255, 255, 0.04)), rgba(120, 90, 150, 0.9); backdrop-filter: blur(120px); -webkit-backdrop-filter: blur(120px); }
  @media (max-width: 1439px) {
    .nc { padding-bottom: 200px; --col: 200px; }
    .nc .nitro-wrap :global(.nc__cloud) { top: -167px; right: -56px; width: 212px; height: 212px; }
    .nc .nitro-wrap :global(.nc__disks) { top: 204px; left: -17px; width: 212px; height: 212px; }
    .nc__table { margin-top: 227px; }
    .nc__head { padding-bottom: 32px; min-height: 242px; }
    .nc__plan { align-self: start; }
    .nc__features { line-height: 31.2px; letter-spacing: normal; margin-bottom: 0; }
    .nc__group { min-height: 90px; }
  }
  @media (max-width: 991px) {
    .nc { --col: 192px; }
    .nc .nitro-wrap :global(.nc__cloud) { top: -191px; right: -56px; width: 180px; height: 180px; }
    .nc .nitro-wrap :global(.nc__disks) { top: 159px; left: -17px; width: 180px; height: 180px; }
  }
  @media (max-width: 479px) {
    .nc { padding-bottom: 86px; --col: 108px; }
    .nc .nitro-wrap :global(.nc__cloud) { display: none; }
    .nc .nitro-wrap :global(.nc__disks) { top: 66px; left: -16px; width: 127px; height: 127px; }
    .nc__table { margin-top: 124px; }
    .nc__head, .nc__row, .nc__group { column-gap: var(--spacing-4); }
    .nc__head { min-height: 208px; padding-bottom: 0; }
    .nc__features { position: absolute; top: 168px; font-size: 16px; line-height: 20px; }
    .nc__name { font-size: 18px; line-height: 19.5px; margin-bottom: 52px; }
    .nc__name span { font-size: 9px; line-height: 12px; }
    .nc__plan :global(.nc__btn) { height: 42px; padding: 0 var(--spacing-8); border-radius: var(--radius-lg); font-size: 15px; }
    .nc__group { margin-left: -11px; padding: var(--spacing-16) 0 var(--spacing-16) 11px; min-height: 0; }
    .nc__terms { font-size: 14px; line-height: 18px; margin-top: var(--spacing-8); }
    .nc__row { padding: var(--spacing-20) 0; }
    .nc__label, .nc__row--tall .nc__label { padding: 0; }
    .nc__row--tall .nc__cell { padding-top: 0; }
    .nc__col { top: -29px; bottom: -36px; border-radius: 25px; }
    .nc__col > div, .nc__glowtop { border-radius: 24px; }
    .nc__col--basic { right: calc(var(--col) + var(--spacing-4)); }
    .nc__pop { top: -12px; width: 72px; height: 27px; border-radius: 8px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  // IX2 a-797 "Nitro-scroll-windy": progress of the h2 through the viewport, 0 -> 100%: cloud y 0 -> 180, disks y 0 -> -200
  const root = document.querySelector<HTMLElement>('[data-section="nitro-compare"]');
  if (root) {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference) and (min-width: 768px)', () => {
      gsap.timeline({ defaults: { ease: 'none', duration: 1 }, scrollTrigger: { trigger: root.querySelector('[data-par-trigger="plan"]'), start: 'top bottom', end: 'bottom top', scrub: 0.6 } })
        .to(root.querySelector('[data-par="windy"]'), { y: 180 }, 0)
        .to(root.querySelector('[data-par="battery"]'), { y: -200 }, 0);
    });
  }
</script>
