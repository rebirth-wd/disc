---
import { Image } from 'astro:assets';
import NitroDemo from './NitroDemo.astro';
import p1 from '../../assets/photos/nitro-code-neon.jpg';
import p2 from '../../assets/photos/nitro-laptop-glow.jpg';
import p3 from '../../assets/photos/nitro-servers-green.jpg';
import p4 from '../../assets/photos/nitro-setup-rgb.jpg';
import p5 from '../../assets/photos/nitro-keyboard-violet.jpg';
import p6 from '../../assets/photos/nitro-fans-datacenter.jpg';
import p7 from '../../assets/photos/nitro-rack-green.jpg';
import p8 from '../../assets/photos/nitro-studio-desk.jpg';
import p9 from '../../assets/photos/nitro-laptop-magenta.jpg';
const tiles = [p1, p2, p3, p4, p5, p6, p7, p8, p9];
const points = [
  'Trained on your services, pricing, suburbs and FAQs',
  'Answers visitor questions after hours',
  'Guides every visitor to the right page',
  'Works from your information, not the internet’s',
];
const cards = [
  { kind: 'repairs', title: 'Site repairs', text: 'Your site monitors and repairs itself, with scanning, patching and uptime alerts.' },
  { kind: 'faster', title: 'Faster pages', text: 'Audited against Google’s own metrics, with the fixes applied, not just reported.' },
] as const;
---
<section data-section="nitro-whatsnew" class="nw">
  <div class="nitro-pad">
    <div class="nitro-wrap">
      <h2 class="nitro-h2">What’s new</h2>
      <div class="nw__grid">
        <div class="nw__banner">
          <div class="nw__collage" aria-hidden="true">
            <div class="nw__tiles">
              {tiles.map((t) => <Image src={t} alt="" width={420} height={520} class="nw__tile" loading="lazy" />)}
            </div>
          </div>
          <div class="nw__body">
            <div class="nw__logo">
              <svg viewBox="0 0 72 72" fill="none" aria-hidden="true"><circle cx="36" cy="36" r="36" fill="#fff" /><rect x="17" y="22" width="38" height="28" rx="11" fill="#012a20" /><rect x="26" y="30" width="6" height="12" rx="3" fill="#57f287" /><rect x="40" y="30" width="6" height="12" rx="3" fill="#57f287" /><path d="M36 22v-8" stroke="#012a20" stroke-width="4" stroke-linecap="round" /><circle cx="36" cy="12" r="4" fill="#012a20" /></svg>
              <span>AI Site Assistant</span>
            </div>
            {points.map((t, i) => (
              <div class:list={['nitro-check', i === points.length - 1 && 'nitro-check--last']}>
                <svg viewBox="0 0 24 25" fill="none" aria-hidden="true"><path d="m5.5 13 4.2 4.2L18.5 8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="nitro-xl">{t}</span>
              </div>
            ))}
            <a href="#faq" class="nw__terms">Terms and eligibility rules apply.</a>
          </div>
        </div>
        {cards.map((c) => (
          <article class="nw__card">
            <div class="nw__media"><NitroDemo kind={c.kind} /></div>
            <div class="nw__text">
              <h3 class="nitro-h3">{c.title}</h3>
              <p class="nitro-xl">{c.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .nw { position: relative; padding-bottom: 160px; }
  .nw .nitro-h2 { margin-bottom: 72px; }
  .nw__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-20); }
  .nw__banner { grid-column: 1 / -1; position: relative; overflow: clip; border-radius: 96px; padding: 190px 120px; background: #012a20; }
  .nw__collage { position: absolute; inset: 0; pointer-events: none; }
  .nw__tiles { position: absolute; top: 50%; right: -150px; width: 860px; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-24); transform: translateY(-50%) rotate(-14deg); }
  .nw__tiles :global(.nw__tile) { width: 100%; height: 330px; object-fit: cover; border-radius: 6px; }
  .nw__collage::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #012a20 0%, #012a20 34%, rgba(1, 42, 32, 0.78) 52%, rgba(1, 42, 32, 0.25) 72%, rgba(1, 42, 32, 0) 88%), linear-gradient(180deg, rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0) 70%, rgba(0, 0, 0, 0.35)); }
  .nw__body { position: relative; display: flex; flex-direction: column; align-items: flex-start; max-width: 576px; }
  .nw__logo { display: flex; align-items: center; gap: 14px; height: 71.6px; margin-bottom: var(--spacing-36); font-family: var(--font-abc-ginto-discord); font-weight: var(--font-weight-medium); font-size: 50px; line-height: 1; letter-spacing: -0.03em; text-transform: uppercase; white-space: nowrap; }
  .nw__logo svg { width: 72px; height: 72px; flex: none; }
  .nw__terms { margin-top: var(--spacing-40); font-size: var(--text-body); line-height: 24px; color: var(--color-white); text-decoration: underline; }
  .nw__card { background: #1a1a1e; border-radius: 96px; padding: 32px 32px var(--spacing-56); box-shadow: 0 2px 32px 0 rgba(69, 42, 124, 0.1); }
  .nw__media { position: relative; z-index: 1; aspect-ratio: 526 / 459.375; border-radius: 96px; overflow: hidden; margin-bottom: var(--spacing-24); }
  .nw__text { display: flex; flex-direction: column; gap: var(--spacing-8); padding: 0 var(--spacing-24); }
  .nw__text .nitro-h3 { white-space: nowrap; }
  @media (max-width: 1439px) {
    .nw { padding-bottom: 120px; }
    .nw .nitro-h2 { margin-bottom: 60px; }
    .nw__banner { border-radius: 56px; padding: 162px 64px; }
    .nw__tiles { right: -260px; }
    .nw__logo { font-size: 46px; height: 56px; }
    .nw__logo svg { width: 56px; height: 56px; }
    .nw__card { border-radius: 56px; padding: var(--spacing-24) var(--spacing-24) var(--spacing-40); }
    .nw__media { border-radius: 56px; }
    .nw__text { padding: 0 var(--spacing-16); }
    .nw__text .nitro-h3 { white-space: normal; }
  }
  @media (max-width: 991px) {
    .nw__banner { padding: 162px var(--spacing-56); }
    .nw__tiles { right: -420px; opacity: 0.8; }
  }
  @media (max-width: 479px) {
    .nw { padding-bottom: 100px; }
    .nw .nitro-h2 { margin-bottom: var(--spacing-56); }
    .nw__grid { grid-template-columns: 1fr; gap: var(--spacing-16); }
    .nw__banner { border-radius: 40px; padding: 190px var(--spacing-24) var(--spacing-24); }
    .nw__tiles { top: 60px; right: -180px; width: 560px; gap: var(--spacing-12); }
    .nw__tiles :global(.nw__tile) { height: 200px; }
    .nw__collage::after { background: linear-gradient(180deg, rgba(1, 42, 32, 0) 0%, rgba(1, 42, 32, 0.55) 22%, #012a20 40%); }
    .nw__logo { font-size: 26px; height: 37px; gap: var(--spacing-8); margin-bottom: var(--spacing-24); }
    .nw__logo svg { width: 36px; height: 36px; }
    .nw__terms { margin-top: var(--spacing-24); }
    .nw__card { border-radius: 40px; padding: var(--spacing-16) var(--spacing-16) var(--spacing-24); }
    .nw__media { border-radius: 40px; }
    .nw__text { padding: 0 var(--spacing-8); text-align: center; }
  }
</style>
