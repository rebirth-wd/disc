---
import Button from '../global/Button.astro';
import NitroObject from './NitroObject.astro';
---
<section data-section="nitro-hero" data-nav-trigger class="nh">
  <div class="nitro-pad">
    <div class="nitro-wrap">
      <div class="nh__block" data-par-trigger="hero">
        <NitroObject name="shield" par="bolt" class="nh__shield" />
        <h1 class="nitro-h1 nh__title"><span>Your site,</span> <span>looked after</span> <span>every month</span></h1>
        <p class="nitro-xl nh__lead">Tired of chasing updates, backups and patches? We get it. Join a care plan, and we manage the lot for you, every month.</p>
        <Button variant="white" href="#plans" class="nitro-btn nitro-btn--slow nh__cta">Start now</Button>
        <NitroObject name="bot" par="astro" class="nh__bot" />
      </div>
    </div>
  </div>
  <div class="nh__bg" aria-hidden="true"></div>
</section>

<style>
  .nh { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; padding: 240px 0 120px; text-align: center; }
  .nh > .nitro-pad { width: 100%; }
  .nh__bg {
    position: absolute; inset: 0 0 auto 0; height: 1500px; z-index: -1; pointer-events: none;
    background:
      radial-gradient(ellipse 46% 30% at 50% 0%, #d94fd8 0%, rgba(205, 84, 222, 0.75) 38%, rgba(160, 84, 220, 0) 100%),
      linear-gradient(180deg, #7550c8 0%, #6a45c2 14%, #4c2c98 30%, #2c1767 44%, #120a35 58%, #05030f 70%, #000 80%);
  }
  .nh__block { position: relative; max-width: 788px; margin-inline: auto; display: flex; flex-direction: column; align-items: center; }
  .nh__title { position: relative; z-index: 1; width: 100%; }
  .nh__title span { display: block; white-space: nowrap; }
  .nh__lead { max-width: 760px; margin-bottom: 44px !important; }
  .nh__block :global(.nh__cta) { min-width: 121px; }
  .nh__block :global(.nh__shield) { top: -82px; left: -258px; width: 250px; height: 250px; z-index: 0; }
  .nh__block :global(.nh__bot) { top: 123px; left: 774px; width: 289px; height: 321px; }
  @media (max-width: 1439px) {
    .nh { padding: 200px 0 100px; }
    .nh__block { max-width: 620px; }
    .nh__title { margin-bottom: var(--spacing-20) !important; }
    .nh__lead { margin-bottom: var(--spacing-36) !important; }
    .nh__block :global(.nh__shield) { top: -77px; left: -252px; width: 200px; height: 200px; }
    .nh__block :global(.nh__bot) { top: 187px; left: 621px; width: 208px; height: 208px; }
  }
  @media (max-width: 991px) {
    .nh { padding: 180px 0 100px; }
    .nh__block :global(.nh__shield) { top: -103px; left: -99px; width: 156px; height: 156px; }
    .nh__block :global(.nh__bot) { top: 232px; left: 502px; width: 168px; height: 168px; }
  }
  @media (max-width: 767px) {
    .nh__title span { white-space: normal; }
  }
  @media (max-width: 479px) {
    .nh { padding: 128px 0 100px; }
    .nh__title { margin-bottom: 16px !important; }
    .nh__lead { margin-bottom: 32px !important; }
    .nh__block :global(.nh__shield) { display: none; }
    .nh__block :global(.nh__bot) { position: relative; top: auto; left: auto; width: 279px; height: 279px; margin: 13px 0 -200px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  // IX2 a-792 "Nitro-hero-animation": scroll progress of the hero block, start offset 30%, 56% -> 100%: shield y 0->160, bot y 0->140, smoothing 75
  const root = document.querySelector<HTMLElement>('[data-section="nitro-hero"]');
  if (root) {
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference) and (min-width: 768px)', () => {
      const block = root.querySelector('[data-par-trigger="hero"]');
      const tl = gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: block, start: 'top 70%', end: 'bottom top', scrub: 0.6 } });
      tl.to({}, { duration: 0.56 })
        .to(root.querySelector('[data-par="bolt"]'), { y: 160, duration: 0.44 }, 0.56)
        .to(root.querySelector('[data-par="astro"]'), { y: 140, duration: 0.44 }, 0.56);
    });
  }
</script>
