---
// Shared (page-scoped) styles for the /nitro "Care Plans" page.
// The style docs sampled the home page only; this page's own canvas (black), italic display
// headings, 48px compact buttons, hairline borders and card radii are measured reference values.
---

<style is:global>
  .nitro-page {
    position: relative;
    background: var(--color-black);
    color: var(--color-white);
    overflow: clip;
    --nitro-pad: 120px;
    --nitro-wrap: 1200px;
    --nitro-wrap-wide: 1538px;
    --nitro-fog: var(--color-fog);
  }
  @media (max-width: 1439px) {
    .nitro-page {
      --nitro-pad: 80px;
      --nitro-wrap: 944px;
      --nitro-wrap-wide: 944px;
    }
  }
  @media (max-width: 991px) {
    .nitro-page {
      --nitro-pad: 40px;
    }
  }
  @media (max-width: 479px) {
    .nitro-page {
      --nitro-pad: 6vw;
    }
  }

  .nitro-page .nitro-pad {
    padding-inline: var(--nitro-pad);
  }
  .nitro-page .nitro-wrap {
    position: relative;
    width: 100%;
    max-width: var(--nitro-wrap);
    margin-inline: auto;
  }
  .nitro-page .nitro-wrap--wide {
    max-width: var(--nitro-wrap-wide);
    z-index: 2;
  }

  /* Display type: Nord face, 700, synthesised italic, uppercase (measured on this page) */
  .nitro-page .nitro-h1,
  .nitro-page .nitro-h2,
  .nitro-page .nitro-h3,
  .nitro-page .nitro-h4 {
    font-family: var(--font-abc-ginto-discord-nord);
    font-weight: var(--font-weight-bold);
    font-style: italic;
    text-transform: uppercase;
    color: var(--color-white);
    margin: 0;
  }
  .nitro-page .nitro-h1 {
    font-size: 72px;
    line-height: 64.8px;
    letter-spacing: -2.16px;
    margin-bottom: var(--spacing-24);
  }
  .nitro-page .nitro-h2 {
    font-size: var(--text-heading-lg);
    line-height: 48px;
    letter-spacing: var(--tracking-heading-lg);
    margin-bottom: var(--spacing-24);
    text-align: center;
  }
  .nitro-page .nitro-h3 {
    font-size: var(--text-heading);
    line-height: 36px;
    letter-spacing: var(--tracking-heading);
    margin-bottom: var(--spacing-16);
  }
  .nitro-page .nitro-h4 {
    font-size: 28px;
    line-height: 28px;
    letter-spacing: -0.28px;
  }
  .nitro-page .nitro-xl {
    font-family: var(--font-abc-ginto-discord);
    font-size: var(--text-body-xl);
    line-height: 26px;
    font-weight: var(--font-weight-regular);
    margin: 0;
  }
  .nitro-page .nitro-xl--medium {
    font-weight: var(--font-weight-medium);
  }
  @media (max-width: 1439px) {
    .nitro-page .nitro-h1 {
      font-size: var(--text-display);
      line-height: 56px;
      letter-spacing: -1.68px;
    }
    .nitro-page .nitro-h2 {
      font-size: 40px;
      line-height: 40px;
      letter-spacing: -0.4px;
    }
    .nitro-page .nitro-h3 {
      font-size: 32px;
      line-height: 32px;
      letter-spacing: -0.32px;
    }
    .nitro-page .nitro-h4 {
      font-size: 26px;
      line-height: 26px;
      letter-spacing: -0.26px;
    }
  }
  @media (max-width: 479px) {
    .nitro-page .nitro-h1 {
      font-size: 9.75vw;
      line-height: 9.75vw;
      letter-spacing: -0.03em;
    }
    .nitro-page .nitro-h2 {
      font-size: 8.2vw;
      line-height: 8.2vw;
      letter-spacing: -0.01em;
    }
    .nitro-page .nitro-h3 {
      font-size: 24px;
      line-height: 26px;
      letter-spacing: -0.24px;
    }
    .nitro-page .nitro-h4 {
      font-size: 3.8vw;
      line-height: 1.25;
      letter-spacing: 0;
    }
    .nitro-page .nitro-xl {
      font-size: var(--text-body);
      line-height: 22px;
    }
  }

  /* Compact 48px buttons used on this page (shared Button primitive, re-sized to measured values) */
  .nitro-page .rb-btn.nitro-btn {
    height: 48px;
    padding: 13px var(--spacing-24);
    border-radius: var(--radius-buttons);
    font-size: var(--text-body);
    line-height: 21px;
    font-weight: var(--font-weight-medium);
    letter-spacing: normal;
    color: var(--color-black);
    background-color: var(--color-white);
    transition:
      background-color 0.2s,
      color 0.2s,
      box-shadow 0.2s;
    z-index: 1;
  }
  .nitro-page .rb-btn.nitro-btn--slow {
    transition: background-color 0.4s;
  }
  .nitro-page .rb-btn.nitro-btn--full {
    display: flex;
    width: 100%;
  }
  .nitro-page .rb-btn.nitro-btn--ghost {
    background-color: var(--color-white-10);
    color: var(--color-white);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  @media (hover: hover) {
    .nitro-page .rb-btn.nitro-btn:hover {
      background-color: var(--color-fog);
      color: var(--color-black);
    }
    .nitro-page .rb-btn.nitro-btn--lift:hover {
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
    }
  }
  @media (max-width: 479px) {
    .nitro-page .rb-btn.nitro-btn--slow {
      font-size: 14px;
      line-height: 18px;
    }
  }

  /* Check-list rows */
  .nitro-page .nitro-check {
    position: relative;
    display: flex;
    align-items: flex-start;
    margin: 0 0 var(--spacing-20);
  }
  .nitro-page .nitro-check--last {
    margin-bottom: 0;
  }
  .nitro-page .nitro-check > svg {
    flex: none;
    width: 24px;
    height: 25px;
    margin: 0.5px var(--spacing-16) 0.5px 0;
    position: relative;
    z-index: 1;
  }
  .nitro-page .nitro-check > span {
    position: relative;
    z-index: 1;
  }

  /* Underlined inline link (reference draws the underline with a 1px inset line) */
  .nitro-page .nitro-link {
    color: inherit;
    text-decoration: none;
    box-shadow: 0 1px 0 0 var(--color-fog);
    transition:
      opacity 0.25s,
      box-shadow 0.25s;
  }
  @media (hover: hover) {
    .nitro-page .nitro-link:hover {
      opacity: 0.75;
      box-shadow: 0 0 0 0 transparent;
    }
  }

  /* Floating decor objects */
  .nitro-page .nitro-obj {
    position: absolute;
    pointer-events: none;
    will-change: transform;
  }
  .nitro-page .nitro-obj svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
