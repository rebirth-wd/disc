---
import Button from '../global/Button.astro';
import NitroObject from './NitroObject.astro';
const basic = ['Managed edge hosting', 'Daily backups', 'Security patches'];
const care = ['AI Site Assistant*', 'AI performance tuning', 'Uptime alerts', 'Monthly content edits', 'AI lead scoring and more!'];
---
<section data-section="nitro-plans" id="plans" class="np">
  <div class="nitro-pad">
    <div class="nitro-wrap">
      <div class="np__grid">
        <article class="np__card np__card--basic" data-plan="basic">
          <h2 class="nitro-h3">Care Basic</h2>
          <p class="nitro-xl">Keep your site online with some of our most-needed monthly essentials.</p>
          <div class="np__gap"></div>
          <Button variant="white" href="#compare" class="nitro-btn nitro-btn--ghost nitro-btn--full nitro-btn--lift" data-btn="ghost">Get Care Basic</Button>
          <div class="np__gap"></div>
          <div class="np__rule"></div>
          <div class="np__gap"></div>
          {basic.map((t, i) => (
            <div class:list={['nitro-check', i === basic.length - 1 && 'nitro-check--last']}>
              <svg viewBox="0 0 24 25" fill="none" aria-hidden="true"><path d="m5.5 13 4.2 4.2L18.5 8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span class="nitro-xl">{t}</span>
            </div>
          ))}
        </article>

        <div class="np__edge">
          <article class="np__card np__card--care" data-plan="care" data-par-trigger="apple">
            <h2 class="nitro-h3">Care</h2>
            <p class="nitro-xl">All the cover, all the AI. The best way to keep your whole site moving.</p>
            <div class="np__gap"></div>
            <Button variant="white" href="#compare" class="nitro-btn nitro-btn--full nitro-btn--lift" data-btn="white">Get Care</Button>
            <div class="np__gap"></div>
            <div class="np__rule"></div>
            <div class="np__gap"></div>
            <p class="nitro-xl nitro-xl--medium">Everything in Basic, plus</p>
            <div class="np__gap"></div>
            {care.map((t, i) => (
              <div class:list={['nitro-check', i === 0 && 'np__hot', i === care.length - 1 && 'nitro-check--last']}>
                <svg viewBox="0 0 24 25" fill="none" aria-hidden="true"><path d="m5.5 13 4.2 4.2L18.5 8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span class="nitro-xl">{t}</span>
                {i === 0 && <i class="np__glow"></i>}
              </div>
            ))}
            <div class="np__gap np__gap--40"></div>
            <p class="np__note" data-terms>*Available on new builds. <a href="#faq" class="nitro-link">Terms and eligibility rules apply.</a></p>
          </article>
        </div>

        <NitroObject name="cog" par="apple" class="np__cog" />
      </div>
    </div>
  </div>
</section>

<style>
  .np { position: relative; z-index: 1; padding-bottom: 200px; }
  .np__grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-20); align-items: stretch; }
  .np__card { display: flex; flex-direction: column; align-items: flex-start; padding: var(--spacing-56); border-radius: 56px; backdrop-filter: blur(120px); -webkit-backdrop-filter: blur(120px); }
  .np__card--basic { background: var(--color-white-10); }
  .np__edge { padding: 1px; border-radius: 56px; background: linear-gradient(180deg, #5969f4 2%, #68bdff 36%, #e0e4ff 100%); display: flex; }
  .np__card--care { flex: 1; overflow: clip; background: #000 linear-gradient(180deg, #4d2466 0%, #36185a 28%, #1c0e4a 60%, #090840 100%); }
  .np__gap { height: 44px; flex: none; }
  .np__gap--40 { height: var(--spacing-40); }
  .np__rule { width: 100%; height: 1px; background: var(--color-white-10); flex: none; }
  .np__hot { min-height: 27px; }
  .np__glow { position: absolute; inset: 0; margin: -10px -16px; border-radius: 24px; background: #002920; z-index: 0; box-shadow: 0 0 80px 0 rgba(53, 237, 126, 0.3), 0 0 23px 0 rgba(53, 237, 126, 0.7); }
  .np__note { margin: 0; font-size: var(--text-body); line-height: 21px; color: var(--color-fog); }
  .np__grid :global(.np__cog) { right: -31px; bottom: -108px; width: 191px; height: 191px; z-index: 2; }
  @media (max-width: 1439px) {
    .np { padding-bottom: var(--spacing-144); }
    .np__card { padding: var(--spacing-48); border-radius: 48px; }
    .np__edge { border-radius: 48px; }
    .np__grid :global(.np__cog) { right: -9px; bottom: -76px; width: 150px; height: 150px; }
  }
  @media (max-width: 991px) {
    .np__grid { grid-template-columns: 1fr; }
    .np__grid :global(.np__cog) { right: -9px; bottom: -12px; width: 180px; height: 180px; }
  }
  @media (max-width: 479px) {
    .np { padding-bottom: 130px; }
    .np__card { padding: var(--spacing-40); border-radius: 40px; }
    .np__edge { border-radius: 40px; order: -1; }
    .np__gap { height: var(--spacing-36); }
    .np__grid :global(.np__cog) { right: -25px; bottom: -49px; width: 125px; height: 125px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  // IX2 a-793 "nitro-paralax-apple": progress of the premium card through the viewport, 55% -> 100%: y 0 -> 120
  const root = document.querySelector<HTMLElement>('[data-section="nitro-plans"]');
  if (root) {
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference) and (min-width: 768px)', () => {
      gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: root.querySelector('[data-par-trigger="apple"]'), start: 'top+=200 bottom', end: 'bottom top', scrub: 0.6 } })
        .to({}, { duration: 0.55 })
        .to(root.querySelector('[data-par="apple"]'), { y: 120, duration: 0.45 }, 0.55);
    });
  }
</script>
