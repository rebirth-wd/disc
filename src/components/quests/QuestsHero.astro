---
// Hero (reference: section.advertising-hero.is-ovr). Slides up under header + subnav.
import Starfield from '../global/Starfield.astro';
import QuestsButton from './QuestsButton.astro';
import QuestsObject from './QuestsObject.astro';
const cards = [
  { x: 9, y: 16, w: 250, h: 300, r: -12 }, { x: 27, y: 6, w: 210, h: 120, r: -12 },
  { x: 30, y: 30, w: 200, h: 230, r: -12 }, { x: 52, y: 14, w: 230, h: 150, r: -12 },
  { x: 76, y: 12, w: 300, h: 150, r: -12 }, { x: 68, y: 46, w: 240, h: 260, r: -12 },
  { x: 20, y: 62, w: 260, h: 170, r: -12 }, { x: 44, y: 62, w: 230, h: 200, r: -12 },
  { x: 88, y: 50, w: 200, h: 220, r: -12 },
];
---
<section data-section="quests-hero" data-nav-trigger class="q-hero">
  <div class="q-hero__bg" aria-hidden="true">
    <div class="q-hero__cards">
      {cards.map((c) => (
        <div class="q-hero__card" style={`left:${c.x}%;top:${c.y}%;width:${c.w}px;height:${c.h}px;transform:rotate(${c.r}deg)`}>
          <i></i><u style="width:62%"></u><u style="width:84%"></u><u style="width:46%"></u><b></b>
        </div>
      ))}
    </div>
    <!-- orchestrator QA: generic Starfield removed; the reference hero has no star layer -->
    <div class="q-hero__fade"></div>
  </div>
  <div class="q-hero__pad">
    <div class="q-hero__inner">
      <h1 class="q-hero__h1">Launch your site <span>on the modern web</span></h1>
      <p class="q-hero__p">Rebirth builds fast, secure, static-first websites on a production-grade web stack.</p>
      <div class="q-hero__cta">
        <QuestsObject name="rocket" class="q-hero__obj" data-float />
        <div class="q-hero__btn"><QuestsButton variant="blurple" href="#quests-cta" glow>Get Started</QuestsButton></div>
      </div>
    </div>
  </div>
</section>

<style>
  .q-hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: -140px;
    padding: 168px 0 84px;
  }
  .q-hero__bg { position: absolute; inset: 0; z-index: -1; overflow: hidden;
    background: linear-gradient(180deg, #4751c5 0%, #3f4ab4 13%, #373f9a 30%, #2a2f8e 62%, var(--q-canvas) 100%); }
  .q-hero__cards { position: absolute; inset: 0; filter: blur(3px); opacity: 0.55; }
  .q-hero__card { position: absolute; border-radius: 18px; background: rgba(255, 255, 255, 0.09); padding: 18px; box-sizing: border-box; display: flex; flex-direction: column; gap: 10px; }
  .q-hero__card i { display: block; height: 42%; border-radius: 10px; background: linear-gradient(135deg, rgba(235, 69, 158, 0.45), rgba(88, 101, 242, 0.5)); }
  .q-hero__card u { display: block; height: 9px; border-radius: 5px; background: rgba(255, 255, 255, 0.22); }
  .q-hero__card b { display: block; margin-top: auto; height: 26px; border-radius: 8px; background: rgba(88, 101, 242, 0.7); }
  .q-hero__fade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(71, 81, 197, 0.35) 0%, rgba(55, 63, 154, 0.2) 35%, var(--q-canvas) 96%); }
  .q-hero__pad { width: 100%; box-sizing: border-box; padding: 0 24px; }
  .q-hero__inner { display: flex; flex-direction: column; align-items: center; max-width: 600px; margin: 0 auto; }
  .q-hero__h1 {
    margin: 0 0 16px;
    max-width: 576px;
    text-align: center;
    color: var(--color-white);
    font-family: var(--font-abc-ginto-discord-nord);
    font-weight: var(--font-weight-bold);
    font-size: 9.75vw;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .q-hero__p { margin: 0; text-align: center; font-size: var(--text-body); line-height: 22px; color: var(--color-white); }
  .q-hero__cta { position: relative; display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 720px; }
  .q-hero__btn { margin-top: 36px; }
  .q-hero__obj { position: absolute; width: 112px; height: 112px; right: 0; top: 23px; }
  @media (min-width: 480px) {
    .q-hero { margin-top: -80px; padding: 184px 0 128px; }
    .q-hero__pad { padding: 0 var(--spacing-40); }
    .q-hero__h1 { max-width: 800px; margin-bottom: 20px; font-size: var(--text-display); line-height: 56px; }
    .q-hero__p { font-size: var(--text-body-xl); line-height: 26px; }
    .q-hero__obj { width: 150px; height: 150px; right: -74px; top: -12px; }
  }
  @media (min-width: 992px) {
    .q-hero { margin-top: -160px; padding: 240px 0 128px; }
    .q-hero__inner { max-width: 980px; }
    .q-hero__h1 span { display: block; }
    .q-hero__cta { max-width: 896px; }
    .q-hero__obj { right: -50px; }
  }
  @media (min-width: 1440px) {
    .q-hero { margin-top: -152px; padding: 240px 0 195.2px; }
    .q-hero__inner { max-width: 1300px; }
    .q-hero__h1 { max-width: none; margin-bottom: var(--spacing-24); font-size: 72px; line-height: 64.8px; letter-spacing: -2.16px; }
    .q-hero__btn { margin-top: 44px; }
    .q-hero__obj { width: 200px; height: 200px; right: -85px; top: -13px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const mm = gsap.matchMedia();
  // reference IX2 a-925 (desktop only): object y 0 -> 100px across 60% -> 100% of the
  // section's in-view progress, smoothing 80.
  mm.add('(min-width: 992px) and (prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<HTMLElement>('[data-section="quests-hero"]').forEach((root) => {
      const obj = root.querySelector('[data-float]');
      if (!obj) return;
      const tl = gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: 0.8 } });
      tl.to({}, { duration: 60 }).fromTo(obj, { y: 0 }, { y: 100, duration: 40, immediateRender: false });
    });
  });
</script>
