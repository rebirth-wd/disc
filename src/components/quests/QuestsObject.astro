---
// Original floating objects (chunky, angular, flat-shaded) that stand in for the
// reference's 3D props. Pure inline SVG; colours from the token palette.
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'svg'> {
  name: 'rocket' | 'bolt' | 'cube' | 'coin' | 'plane';
  class?: string;
}
const { name, class: cls = '', ...rest } = Astro.props;
const id = `qo-${name}-${Math.random().toString(36).slice(2, 7)}`;
---

<svg
  class:list={['q-object', cls]}
  viewBox="0 0 200 200"
  fill="none"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  <defs>
    <linearGradient id={`${id}-a`} x1="40" y1="20" x2="160" y2="180" gradientUnits="userSpaceOnUse">
      <stop stop-color="#f4f0ff" />
      <stop offset="1" stop-color="#b9b4ff" />
    </linearGradient>
    <linearGradient id={`${id}-b`} x1="60" y1="40" x2="150" y2="170" gradientUnits="userSpaceOnUse">
      <stop stop-color="#7f8bff" />
      <stop offset="1" stop-color="#4450d6" />
    </linearGradient>
    <linearGradient id={`${id}-c`} x1="50" y1="60" x2="150" y2="190" gradientUnits="userSpaceOnUse">
      <stop stop-color="#ff7ad0" />
      <stop offset="1" stop-color="#c23aa0" />
    </linearGradient>
  </defs>
  {name === 'rocket' && (
    <g transform="rotate(24 100 100)">
      <path d="M100 14c26 22 38 52 38 86v34H62v-34c0-34 12-64 38-86Z" fill={`url(#${id}-a)`} />
      <path d="M100 14c26 22 38 52 38 86v34h-38V14Z" fill="#cfc9ff" />
      <path d="M62 104 34 134v26l28-12v-44ZM138 104l28 30v26l-28-12v-44Z" fill={`url(#${id}-b)`} />
      <circle cx="100" cy="82" r="19" fill="#2a2f9c" />
      <circle cx="100" cy="82" r="12" fill={`url(#${id}-b)`} />
      <path d="M94 76h8v5h-8z" fill="#fff" opacity=".8" />
      <path d="M74 134h52l-8 18H82l-8-18Z" fill="#3b43c4" />
      <path d="M84 152h32l-16 38-16-38Z" fill={`url(#${id}-c)`} />
      <path d="M92 152h16l-8 22-8-22Z" fill="#fee75c" />
    </g>
  )}
  {name === 'bolt' && (
    <g transform="rotate(14 100 100)">
      <path
        d="M116 10 40 112h44l-18 78 94-112h-48l22-68h-18Z"
        fill="#3b43c4"
        transform="translate(8 6)"
      />
      <path d="M116 10 40 112h44l-18 78 94-112h-48l22-68h-18Z" fill={`url(#${id}-c)`} />
      <path d="M116 10 40 112h44l8-34 24-68Z" fill="#ff9fe0" opacity=".75" />
      <path d="M22 44h10v10H22zM160 150h8v8h-8z" fill="#fff" />
    </g>
  )}
  {name === 'cube' && (
    <g transform="rotate(-10 100 100)">
      <path d="m100 18 72 36v84l-72 44-72-44V54l72-36Z" fill={`url(#${id}-b)`} />
      <path d="m100 18 72 36-72 40-72-40 72-36Z" fill={`url(#${id}-a)`} />
      <path d="M100 94v88l-72-44V54l72 40Z" fill="#6e7aff" />
      <path
        d="m58 98-16 22 16 14M76 106l-8 34"
        stroke="#fff"
        stroke-width="7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="m128 108 22 4-10 26"
        stroke="#c9ceff"
        stroke-width="7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path d="M92 46h16v10H92z" fill="#ff7ad0" />
    </g>
  )}
  {name === 'coin' && (
    <g transform="rotate(-16 100 100)">
      <ellipse cx="108" cy="104" rx="64" ry="78" fill="#c06ad6" />
      <ellipse cx="96" cy="100" rx="64" ry="78" fill={`url(#${id}-a)`} />
      <ellipse cx="96" cy="100" rx="48" ry="60" fill="#dcd6ff" />
      <path d="m96 58 11 30 30 12-30 12-11 30-11-30-30-12 30-12 11-30Z" fill={`url(#${id}-b)`} />
      <path d="M90 94h12v12H90z" fill="#fff" opacity=".9" />
    </g>
  )}
  {name === 'plane' && (
    <g transform="rotate(8 100 100)">
      <path d="M22 96 182 28l-52 150-34-58-74-24Z" fill={`url(#${id}-b)`} />
      <path d="M182 28 96 120l34 58 52-150Z" fill="#3b43c4" />
      <path d="M182 28 96 120l-20 44 12-56 94-80Z" fill={`url(#${id}-a)`} />
      <path d="m76 164 20-44 14 20-34 24Z" fill={`url(#${id}-c)`} />
      <path d="M30 150h10v10H30zM160 170h7v7h-7z" fill="#57f287" />
    </g>
  )}
</svg>

<style>
  .q-object {
    display: block;
    overflow: visible;
    pointer-events: none;
  }
</style>
