---
// Secondary nav bar (reference: div.subnav.is_quests). Sticky under the header:
// top 0 from 992px up, top 80px below. Desktop shows 4 glass tabs (one with a hover
// dropdown); <=767px collapses into a single dropdown toggle.
const links = [
  { label: 'Your Launch', href: '/ads/quests', current: true },
  {
    label: 'What We Do',
    drop: [
      { label: 'Websites', href: '#' },
      { label: 'AI Tools & Integrations', href: '#' },
    ],
  },
  { label: 'Success Stories', href: '#quests-stories' },
  { label: 'FAQ', href: '#' },
];
const mobile = [
  { label: 'Websites', href: '#' },
  { label: 'AI Tools & Integrations', href: '#' },
  { label: 'Success Stories', href: '#quests-stories' },
  { label: 'FAQ', href: '#' },
];
---

<div data-section="quests-subnav" class="q-subnav">
  <nav class="q-subnav__links" aria-label="Launch pages">
    {links.map((l) =>
      l.drop ? (
        <div class="q-subnav__drop" data-drop>
          <button
            type="button"
            class="q-tab q-tab--toggle"
            data-toggle
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>{l.label}</span>
            <svg
              data-chev
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="m4 6 4 4 4-4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <div class="q-subnav__list" data-droplist hidden>
            <div class="q-subnav__list-wr" data-dropwr>
              {l.drop.map((d) => (
                <a class="q-droplink" data-droplink href={d.href}>
                  {d.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a
          class="q-tab q-tab--desk"
          data-sublink
          href={l.href}
          aria-current={l.current ? 'page' : undefined}
        >
          <span>{l.label}</span>
        </a>
      ),
    )}

    <div class="q-subnav__mob" data-mob>
      <button
        type="button"
        class="q-tab q-tab--mob"
        data-mob-toggle
        aria-expanded="false"
        aria-haspopup="true"
      >
        <span>{links[0].label}</span>
        <svg
          data-mob-chev
          width="12"
          height="12"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="m3 6 5 5 5-5"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <div class="q-subnav__moblist" data-mob-list hidden>
        {mobile.map((d) => (
          <a class="q-tab q-tab--mobitem" href={d.href}>
            <span>{d.label}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>
</div>

<style>
  .q-subnav {
    position: sticky;
    top: 80px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 15px;
  }
  .q-subnav__links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    max-width: 672px;
    margin: 0 auto;
  }
  /* original stand-in for the reference's gradient tile image */
  .q-subnav {
    --q-tab-glow: radial-gradient(
      120% 150% at 50% 118%,
      #8f97ff 0%,
      var(--color-blurple) 42%,
      #4049c0 100%
    );
  }

  .q-tab {
    position: relative;
    display: none;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    border: 0;
    margin: 0;
    cursor: pointer;
    color: var(--color-white);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    font-family: var(--font-abc-ginto-discord-nord);
    font-weight: var(--font-weight-bold);
    background-color: rgba(255, 255, 255, 0.01);
    -webkit-backdrop-filter: blur(30px);
    backdrop-filter: blur(30px);
    border-radius: 6px;
    transition: opacity 0.35s;
    overflow: hidden;
  }
  .q-tab:focus-visible,
  .q-droplink:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }
  .q-tab[aria-current='page'],
  .q-tab--mob {
    background-image: var(--q-tab-glow);
  }
  @media (hover: hover) {
    .q-tab--desk:hover,
    .q-tab--toggle:hover,
    .q-tab--mobitem:hover {
      background-image: var(--q-tab-glow);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* <=767: one dropdown toggle */
  .q-subnav__mob {
    position: relative;
    display: block;
  }
  .q-tab--mob {
    display: flex;
    gap: 8px;
    min-width: 160px;
    padding: 11px 20px;
    font-size: 11px;
    line-height: 17px;
  }
  .q-subnav__moblist {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 100%;
    padding-top: 4px;
  }
  .q-subnav__moblist:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .q-tab--mobitem {
    display: flex;
    padding: 11px 19px;
    font-size: 11px;
    line-height: 15px;
    background-color: #7a7eb4;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  @media (min-width: 480px) {
    .q-tab--mob {
      min-width: 140px;
    }
  }

  /* 768+: four tabs */
  .q-subnav__drop {
    position: relative;
    display: none;
    z-index: 900;
    border-radius: 6px;
  }
  .q-subnav__list {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    padding-top: 4px;
  }
  .q-subnav__list-wr {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 6px;
    border-radius: 11px;
    background-color: var(--color-white-10);
    -webkit-backdrop-filter: blur(50px);
    backdrop-filter: blur(50px);
  }
  .q-droplink {
    display: block;
    padding: 11px 12px;
    border-radius: 6px;
    color: var(--color-white);
    text-decoration: none;
    font-family: var(--font-abc-ginto-discord);
    font-weight: var(--font-weight-medium);
    font-size: 14px;
    line-height: 20px;
    transition: opacity 0.35s;
  }
  @media (hover: hover) {
    .q-droplink:hover {
      background-image: var(--q-tab-glow);
    }
  }

  @media (min-width: 768px) {
    .q-subnav {
      padding-top: 20px;
    }
    .q-subnav__mob {
      display: none;
    }
    .q-subnav__drop {
      display: block;
    }
    .q-tab--desk {
      display: block;
      min-height: 38px;
      padding: 12px 24px;
      font-size: 10px;
      line-height: 17px;
    }
    .q-tab--toggle {
      display: flex;
      gap: 8px;
      min-height: 38px;
      padding: 12px 24px 11px;
      font-size: 11px;
      line-height: 15px;
      overflow: visible;
    }
  }
  @media (min-width: 992px) {
    .q-subnav {
      top: 0;
      padding-top: 15px;
    }
    .q-subnav__links {
      max-width: 608px;
    }
    .q-tab--desk {
      font-size: 11px;
      line-height: 15px;
    }
  }
  @media (min-width: 1280px) {
    .q-subnav__links {
      max-width: 960px;
    }
    .q-tab--desk {
      min-height: 55px;
      padding: 15.5px 32px;
      font-size: 14px;
      line-height: 24px;
    }
    .q-tab--toggle {
      min-height: 55px;
      padding: 15px 32px;
      font-size: 14px;
      line-height: 24px;
    }
    .q-tab--toggle svg {
      height: 25px;
    }
    .q-subnav__list {
      padding-top: 8px;
    }
    .q-droplink {
      padding: 11px 14px;
      font-size: var(--text-body);
      line-height: 24px;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { CustomEase } from 'gsap/CustomEase';
  gsap.registerPlugin(CustomEase);
  // CSS `ease`, the timing function named by the reference interactions
  const cssEase = CustomEase.create('qCssEase', '0.25,0.1,0.25,1');

  document.querySelectorAll<HTMLElement>('[data-section="quests-subnav"]').forEach((root) => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // desktop dropdown: opens on hover (delay 0) / focus / click; chevron 0 -> 180deg, 100ms ease
    const drop = root.querySelector<HTMLElement>('[data-drop]');
    if (drop) {
      const btn = drop.querySelector<HTMLButtonElement>('[data-toggle]')!;
      const list = drop.querySelector<HTMLElement>('[data-droplist]')!;
      const chev = drop.querySelector<SVGElement>('[data-chev]')!;
      let open = false;
      let openedAt = 0;
      const set = (v: boolean) => {
        if (v === open) return;
        open = v;
        if (v) openedAt = performance.now();
        list.hidden = !v;
        btn.setAttribute('aria-expanded', String(v));
        gsap.to(chev, {
          rotation: v ? 180 : 0,
          duration: reduce ? 0 : 0.1,
          ease: cssEase,
          overwrite: true,
        });
      };
      drop.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') set(true);
      });
      drop.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') set(false);
      });
      btn.addEventListener('click', (e) => {
        if ((e as PointerEvent).pointerType !== 'mouse' && performance.now() - openedAt > 300)
          set(!open);
      });
      drop.addEventListener('focusin', () => set(true));
      drop.addEventListener('focusout', (e) => {
        if (!drop.contains(e.relatedTarget as Node)) set(false);
      });
      drop.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          set(false);
          btn.focus();
        }
      });
    }

    // mobile dropdown: click toggles
    const mob = root.querySelector<HTMLElement>('[data-mob]');
    if (mob) {
      const btn = mob.querySelector<HTMLButtonElement>('[data-mob-toggle]')!;
      const list = mob.querySelector<HTMLElement>('[data-mob-list]')!;
      const chev = mob.querySelector<SVGElement>('[data-mob-chev]')!;
      const set = (v: boolean) => {
        list.hidden = !v;
        btn.setAttribute('aria-expanded', String(v));
        gsap.to(chev, {
          rotation: v ? 180 : 0,
          duration: reduce ? 0 : 0.1,
          ease: cssEase,
          overwrite: true,
        });
      };
      btn.addEventListener('click', () => set(list.hidden === true));
      document.addEventListener('click', (e) => {
        if (!mob.contains(e.target as Node)) set(false);
      });
      mob.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          set(false);
          btn.focus();
        }
      });
    }
  });
</script>
