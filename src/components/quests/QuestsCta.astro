---
// Closing CTA banner (reference: div.testimonials-section.is-cta > .banner-gr.is-adv)
import QuestsButton from './QuestsButton.astro';
import QuestsObject from './QuestsObject.astro';
---

<div data-section="quests-cta" id="quests-cta" class="q-cta">
  <div class="q-cta__glow" aria-hidden="true"></div>
  <div class="q-cta__pad">
    <div class="q-cta__wrap">
      <div class="q-cta__banner">
        <QuestsObject name="plane" class="q-cta__plane" data-float="b" />
        <QuestsObject name="coin" class="q-cta__coin" data-float="a" />
        <div class="q-cta__body">
          <h2 class="q-h2 q-cta__h2">Launch your site</h2>
          <p class="q-lead">
            Every Rebirth site is planned directly with the developer who writes the code. If you’re
            ready to start a project, get in touch and we’ll shape the direction together.
          </p>
          <div class="q-cta__btn">
            <QuestsButton variant="white" href="#">
              Get Started
            </QuestsButton>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* <=479px: reference inserts a 56px spacer before the CTA */
  .q-cta {
    position: relative;
    z-index: 1;
    margin-top: 56px;
    padding: 20px 0 120px;
  }
  .q-cta__glow {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 70%;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(88, 101, 242, 0) 0%, rgba(88, 101, 242, 0.14) 100%);
  }
  .q-cta__pad {
    padding: 0 24px;
  }
  .q-cta__wrap {
    position: relative;
    z-index: 2;
    max-width: 944px;
    margin: 0 auto;
  }
  .q-cta__banner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 56px 24px;
    border-radius: 40px;
    background-color: rgb(56, 31, 44);
    background-image:
      radial-gradient(
        90% 120% at 50% 112%,
        #c43fa1 0%,
        #b63b95 22%,
        #97357b 45%,
        rgba(107, 42, 87, 0.6) 72%,
        rgba(84, 36, 66, 0) 100%
      ),
      linear-gradient(180deg, #542442, #6b2a57);
  }
  .q-cta__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 1200px;
  }
  .q-cta__btn {
    margin-top: 36px;
  }
  .q-cta__coin {
    position: absolute;
    left: -4px;
    top: -37px;
    width: 80px;
    height: 80px;
  }
  .q-cta__plane {
    position: absolute;
    right: 16px;
    bottom: -40px;
    width: 96px;
    height: 96px;
    z-index: 0;
  }
  @media (min-width: 480px) {
    .q-cta {
      margin-top: 0;
      padding: 120px 0;
    }
    .q-cta__pad {
      padding: 0 var(--spacing-40);
    }
    .q-cta__banner {
      padding: 100px 48px;
      border-radius: 64px;
    }
    .q-cta__coin {
      left: -8.4px;
      top: -65.8px;
      width: 150px;
      height: 150px;
    }
    .q-cta__plane {
      right: 70px;
      bottom: -43.2px;
      width: 150px;
      height: 150px;
    }
  }
  @media (min-width: 992px) {
    .q-cta__coin {
      left: 12.4px;
    }
  }
  @media (min-width: 1440px) {
    .q-cta {
      padding: 120px 0 160px;
    }
    .q-cta__wrap {
      max-width: 1200px;
    }
    .q-cta__banner {
      padding: 120px 80px;
      border-radius: 72px;
    }
    .q-cta__btn {
      margin-top: 44px;
    }
    .q-cta__coin {
      top: -91.4px;
      width: 192px;
      height: 192px;
    }
    .q-cta__plane {
      right: 90px;
      bottom: -64px;
      width: 200px;
      height: 200px;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const mm = gsap.matchMedia();
  // reference IX2 a-921 (desktop only, smoothing 75), keyed to the section's in-view progress:
  // object A y -40 -> 10 over 0% -> 55%; object B y 0 -> 55 over 22% -> 80%.
  mm.add('(min-width: 992px) and (prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<HTMLElement>('[data-section="quests-cta"]').forEach((root) => {
      const a = root.querySelector('[data-float="a"]');
      const b = root.querySelector('[data-float="b"]');
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: 0.75 },
      });
      tl.fromTo(a, { y: -40 }, { y: 10, duration: 55 }, 0)
        .fromTo(b, { y: 0 }, { y: 55, duration: 58 }, 22)
        .to({}, { duration: 0 }, 100);
    });
  });
</script>
