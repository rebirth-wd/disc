---
// Success-stories carousel (reference: Swiper on .swiper.is-cases — slidesPerView auto,
// spaceBetween -32, centeredSlides, loop, speed 800, autoplay 9000 w/ pauseOnMouseEnter,
// keyboard, grabCursor, slideToClickedSlide, dynamic bullets with a 9s progress bar).
// Re-implemented with GSAP + Draggable. Card copy is Lorem Ipsum by brief.
import { Image } from 'astro:assets';
import glow from '@assets/photos/quests-glow-laptop.jpg';
import macbook from '@assets/photos/quests-macbook.jpg';
import curve from '@assets/photos/quests-violet-curve.jpg';
import pink from '@assets/photos/quests-pink-laptop.jpg';
import pyramid from '@assets/photos/quests-pyramid.jpg';
import room from '@assets/photos/quests-room.jpg';
import tubes from '@assets/photos/quests-tubes.jpg';
import tower from '@assets/photos/quests-tower.jpg';
const slides = [
  {
    img: glow,
    tag: 'Lorem Ipsum',
    text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
  },
  {
    img: room,
    tag: 'Dolor Sit Amet',
    text: 'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
  },
  {
    img: pink,
    tag: 'Consectetur',
    text: 'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur sint.',
  },
  {
    img: pyramid,
    tag: 'Adipiscing Elit',
    text: 'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.',
  },
  {
    img: macbook,
    tag: 'Sed Do Eiusmod',
    text: 'Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium totam.',
  },
  {
    img: tower,
    tag: 'Tempor',
    text: 'Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni.',
  },
  {
    img: curve,
    tag: 'Incididunt',
    text: 'Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet, consectetur, adipisci velit, sed quia non.',
  },
  {
    img: tubes,
    tag: 'Magna Aliqua',
    text: 'Quis autem vel eum iure reprehenderit qui in ea voluptate velit esse quam nihil molestiae consequatur.',
  },
];
---

<section data-section="quests-stories" id="quests-stories" class="q-sec q-stories">
  <div class="q-pad">
    <h2 class="q-h2 q-stories__h2">Launch success stories</h2>
    <div
      class="q-car"
      data-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label="Success stories"
    >
      <div class="q-car__fade" aria-hidden="true"></div>
      <div class="q-car__fade q-car__fade--r" aria-hidden="true"></div>
      <div class="q-car__view" data-view>
        <div class="q-car__wrap" data-wrapper>
          {slides.map((s, i) => (
            <div
              class:list={['q-slide', i === 0 && 'is-active']}
              data-slide
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} / ${slides.length}`}
            >
              <div class="q-slide__inner" data-inner>
                <Image
                  src={s.img}
                  alt=""
                  widths={[520, 972]}
                  sizes="486px"
                  class="q-slide__img"
                  loading="eager"
                  draggable="false"
                />
                <div class="q-slide__grad"></div>
                <div class="q-slide__text">
                  <div class="q-slide__tagwr" data-tagwr>
                    <div class="q-tag" data-tag-idle>
                      <div>{s.tag}</div>
                    </div>
                    <div class="q-tag q-tag--active" data-tag-active>
                      <div>{s.tag}</div>
                    </div>
                  </div>
                  <div class="q-slide__copy" data-copy>
                    {s.text}
                  </div>
                  <div class="q-slide__more" data-more>
                    <div>Learn more</div>
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                      <circle cx="9" cy="9" r="9" fill="#fff" />
                      <path
                        d="M5 9h7M9.5 6l3 3-3 3"
                        stroke="#9b2f80"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                </div>
                <a
                  class="q-slide__link"
                  href="#"
                  aria-label={s.tag}
                  tabindex={i === 0 ? 0 : -1}
                  aria-hidden={i === 0 ? 'false' : 'true'}
                  draggable="false"
                ></a>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="q-car__dots" data-dots>
        {slides.map((_, i) => (
          <div
            class:list={['q-dot', i === 0 && 'is-active']}
            data-bullet
            role="button"
            tabindex="0"
            aria-label={`Go to slide ${i + 1}`}
          >
            <div class="q-dot__bar" data-progress></div>
          </div>
        ))}
      </div>
      <div class="q-car__arrows">
        <button type="button" class="q-arrow" data-prev aria-label="Previous slide">
          <span class="q-arrow__bg" data-bg></span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="m14.5 6-6 6 6 6"
              stroke="#fff"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <button type="button" class="q-arrow" data-next aria-label="Next slide">
          <span class="q-arrow__bg" data-bg></span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="m9.5 6 6 6-6 6"
              stroke="#fff"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .q-stories {
    overflow: hidden;
  }
  .q-stories__h2.q-h2 {
    max-width: 320px;
    margin: 0 auto;
  }
  .q-car {
    position: relative;
    margin: var(--spacing-48) auto 0;
    max-width: 1440px;
    --w: 256px;
    --h: 354px;
    --overlap: 16px;
    --rad: 40px;
    --inner: 80%;
  }
  .q-car__view {
    position: relative;
    height: var(--h);
    cursor: grab;
    touch-action: pan-y;
  }
  .q-car__view:active {
    cursor: grabbing;
  }
  .q-car__wrap {
    position: absolute;
    inset: 0;
  }
  .q-slide {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--w);
    height: var(--h);
    margin: calc(var(--h) / -2) 0 0 calc(var(--w) / -2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 100px;
    opacity: 0.2;
    user-select: none;
  }
  .q-slide.is-active {
    opacity: 1;
    z-index: 1;
  }
  .q-slide__inner {
    position: relative;
    width: var(--inner);
    height: 80%;
    border-radius: var(--rad);
    overflow: hidden;
  }
  .q-slide.is-active .q-slide__inner {
    width: 100%;
    height: 100%;
  }
  .q-slide__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .q-slide__grad {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(0, 0, 0, 0) 28%, rgba(155, 47, 128, 0.97) 57%);
  }
  .q-slide__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: var(--spacing-8);
    padding: 0 24px 36px;
  }
  .q-slide__tagwr {
    position: relative;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transform: translateY(82px);
  }
  .q-slide.is-active .q-slide__tagwr {
    transform: none;
  }
  .q-tag {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
    padding: 8px 12px;
    border-radius: 15px;
    overflow: clip;
    background-color: rgba(255, 255, 255, 0.24);
    -webkit-backdrop-filter: blur(130px);
    backdrop-filter: blur(130px);
    font-weight: var(--font-weight-medium);
    font-size: 4.1vw;
    line-height: 1.4;
    color: var(--color-white);
    white-space: nowrap;
  }
  .q-tag--active {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
  }
  .q-slide.is-active .q-tag {
    opacity: 0;
  }
  .q-slide.is-active .q-tag--active {
    opacity: 1;
  }
  .q-slide__copy {
    align-self: stretch;
    box-sizing: border-box;
    width: 100%;
    max-width: 99%;
    min-height: 62px;
    margin-top: -8px;
    padding-top: 8px;
    overflow: hidden;
    font-size: 14px;
    line-height: 16px;
    color: #f2f3f5;
    opacity: 0;
    transform: translateY(60px);
  }
  .q-slide__more {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    margin-top: 8px;
    font-size: var(--text-body);
    line-height: 24px;
    color: var(--color-white);
    opacity: 0;
  }
  .q-slide.is-active .q-slide__copy,
  .q-slide.is-active .q-slide__more {
    opacity: 1;
    transform: none;
  }
  .q-slide__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .q-slide__link:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: -6px;
    border-radius: var(--rad);
  }

  .q-car__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -30px;
    width: 160px;
    height: 8px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-8);
  }
  .q-dot {
    display: none;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--color-white-10);
    overflow: hidden;
    cursor: pointer;
  }
  .q-dot.is-near {
    display: block;
  }
  .q-dot.is-far {
    display: block;
    width: 4px;
    height: 4px;
  }
  .q-dot.is-active {
    display: block;
    width: 32px;
  }
  .q-dot__bar {
    width: 0;
    height: 8px;
    border-radius: 4px;
    background-color: var(--color-white);
  }

  .q-car__arrows {
    display: none;
    position: absolute;
    inset: 0;
    margin: 0 2%;
    z-index: 3;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
  }
  .q-arrow {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: none;
    cursor: pointer;
    pointer-events: auto;
    z-index: 5;
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }
  .q-arrow svg {
    position: relative;
  }
  .q-arrow__bg {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    background-color: var(--color-white);
    opacity: 0.1;
    transition: opacity 0.3s;
  }
  .q-arrow:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }
  .q-car__fade {
    display: none;
  }

  @media (min-width: 480px) {
    .q-stories__h2.q-h2 {
      max-width: none;
    }
    .q-car {
      margin-top: 80px;
      --inner: 70%;
    }
    .q-car__arrows {
      display: flex;
    }
    .q-tag {
      font-size: var(--text-body);
      line-height: 24px;
    }
  }
  @media (min-width: 568px) {
    .q-car {
      --w: 308px;
      --h: 353px;
      --overlap: 32px;
      --rad: 64px;
    }
    .q-slide__text {
      padding: 0 30px 36px;
    }
  }
  @media (min-width: 768px) {
    .q-car {
      --w: 486px;
      --h: 558px;
    }
    .q-slide__grad {
      background-image: linear-gradient(rgba(0, 0, 0, 0) 39%, rgba(155, 47, 128, 0.97) 74%);
    }
    .q-slide__text {
      padding: 0 57px 57px;
    }
    .q-tag {
      margin-bottom: 0;
      padding: 13px 19px;
      line-height: 29px;
    }
    .q-slide__copy {
      width: 352px;
      line-height: 18px;
    }
    .q-slide__more {
      margin-top: 0;
    }
  }
  @media (min-width: 992px) {
    .q-car {
      --inner: 80%;
    }
    .q-tag {
      font-size: var(--text-body-xl);
    }
    .q-slide__copy {
      font-size: var(--text-body);
    }
  }
  @media (min-width: 1440px) {
    .q-car {
      --rad: 72px;
    }
    .q-car__view {
      overflow: hidden;
    }
    .q-car__fade {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: -2%;
      width: 10%;
      z-index: 3;
      pointer-events: none;
      filter: blur(20px);
      background: var(--q-canvas);
    }
    .q-car__fade--r {
      left: auto;
      right: -2%;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { Draggable } from 'gsap/Draggable';
  import { CustomEase } from 'gsap/CustomEase';
  gsap.registerPlugin(Draggable, CustomEase);
  const cssEase = CustomEase.create('qCssEase', '0.25,0.1,0.25,1'); // CSS `ease` (Swiper's default wrapper timing)

  document
    .querySelectorAll<HTMLElement>('[data-section="quests-stories"] [data-carousel]')
    .forEach((root) => {
      const view = root.querySelector<HTMLElement>('[data-view]')!;
      const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
      const dots = [...root.querySelectorAll<HTMLElement>('[data-bullet]')];
      const N = slides.length;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const touch = window.matchMedia('(hover: none)').matches;
      const SPEED = reduce ? 0 : 0.8; // Swiper speed: 800
      const DELAY = 9; // Swiper autoplay.delay: 9000
      const state = { pos: 0 };
      let active = 0;
      let pitch = 454;
      const wrapIdx = gsap.utils.wrap(0, N);
      const wrapD = gsap.utils.wrap(-N / 2, N / 2);

      const measure = () => {
        const cs = getComputedStyle(root);
        // <568px the reference uses slidesPerView 1.36 / spaceBetween -16
        if (window.innerWidth < 568)
          root.style.setProperty('--w', `${(root.clientWidth + 16 * 0.36) / 1.36}px`);
        else root.style.removeProperty('--w');
        pitch = slides[0].offsetWidth - parseFloat(cs.getPropertyValue('--overlap'));
        render();
      };
      const render = () =>
        slides.forEach((s, i) => gsap.set(s, { x: wrapD(i - state.pos) * pitch }));

      // per-slide state transitions (reference CSS): slide opacity .8s; inner 80% -> 100% .8s;
      // tag wrapper / copy translate .4s; tag cross-fade & copy opacity .5s; "learn more" opacity .3s — all `ease`
      const paint = (i: number, on: boolean, instant = false) => {
        const s = slides[i];
        const d = (v: number) => (instant || reduce ? 0 : v);
        const cs = getComputedStyle(root);
        const inner = cs.getPropertyValue('--inner').trim() || '80%';
        s.classList.toggle('is-active', on);
        const o = { ease: cssEase, overwrite: 'auto' as const };
        gsap.to(s, { opacity: on ? 1 : 0.2, duration: d(0.8), ...o });
        gsap.to(s.querySelector('[data-inner]'), {
          width: on ? '100%' : inner,
          height: on ? '100%' : '80%',
          duration: d(0.8),
          ...o,
        });
        gsap.to(s.querySelector('[data-tagwr]'), { y: on ? 0 : 82, duration: d(0.4), ...o });
        gsap.to(s.querySelector('[data-tag-idle]'), {
          opacity: on ? 0 : 1,
          duration: d(0.5),
          ...o,
        });
        gsap.to(s.querySelector('[data-tag-active]'), {
          opacity: on ? 1 : 0,
          duration: d(0.5),
          ...o,
        });
        gsap.to(s.querySelector('[data-copy]'), { y: on ? 0 : 60, duration: d(0.4), ...o });
        gsap.to(s.querySelector('[data-copy]'), { opacity: on ? 1 : 0, duration: d(0.5), ...o });
        gsap.to(s.querySelector('[data-more]'), { opacity: on ? 1 : 0, duration: d(0.3), ...o });
        const link = s.querySelector<HTMLAnchorElement>('a')!;
        link.tabIndex = on ? 0 : -1;
        link.setAttribute('aria-hidden', on ? 'false' : 'true');
      };

      // dynamic bullets: active 32px, +-1 8px, +-2 4px, rest hidden (no wrap, like Swiper's realIndex)
      const paintDots = () =>
        dots.forEach((dEl, i) => {
          const k = Math.abs(i - active);
          dEl.classList.toggle('is-active', k === 0);
          dEl.classList.toggle('is-near', k === 1);
          dEl.classList.toggle('is-far', k === 2);
          if (k === 0) {
            dEl.setAttribute('aria-current', 'true');
            dEl.setAttribute('aria-label', `Current slide, slide ${i + 1}`);
          } else {
            dEl.removeAttribute('aria-current');
            dEl.setAttribute('aria-label', `Go to slide ${i + 1}`);
          }
          gsap.to(dEl, {
            width: k === 0 ? 32 : k === 1 ? 8 : 4,
            duration: reduce ? 0 : 0.3,
            ease: cssEase,
            overwrite: true,
          });
        });

      // autoplay + progress bar: width 0 -> 32px over 9s linear, pauses while hovered
      let auto: gsap.core.Tween | null = null;
      let autoplayOn = !reduce;
      const startAuto = () => {
        auto?.kill();
        dots.forEach((dEl) => gsap.set(dEl.querySelector('[data-progress]'), { width: 0 }));
        if (!autoplayOn) return;
        auto = gsap.fromTo(
          dots[active].querySelector('[data-progress]'),
          { width: 0 },
          { width: 32, duration: DELAY, ease: 'none', onComplete: () => go(active + 1) },
        );
        if (hovering) auto.pause();
      };
      let hovering = false;
      root.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') {
          hovering = true;
          auto?.pause();
        }
      });
      root.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse') {
          hovering = false;
          auto?.resume();
        }
      });

      let mover: gsap.core.Tween | null = null;
      const setActive = (idx: number) => {
        const next = wrapIdx(idx);
        if (next === active) return;
        paint(active, false);
        active = next;
        paint(active, true);
        paintDots();
      };
      // move by the shortest way round to logical index `to` (may be outside 0..N-1)
      const go = (to: number, dur = SPEED) => {
        const target = state.pos + wrapD(to - state.pos);
        setActive(Math.round(target));
        mover?.kill();
        mover = gsap.to(state, {
          pos: target,
          duration: dur,
          ease: cssEase,
          onUpdate: render,
          onComplete: () => {
            state.pos = wrapIdx(state.pos);
            render();
          },
        });
        startAuto();
      };

      root.querySelector('[data-next]')!.addEventListener('click', () => go(active + 1));
      root.querySelector('[data-prev]')!.addEventListener('click', () => go(active - 1));
      dots.forEach((dEl, i) => {
        dEl.addEventListener('click', () => go(i));
        dEl.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            go(i);
          }
        });
      });

      // keyboard: arrows while the carousel is in the viewport (Swiper keyboard: true)
      let inView = false;
      new IntersectionObserver(([en]) => {
        inView = en.isIntersecting;
      }).observe(root);
      document.addEventListener('keydown', (e) => {
        if (!inView || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        const t = e.target as HTMLElement;
        if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
        if (e.key === 'ArrowRight') go(active + 1);
        if (e.key === 'ArrowLeft') go(active - 1);
      });

      // drag (grabCursor) + slideToClickedSlide
      const proxy = document.createElement('div');
      let startPos = 0;
      Draggable.create(proxy, {
        type: 'x',
        trigger: view,
        dragClickables: true,
        minimumMovement: 4,
        onPress() {
          startPos = state.pos;
        },
        onDragStart() {
          mover?.kill();
          auto?.pause();
        },
        onDrag() {
          state.pos = startPos - (this.x - this.startX) / pitch;
          render();
        },
        onDragEnd() {
          const moved = state.pos - startPos;
          const target =
            Math.abs(moved) > 0.12 && Math.abs(moved) < 0.5
              ? startPos + Math.sign(moved)
              : Math.round(state.pos);
          if (touch) autoplayOn = false; // autoplay.disableOnInteraction on phone/tablet
          go(Math.round(target));
          gsap.set(proxy, { x: 0 });
        },
        onClick(e: PointerEvent) {
          const slide = (e.target as HTMLElement).closest<HTMLElement>('[data-slide]');
          if (!slide) return;
          const i = slides.indexOf(slide);
          if (i !== active) go(i);
          else {
            const href = slide.querySelector('a')!.getAttribute('href');
            if (href && href !== '#') window.location.href = href;
          }
        },
      });
      // native link clicks are handled above (prevents jumps on href="#")
      root.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', (e) => {
          if (a.getAttribute('href') === '#') e.preventDefault();
        }),
      );

      slides.forEach((_, i) => paint(i, i === 0, true));
      paintDots();
      measure();
      window.addEventListener('resize', measure);
      startAuto();
    });
</script>
