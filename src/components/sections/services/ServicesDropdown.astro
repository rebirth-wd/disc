---
// Click-to-open dropdown button.
// variant "white": 48px white toggle + white list (platform block). variant "blurple": 52px blurple toggle + indigo list (banner).
// Motion: chevron rotates 0→180deg in 100ms easeIn on open, back in 100ms ease on close; list toggles instantly.
interface Item {
  label: string;
  href?: string;
}
interface Props {
  label: string;
  items: Item[];
  variant?: 'white' | 'blurple';
  z?: number;
  id: string;
}
const { label, items, variant = 'white', z = 1, id } = Astro.props;
---

<div
  class:list={['services-dropdown', `services-dropdown--${variant}`]}
  data-services-dropdown
  style={`z-index:${z}`}
>
  <button
    type="button"
    class="services-dropdown__toggle"
    id={`${id}-toggle`}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls={`${id}-list`}
  >
    {Astro.slots.has('icon') && (
      <span class="services-dropdown__icon" aria-hidden="true">
        <slot name="icon" />
      </span>
    )}
    <span class="services-dropdown__label">{label}</span>
    {variant === 'blurple' && <span class="services-dropdown__glow" aria-hidden="true"></span>}
    <svg
      class="services-dropdown__arrow"
      data-services-dropdown-arrow
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M2.5 5.5 8 11l5.5-5.5"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
  <nav class="services-dropdown__list" id={`${id}-list`} aria-labelledby={`${id}-toggle`} hidden>
    {items.map((it) => (
      <a class="services-dropdown__link" href={it.href ?? '#'}>
        {it.label}
      </a>
    ))}
  </nav>
</div>

<style>
  .services-dropdown {
    position: relative;
    display: inline-flex;
  }
  .services-dropdown__toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-8);
    box-sizing: border-box;
    margin: 0;
    border: 0;
    cursor: pointer;
    font-family: var(--font-abc-ginto-discord);
    font-size: var(--text-nav);
    font-weight: var(--font-weight-medium);
    line-height: 24px;
    white-space: nowrap;
  }
  .services-dropdown__toggle:focus-visible {
    outline: 2px solid var(--color-signal-green);
    outline-offset: 3px;
  }
  .services-dropdown__icon {
    display: flex;
    width: 24px;
    height: 24px;
    flex: none;
  }
  .services-dropdown__icon :global(svg) {
    width: 24px;
    height: 24px;
    display: block;
  }
  .services-dropdown__label {
    position: relative;
    z-index: 3;
  }
  .services-dropdown__arrow {
    position: relative;
    z-index: 1;
    flex: none;
  }
  .services-dropdown__list {
    position: absolute;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    padding: var(--spacing-8);
    text-align: left;
  }
  .services-dropdown__list[hidden] {
    display: none;
  }
  .services-dropdown__link {
    display: block;
    padding: 13px var(--spacing-16);
    font-size: var(--text-body);
    line-height: 24px;
    font-weight: var(--font-weight-regular);
    text-decoration: none;
    white-space: nowrap;
  }

  /* white (platform blocks) */
  .services-dropdown--white .services-dropdown__toggle {
    max-height: 48px;
    padding: 13.5px var(--spacing-20);
    border-radius: var(--radius-buttons);
    background-color: var(--surface-white-control);
    color: var(--color-black);
    transition: all 0.3s;
  }
  .services-dropdown--white .services-dropdown__arrow {
    width: 14px;
    height: 14px;
  }
  .services-dropdown--white .services-dropdown__list {
    top: 100%;
    margin-top: 11px;
    min-width: max-content;
    border-radius: 8px;
    background-color: var(--surface-white-control);
  }
  .services-dropdown--white .services-dropdown__link {
    border-radius: 8px;
    color: var(--color-black);
  }
  @media (hover: hover) {
    .services-dropdown--white .services-dropdown__toggle:hover {
      background-color: var(--color-fog);
    }
    .services-dropdown--white .services-dropdown__link:hover {
      background-color: rgba(0, 0, 0, 0.1);
    }
    .services-dropdown--blurple .services-dropdown__link:hover {
      background-color: var(--color-white-10);
    }
    /* banner button: hover adds 0 2px 9px rgba(6,10,11,.42) */
    .services-dropdown--blurple .services-dropdown__toggle:hover {
      box-shadow: 0 2px 9px rgba(6, 10, 11, 0.42);
    }
  }
  @media (min-width: 992px) {
    .services-dropdown--white .services-dropdown__toggle {
      padding: 13.5px var(--spacing-24);
    }
  }

  /* blurple (banner) */
  .services-dropdown--blurple .services-dropdown__toggle {
    padding: 11px var(--spacing-16);
    border-radius: 8px;
    background-color: var(--surface-blurple-action);
    color: var(--color-white);
    font-size: 14px;
    line-height: 18px;
    overflow: clip;
    transition:
      box-shadow 0.3s,
      transform 0.3s,
      background-color 0.3s;
  }
  .services-dropdown__glow {
    position: absolute;
    z-index: 1;
    top: 45px;
    left: -50%;
    width: 200%;
    height: 70px;
    border-radius: 50%;
    background-color: #1f1d5d;
    filter: blur(30px);
    pointer-events: none;
  }
  .services-dropdown--blurple .services-dropdown__arrow {
    width: 16px;
    height: 17px;
  }
  .services-dropdown--blurple .services-dropdown__list {
    top: 0;
    margin-top: 60px;
    max-height: 260px;
    overflow: auto;
    border-radius: 12px;
    background-color: #30305f;
    box-shadow: 0 6px 10px rgba(0, 0, 0, 0.08);
  }
  .services-dropdown--blurple .services-dropdown__link {
    border-radius: 12px;
    color: var(--color-white);
  }
  @media (min-width: 480px) {
    .services-dropdown--blurple .services-dropdown__toggle {
      padding: 14.5px var(--spacing-20) 13.5px;
      font-size: var(--text-nav);
      line-height: 24px;
    }
  }
  @media (min-width: 992px) {
    .services-dropdown--blurple .services-dropdown__toggle {
      padding: 14.5px var(--spacing-24) 13.5px;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { CustomEase } from 'gsap/CustomEase';
  gsap.registerPlugin(CustomEase);
  // "easeIn" = cubic-bezier(.42,0,1,1); "ease" = cubic-bezier(.25,.1,.25,1)
  const easeIn = CustomEase.create('servicesDropdownEaseIn', '0.42,0,1,1');
  const ease = CustomEase.create('servicesDropdownEase', '0.25,0.1,0.25,1');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  const all = Array.from(document.querySelectorAll<HTMLElement>('[data-services-dropdown]'));
  const setOpen = (dd: HTMLElement, open: boolean) => {
    const toggle = dd.querySelector<HTMLButtonElement>('.services-dropdown__toggle')!;
    const list = dd.querySelector<HTMLElement>('.services-dropdown__list')!;
    const arrow = dd.querySelector<SVGElement>('[data-services-dropdown-arrow]')!;
    if ((toggle.getAttribute('aria-expanded') === 'true') === open) return;
    toggle.setAttribute('aria-expanded', String(open));
    list.hidden = !open;
    dd.classList.toggle('is-open', open);
    gsap.to(arrow, {
      rotation: open ? 180 : 0,
      duration: reduce.matches ? 0 : 0.1,
      ease: open ? easeIn : ease,
      overwrite: true,
    });
  };
  all.forEach((dd) => {
    dd.querySelector('.services-dropdown__toggle')!.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen =
        dd.querySelector('.services-dropdown__toggle')!.getAttribute('aria-expanded') !== 'true';
      all.forEach((o) => o !== dd && setOpen(o, false));
      setOpen(dd, willOpen);
    });
  });
  document.addEventListener('click', (e) =>
    all.forEach((dd) => !dd.contains(e.target as Node) && setOpen(dd, false)),
  );
  document.addEventListener(
    'keydown',
    (e) => e.key === 'Escape' && all.forEach((dd) => setOpen(dd, false)),
  );
</script>
