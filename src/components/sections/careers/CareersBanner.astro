---
import Section from '@components/layout/Section.astro';
// careers-banner:
// rounded indigo banner card with heading, copy, CTA and four floating objects (two sharp, two far-field).
import Button from '@components/ui/Button.astro';
import CareersObject from '@components/graphics/objects/CareersObject.astro';
import Starfield from '@components/graphics/stars/Starfield.astro';
import Heading from '@components/ui/Heading.astro';
---

<Section
  section="careers-banner"
  class="relative pt-[100px] md:pt-[120px] wide:pt-[160px]"
  container="narrow"
>
  <div
    data-banner-card
    class="careers-banner__card relative flex flex-col items-center overflow-clip rounded-[40px] px-24 py-[120px] md:rounded-[64px] md:px-48 wide:rounded-[72px] wide:px-[80px]"
  >
    <Starfield density={0.5} seed={23} class="opacity-40" />
    <div class="relative w-full max-w-[477px] wide:max-w-[678px]">
      <Heading level={2} size="lg" class="mb-24 text-center">
        Proudly built in Bundaberg
      </Heading>
      <p class="text-center font-body text-body leading-[22px] text-white md:text-body-xl md:leading-[26px]">
        Websites in Bundaberg just got an upgrade. Want hosting, backups, security, and updates
        managed for you, every month?
      </p>
      <div class="h-[32px] md:h-48"></div>
      <div class="flex flex-col items-center">
        <Button variant="blurple" size="lg" href="#" glow class="z-2">
          Learn More
        </Button>
      </div>
    </div>
    <CareersObject
      kind="gem"
      class="absolute top-[-25px] left-[-10px] h-auto w-[163px] md:top-[-11px] md:left-[-23px] md:w-[184px] xl:left-[49px] xl:w-[206px] wide:top-[-9px] wide:left-[16px] wide:w-[282px]"
    />
    <CareersObject
      kind="orb"
      class="absolute top-[403px] left-[213px] h-auto w-[117px] md:top-[300px] md:left-auto md:right-[1px] md:w-[136px] xl:top-[278px] xl:right-[84px] xl:w-[158px] wide:top-[294px] wide:right-[52px] wide:w-[169px]"
    />
    <CareersObject
      kind="cube"
      blur
      class="absolute top-[41px] right-[-12px] hidden h-auto w-[129px] md:block xl:right-[85px] wide:top-[63px] wide:right-[80px] wide:w-[153px]"
    />
    <CareersObject
      kind="cursor"
      blur
      class="absolute top-[341px] left-[9px] hidden h-auto w-[128px] md:block xl:left-[105px] wide:top-[315px] wide:left-[133px]"
    />
  </div>
</Section>
<style>
  .careers-banner__card {
    background:
      radial-gradient(90% 70% at 50% 0%, rgba(88, 101, 242, 0.75) 0%, var(--color-blurple-0) 100%),
      linear-gradient(180deg, #4a52c0 0%, #2f3390 40%, #1f2060 72%, #1b1b45 100%);
  }
</style>
