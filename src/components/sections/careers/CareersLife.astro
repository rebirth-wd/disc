---
import Section from '@components/layout/Section.astro';
import Heading from '@components/ui/Heading.astro';
// careers-life: the centred section heading only (256px @1680).
---

<Section
  section="careers-life"
  class="relative pt-[100px] md:pt-[120px] [@media(min-width:1440px)]:pt-[160px]"
  container="none"
>
  <div class="mx-auto max-w-[1538px] px-24 md:px-40">
    <div class="mx-auto flex max-w-full flex-col items-center text-center md:max-w-[90%] xl:max-w-[870px] [@media(min-width:1440px)]:max-w-[958px]">
      <Heading level={2} size="lg" class="mb-16 md:mb-24">
        Life with&nbsp;Rebirth
      </Heading>
    </div>
    <div class="h-16 md:h-24"></div>
  </div>
</Section>
