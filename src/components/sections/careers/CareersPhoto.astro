---
// Unsplash photo with the shared indigo/violet duotone grade so the whole set reads as single-source.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  position?: string;
  loading?: 'lazy' | 'eager';
}
const {
  src,
  alt,
  widths = [480, 800, 1200, 1600],
  sizes = '800px',
  class: cls = '',
  position = '50% 50%',
  loading = 'lazy',
} = Astro.props;
---

<div class:list={['careers-photo', cls]}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    draggable="false"
    style={`object-position:${position}`}
  />
</div>
<style>
  .careers-photo {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-deep-indigo);
  }
  .careers-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.12) brightness(1.08);
    user-select: none;
    -webkit-user-drag: none;
  }
  /* duotone: tint the greys, then deepen the shadows towards the canvas indigo */
  .careers-photo::before,
  .careers-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .careers-photo::before {
    z-index: 1;
    background: linear-gradient(140deg, #6d78ff 0%, #8a5cf6 48%, var(--color-fuchsia) 100%);
    mix-blend-mode: color;
  }
  .careers-photo::after {
    z-index: 2;
    background: linear-gradient(200deg, rgba(88, 101, 242, 0.1) 0%, rgba(26, 32, 129, 0.55) 100%);
    mix-blend-mode: multiply;
  }
</style>
