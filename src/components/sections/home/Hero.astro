---
// Home hero (896px tall at 1680). Breakpoints: 1440 / 1280 / 991 / 767 / 479. Motion parameters are in <script>.
import Button from '@components/ui/Button.astro';
import HeroIllustration from '@components/graphics/objects/HeroIllustration.astro';

// 20 twinkling stars: x as % of the hero width, y in px at 1680,
// size in px, and the delay pattern (a–f) each one plays.
const twinkles: [number, number, number, string][] = [
  [998, 81, 20, 'a'],
  [724, 179, 14, 'c'],
  [1572, 224, 14, 'f'],
  [279, 179, 14, 'b'],
  [1572, 224, 14, 'c'],
  [753, 233, 6, 'b'],
  [291, 81, 6, 'd'],
  [173, 134, 6, 'b'],
  [820, 90, 6, 'c'],
  [1005, 143, 6, 'f'],
  [1148, 72, 6, 'b'],
  [207, 108, 6, 'a'],
  [543, 90, 6, 'e'],
  [1568, 90, 6, 'e'],
  [727, 403, 8, 'c'],
  [1504, 269, 8, 'c'],
  [1502, 143, 4, 'a'],
  [1502, 143, 4, 'd'],
  [790, 152, 4, 'c'],
  [1476, 90, 4, 'c'],
];
---

<section data-section="home-hero" data-nav-trigger class="hero relative text-white">
  <!-- sky: gradient glow, pixel stars, twinkles, far-field object B -->
  <div class="hero-sky" aria-hidden="true">
    <div class="hero-glow"></div>
    <!-- no generic Starfield here; the 20 twinkle stars below are the hero's own set -->
    {twinkles.map(([x, y, s, p]) => (
      <i
        class:list={['hero-tw', s >= 14 && 'hero-tw--plus']}
        data-hero="twinkle"
        data-pattern={p}
        style={`left:${(x / 16.8).toFixed(2)}%;top:calc(${y}px * var(--hero-sy));width:${s}px;height:${s}px`}
      />
    ))}
    <!-- far-field object B: gear  -->
    <div class="hero-far hero-far--b" data-hero="far-b">
      <svg viewBox="0 0 144 160" xmlns="http://www.w3.org/2000/svg">
        <g transform="translate(72 82)">
          {[0, 45, 90, 135, 180, 225, 270, 315].map((a) => (
            <path
              d="M-13-62h26l5 22h-36Z"
              fill={a % 90 ? '#8c95ff' : '#b48cff'}
              transform={`rotate(${a})`}
            />
          ))}
          <path d="M0-48l34 14 14 34-14 34-34 14-34-14-14-34 14-34Z" fill="#9b84ff" />
          <path d="M0-48l34 14 14 34-14 34-34 14Z" fill="#7b5cf0" />
          <path d="M0-20l14 6 6 14-6 14-14 6-14-6-6-14 6-14Z" fill="#2a2f9c" />
        </g>
      </svg>
    </div>
  </div>

  <div class="hero-pad">
    <div class="hero-container">
      <div class="hero-cols">
        <div class="hero-text">
          <!-- far-field object A: cursor  -->
          <div class="hero-far hero-far--a" data-hero="far-a" aria-hidden="true">
            <svg viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M62 30l94 70-40 8 26 46-24 14-26-46-30 28Z"
                fill="#b02d7c"
                transform="translate(8 8)"
              />
              <path d="M62 30l94 70-40 8 26 46-24 14-26-46-30 28Z" fill="#f47fbf" />
              <path d="M62 30l94 70-40 8-24-14Z" fill="#ffd3ea" />
            </svg>
          </div>
          <div class="hero-mask">
            <h1 class="hero-h1 font-abc-ginto-discord-nord text-display leading-display tracking-display font-bold uppercase text-white">
              Fast sites for&nbsp;the modern&nbsp;web
            </h1>
          </div>
          <p class="hero-p font-abc-ginto-discord text-body-xl leading-body-xl tracking-body-xl font-normal text-white">
            Rebirth Online builds fast, secure, static-first websites using a modern,
            production-grade web architecture. Websites in Bundaberg just got an&nbsp;upgrade.
          </p>
        </div>
        <div class="hero-media">
          <div class="hero-stage" data-hero="stage">
            <HeroIllustration />
          </div>
        </div>
      </div>
      <div class="hero-cta" data-hero="cta">
        <Button size="xl" href="#stack" class="mt-24">
          Explore the Stack
        </Button>
        <Button variant="blurple" size="xl" href="#how-we-work" class="mt-24">
          How We Work
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- base: below 1280 (992–1279) ---------- */
  .hero {
    --hero-sy: 0.8;
    padding: 128px 0 125px;
    isolation: isolate;
  }
  .hero-sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        120% 110% at 105% 65%,
        #2c36b6 0%,
        #2731a5 25%,
        rgba(26, 32, 129, 0.85) 50%,
        rgba(13, 16, 82, 0.4) 72%,
        rgba(13, 16, 82, 0) 92%
      ),
      linear-gradient(180deg, #000003 0%, #01011a 45%, #030330 78%, #070947 100%);
    /* dissolve into whatever canvas follows the hero (the page-wide sky continues below) */
    -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 180px), transparent 100%);
    mask-image: linear-gradient(180deg, #000 calc(100% - 180px), transparent 100%);
  }
  .hero-tw {
    position: absolute;
    display: block;
    background: var(--color-white);
    filter: blur(1px);
  }
  .hero-tw--plus {
    clip-path: polygon(
      40% 0,
      60% 0,
      60% 40%,
      100% 40%,
      100% 60%,
      60% 60%,
      60% 100%,
      40% 100%,
      40% 60%,
      0 60%,
      0 40%,
      40% 40%
    );
    filter: blur(0.6px);
  }

  .hero-pad {
    position: relative;
    z-index: 1;
    padding: 0 var(--page-gutter);
  }
  .hero-container {
    position: relative;
    width: 90%;
    max-width: 1080px;
    margin: 0 auto;
  }
  .hero-cols {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 34.6px;
    margin-bottom: 24px;
  }
  .hero-text {
    position: relative;
    z-index: 3;
    flex: none;
    width: 100%;
    max-width: 336px;
    margin-top: 64px;
  }
  .hero-mask {
    position: relative;
    padding-bottom: 6px;
  }
  .hero-h1 {
    position: relative;
    z-index: 4;
    margin: 0 0 4px;
    font-size: 44px;
    letter-spacing: -0.44px;
  }
  .hero-p {
    margin: 4px 0 0;
    padding-right: 16px;
    font-size: 18px;
  }
  .hero-media {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: 420px;
  }
  .hero-stage {
    position: absolute;
    left: -40px;
    top: 20px;
    width: calc(100% + 80px);
  }

  .hero-far {
    position: absolute;
    pointer-events: none;
    will-change: transform;
  }
  .hero-far svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-far--a {
    z-index: 3;
    left: 256px;
    top: -144px;
    width: 160px;
    height: 160px;
    filter: blur(7px);
    opacity: 0.9;
  }
  .hero-far--b {
    z-index: 0;
    left: calc(50% + 490px);
    top: 232px;
    width: 115px;
    height: 128px;
    filter: blur(6px);
    opacity: 0.8;
  }

  .hero-cta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 var(--spacing-24);
  }

  /* ---------- ≥1280 ---------- */
  @media (min-width: 1280px) {
    .hero {
      min-height: min(100vh, 900px);
    }
    .hero-text {
      max-width: 448px;
    }
    .hero-p {
      font-size: var(--text-body-xl);
    }
    .hero-media {
      height: 480px;
    }
    .hero-stage {
      left: -70.6px;
      top: 27.7px;
      width: 736px;
    }
  }
  /* ---------- ≥1440 (the 1680 layout) ---------- */
  @media (min-width: 1440px) {
    .hero {
      --hero-sy: 1;
      padding-top: 176px;
      min-height: 0;
    }
    .hero-container {
      width: 100%;
      max-width: var(--page-max-width);
    }
    .hero-cols {
      margin-bottom: var(--spacing-40);
    }
    .hero-text {
      max-width: 491.2px;
      margin-top: var(--spacing-56);
    }
    .hero-h1 {
      margin-bottom: var(--spacing-8);
      font-size: var(--text-display);
      letter-spacing: var(--tracking-display);
    }
    .hero-p {
      margin-top: var(--spacing-8);
      padding-right: 0;
    }
    .hero-media {
      height: 466px;
    }
    .hero-stage {
      left: calc(-15.8px - 2vw);
      top: -14px;
      width: 832px;
    }
    .hero-far--a {
      left: 396.8px;
      top: -160px;
      width: 192px;
      height: 192px;
    }
    .hero-far--b {
      left: calc(50% + 586px);
      top: 320px;
      width: 144px;
      height: 160px;
    }
  }
  /* ---------- ≤991: stacked, art first ---------- */
  @media (max-width: 991px) {
    .hero {
      padding-bottom: var(--spacing-56);
    }
    .hero-cols {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 0;
      margin-bottom: 32px;
    }
    .hero-text {
      max-width: none;
      margin-top: var(--spacing-48);
      text-align: center;
    }
    .hero-h1 {
      max-width: 400px;
      margin: 0 auto 14px;
      font-size: 35px;
      line-height: 30px;
      letter-spacing: -0.35px;
    }
    .hero-p {
      margin-top: 0;
      text-align: center;
      line-height: 23.4px;
    }
    .hero-media {
      flex: none;
      width: 100%;
      max-width: 688px;
      height: 417px;
      margin: 0 auto;
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }
    .hero-stage {
      position: relative;
      left: auto;
      top: 22px;
      width: min(600px, 100%);
    }
    .hero-far--a {
      left: calc(50% + 71px);
      top: -577px;
      width: 128px;
      height: 128px;
      filter: blur(9px);
    }
    .hero-far--b {
      left: calc(100% - 56px);
      top: 293px;
      width: 112px;
      height: 128px;
    }
    .hero-cta {
      min-height: 162.8px;
      align-content: flex-start;
    }
  }
  /* ---------- ≤767 ---------- */
  @media (max-width: 767px) {
    .hero {
      padding: var(--spacing-64) 0 39px;
    }
    .hero-pad {
      padding: 0 32px;
    }
    .hero-cols {
      margin-bottom: var(--spacing-16);
    }
    .hero-text {
      margin-top: 0;
    }
    .hero-h1 {
      max-width: 325px;
      font-size: 27px;
      line-height: 24px;
      letter-spacing: -0.27px;
    }
    .hero-p {
      font-size: var(--text-body);
      line-height: 20.8px;
    }
    .hero-media {
      height: auto;
      max-width: 600px;
      padding: var(--spacing-40) 0 32px;
      aspect-ratio: auto;
    }
    .hero-stage {
      top: 0;
      width: 100%;
      aspect-ratio: 482.4 / 389.8;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .hero-stage :global(.hero-illustration) {
      flex: none;
      width: 108%;
    }
    .hero-tw {
      display: none;
    }
    .hero-far--a {
      left: calc(50% + 39px);
      top: auto;
      bottom: calc(100% + 386px);
      width: 84px;
      height: 84px;
    }
    .hero-far--b {
      left: calc(100% - 41px);
      top: 206px;
    }
    .hero-cta {
      flex-direction: column;
      flex-wrap: nowrap;
      min-height: 0;
    }
  }
  /* ---------- ≤479 ---------- */
  @media (max-width: 479px) {
    .hero {
      padding-bottom: 0;
    }
    .hero-pad {
      padding: 0 var(--spacing-24);
    }
    .hero-container {
      width: 100%;
    }
    .hero-cols {
      padding: 0 2%;
    }
    .hero-media {
      padding-top: var(--spacing-20);
    }
    .hero-far--a {
      left: calc(50% + 4px);
      bottom: calc(100% + 276px);
    }
    .hero-far--b {
      left: calc(100% - 54px);
      top: 165px;
    }
  }
</style>

<script>
  // Hero motion (all looping, only while the hero is in view):
  //  far-field objects A/B (≥768): linear keyframes, 25s cycle
  //  robot (≥992): bob y −10↔0, 2s inOutSine; shadow width 105%↔50%, blur .5↔0px
  //  mascot (≥992): wobble skewY 0↔10°, scale 1↔1.1 (linear), rotate 0↔10° (outQuart), 2s
  //  twinkle stars (≥768): 20 stars, opacity 0↔1, 0.5s easeIn, per-list delays
  // No page-load entrance, mouse parallax or scroll parallax in the hero
  // (verified by sampling computed styles every 100ms for 11s, with pointer moves and scrolling).
  import { gsap, ease, motion, onPage, playWhileInView, MQ } from '@lib/motion';

  onPage(() => {
    const root = document.querySelector<HTMLElement>('[data-section="home-hero"]');
    if (root) {
      const q = gsap.utils.selector(root);

      // --- far-field objects + twinkling stars (≥768) ---
      motion(
        root,
        () => {
          const tls: gsap.core.Timeline[] = [];

          // each group starts every 5s; group 1 has a 1s delay
          const far = gsap.timeline({ repeat: -1, paused: true, defaults: { ease: 'none' } });
          far
            .set(
              q('[data-hero="far-a"], [data-hero="far-b"]'),
              { x: 0, y: 0, rotation: 0, scale: 1 },
              0,
            )
            .to(
              q('[data-hero="far-a"]'),
              { x: -5, y: -5, rotation: 5, scale: 1.03, duration: 4 },
              1,
            )
            .to(
              q('[data-hero="far-a"]'),
              { x: -20, y: 10, rotation: 12, scale: 1.1, duration: 5 },
              5,
            )
            .to(
              q('[data-hero="far-a"]'),
              { x: 0, y: 15, rotation: 23, scale: 1.03, duration: 5 },
              10,
            )
            .to(
              q('[data-hero="far-a"]'),
              { x: -5, y: 10, rotation: 12, scale: 0.92, duration: 5 },
              15,
            )
            .to(q('[data-hero="far-a"]'), { x: 0, y: 0, rotation: 0, scale: 1, duration: 4 }, 20)
            .to(
              q('[data-hero="far-b"]'),
              { x: 5, y: -10, rotation: -10, scale: 1.09, duration: 4 },
              1,
            )
            .to(
              q('[data-hero="far-b"]'),
              { x: 10, y: -20, rotation: -24, scale: 1.2, duration: 4 },
              5,
            )
            .to(
              q('[data-hero="far-b"]'),
              { x: 5, y: -17, rotation: -22, scale: 1.16, duration: 4 },
              10,
            )
            .to(
              q('[data-hero="far-b"]'),
              { x: 0, y: -5, rotation: -5, scale: 1.05, duration: 5 },
              15,
            )
            .to(q('[data-hero="far-b"]'), { x: 0, y: 0, rotation: 0, scale: 1, duration: 5 }, 20)
            .to({}, { duration: 0 }, 25);
          tls.push(far);

          // star lists: [delay before fade-in, delay before fade-out, delay, delay] — every fade is 0.5s easeIn
          const patterns: Record<string, number[]> = {
            a: [1, 2, 1, 2],
            b: [2, 2, 1, 2],
            c: [1, 1, 1, 2],
            d: [1.2, 1, 1, 2],
            e: [1.3, 2.2, 1, 2],
            f: [0.3, 0.8, 1, 2],
          };
          q('[data-hero="twinkle"]').forEach((el) => {
            const d = patterns[(el as HTMLElement).dataset.pattern || 'a'];
            gsap.set(el, { opacity: 0 });
            const tl = gsap.timeline({
              repeat: -1,
              paused: true,
              defaults: { duration: 0.5, ease: ease.in },
            });
            tl.to(el, { opacity: 1, delay: d[0] })
              .to(el, { opacity: 0, delay: d[1] })
              .to(el, { opacity: 1, delay: d[2] })
              .to(el, { opacity: 0, delay: d[3] });
            tls.push(tl);
          });

          const st = playWhileInView(root, ...tls);
          return () => {
            st.kill();
            gsap.set(q('[data-hero="twinkle"]'), { clearProps: 'opacity' });
            gsap.set(q('[data-hero="far-a"], [data-hero="far-b"]'), { clearProps: 'transform' });
          };
        },
        MQ.md,
      );

      // --- illustration idle loops (≥992) ---
      motion(
        root,
        () => {
          const bobEl = q('[data-hero="bob"]');
          const shadow = q('[data-hero="bob-shadow"]');
          const wobble = q('[data-hero="wobble"]');

          gsap.set(bobEl, { y: -10 });
          gsap.set(shadow, { scaleX: 1.05, transformOrigin: '50% 50%', filter: 'blur(0.5px)' });
          const bob = gsap.timeline({
            repeat: -1,
            paused: true,
            defaults: { duration: 2, ease: ease.inOutSine },
          });
          bob
            .to(bobEl, { y: 0 }, 0)
            .to(shadow, { scaleX: 0.5, filter: 'blur(0px)' }, 0)
            .to(bobEl, { y: -10 }, 2)
            .to(shadow, { scaleX: 1.05, filter: 'blur(0.5px)' }, 2);

          gsap.set(wobble, { transformOrigin: '50% 50%', skewY: 0, scale: 1, rotation: 0 });
          const wob = gsap.timeline({
            repeat: -1,
            paused: true,
            defaults: { duration: 2, ease: 'none' },
          });
          wob
            .to(wobble, { skewY: 10, scale: 1.1 }, 0)
            .to(wobble, { rotation: 10, ease: ease.outQuart }, 0)
            .to(wobble, { skewY: 0, scale: 1 }, 2)
            .to(wobble, { rotation: 0, ease: ease.outQuart }, 2);

          const st = playWhileInView(root, bob, wob);
          return () => {
            st.kill();
            gsap.set([bobEl, shadow, wobble], { clearProps: 'transform,filter' });
          };
        },
        MQ.lg,
      );
    }
  });
</script>
