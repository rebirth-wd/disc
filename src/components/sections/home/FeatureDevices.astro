---
/**
 * same reversed layout
 * as home--5section (text left, indigo inset right). What differs is the backdrop: a bright blurple glow
 * bleeding in from the left edge (texture at 93% width, anchored top-left) and the slab's own 5-stop
 * 135° glass gradient. Decor: blurred far-field object above the slab's upper-right corner.
 */
import FeatureBlock from './FeatureBlock.astro';
import DeviceMosaic from '@components/graphics/loops/DeviceMosaic.astro';
import Twinkles from '@components/graphics/stars/Twinkles.astro';
import { FEATURE_STARS } from './featureStars';
import ParallaxFloat from '@components/graphics/objects/ParallaxFloat.astro';
---

<FeatureBlock
  name="devices"
  heading="Wherever<br>they browse,<br>load fast"
  reverse
  sectionHeight={951}
  padTop={151}
  insetFill="indigo"
  textPadRight={4}
  padLg={[164, 146]}
  padMd={[80, 146]}
  padSm={[120, 263]}
  class="feature-devices"
  tightGutter
>
  <DeviceMosaic slot="media" />
  Your site is distributed across Cloudflare's network and served from the node closest to each
  visitor. Instant loads on any phone, tablet, laptop or desktop.
  <Fragment slot="decor">
    <div class="feature-devices__glow"></div>
    <Twinkles stars={FEATURE_STARS} origin="percent" sparkle="tapered" blur play="in-view" />
    <!-- y -60 → 170, linear, trigger 475.5px above this section's top -->
    <ParallaxFloat
      class="feature-devices__globe"
      from={-60}
      to={170}
      triggerTop="-475.5px"
      floatY={8}
      floatRot={5}
      floatDur={4.6}
    >
      <svg viewBox="0 0 293 293">
        <defs>
          <radialGradient id="feature-devices-globe-a" cx="0.35" cy="0.3" r="0.8">
            <stop offset="0" stop-color="#7f86ff" />
            <stop offset="0.6" stop-color="#3b3fc4" />
            <stop offset="1" stop-color="#231a8a" />
          </radialGradient>
        </defs>
        <g transform="rotate(-18 146 150)">
          <ellipse
            cx="146"
            cy="156"
            rx="132"
            ry="34"
            fill="none"
            stroke="#b144e6"
            stroke-width="16"
          />
          <circle cx="146" cy="150" r="92" fill="url(#feature-devices-globe-a)" />
          <path
            d="M60 126c40 22 130 22 172 0M58 176c44-20 132-20 176 0M146 58c-44 50-44 134 0 184M146 58c44 50 44 134 0 184"
            fill="none"
            stroke="#8f97ff"
            stroke-width="6"
            opacity="0.55"
          />
          <path
            d="M18 168a132 34 0 0 0 256 0"
            fill="none"
            stroke="#e04fd0"
            stroke-width="16"
            stroke-linecap="round"
          />
          <rect x="120" y="22" width="34" height="34" rx="10" fill="#6d5cf0" />
        </g>
      </svg>
    </ParallaxFloat>
  </Fragment>
</FeatureBlock>

<style>
  .feature-devices__glow {
    left: 0;
    top: -160px;
    width: 62%;
    height: calc(100% + 320px);
    background: radial-gradient(
      ellipse 100% 50% at 0% 50%,
      rgba(88, 101, 242, 0.95) 0%,
      rgba(88, 101, 242, 0.7) 18%,
      rgba(88, 101, 242, 0.3) 48%,
      rgba(88, 101, 242, 0) 100%
    );
  }
  .feature-devices__globe {
    right: calc(var(--feature-block-cx) + 19px);
    top: calc(var(--feature-block-cy) - 250px);
    width: 293px;
    height: 293px;
    filter: blur(7px);
  }
  @media (max-width: 1439px) {
    .feature-devices__globe {
      top: calc(var(--feature-block-cy) - 150px);
      width: 153px;
      height: 153px;
      filter: blur(4px);
    }
  }
  @media (max-width: 767px) {
    .feature-devices__globe {
      right: -26px;
      top: calc(var(--feature-block-cy) - 126px);
      width: 134px;
      height: 134px;
    }
  }
</style>
