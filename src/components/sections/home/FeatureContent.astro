---
/**
 * green inset left, text right.
 * Decor: blurred coin (far field, behind the previous slab), sharp near-field object at the lower-left corner,
 * characters sitting on the slab's top edge.
 */
import FeatureBlock from './FeatureBlock.astro';
import ContentDeck from '@components/graphics/loops/ContentDeck.astro';
import FeatureStars from '@components/graphics/objects/FeatureStars.astro';
import ParallaxFloat from '@components/graphics/objects/ParallaxFloat.astro';
---

<FeatureBlock
  name="content"
  heading="Always have<br>something<br>new to say"
  sectionHeight={897}
  padTop={136}
  insetFill="green"
  textPadRight={11.2}
  padLg={[165, 164]}
  padMd={[130, 80]}
  padSm={[130, 108]}
  class="feature-content feature-block--tight-gutter"
>
  <ContentDeck slot="media" />
  Blog posts drafted, published, and pushed to your socials on schedule. Market shifts detected and
  site copy adjusted to match what people are actually searching for.
  <Fragment slot="decor">
    <FeatureStars />
    <!-- near object: y -100 → 200, linear, trigger 475.5px above the next section's top -->
    <ParallaxFloat
      class="feature-content__lock"
      front
      from={-100}
      to={200}
      triggerTop="calc(100% - 475.5px)"
      floatY={7}
      floatRot={3}
      floatDur={3.4}
    >
      <svg viewBox="0 0 227 246">
        <defs>
          <linearGradient id="feature-content-lock-a" x1="0.2" y1="0" x2="0.8" y2="1">
            <stop offset="0" stop-color="#ffffff" />
            <stop offset="0.55" stop-color="#f1d9f6" />
            <stop offset="1" stop-color="#d38be8" />
          </linearGradient>
          <linearGradient id="feature-content-lock-b" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#9dffc4" />
            <stop offset="1" stop-color="#1fa862" />
          </linearGradient>
          <radialGradient id="feature-content-lock-c" cx="0.3" cy="0.2" r="0.9">
            <stop offset="0" stop-color="#fff" stop-opacity="0.9" />
            <stop offset="0.5" stop-color="#fff" stop-opacity="0" />
          </radialGradient>
        </defs>
        <g transform="rotate(-14 113 123)">
          <path
            d="M70 118V76a44 44 0 0 1 88 0v42"
            fill="none"
            stroke="#17844c"
            stroke-width="26"
            stroke-linecap="round"
            transform="translate(6 5)"
          />
          <path
            d="M70 118V76a44 44 0 0 1 88 0v42"
            fill="none"
            stroke="url(#feature-content-lock-b)"
            stroke-width="26"
            stroke-linecap="round"
          />
          <rect x="40" y="110" width="160" height="124" rx="38" fill="#b86fd6" />
          <rect
            x="32"
            y="102"
            width="160"
            height="124"
            rx="38"
            fill="url(#feature-content-lock-a)"
          />
          <rect
            x="32"
            y="102"
            width="160"
            height="124"
            rx="38"
            fill="url(#feature-content-lock-c)"
          />
          <circle cx="112" cy="152" r="15" fill="#1a2081" />
          <path d="M105 156h14l5 36h-24z" fill="#1a2081" />
        </g>
      </svg>
    </ParallaxFloat>
    <!-- characters on the top edge: body behind the slab line, legs in front of it -->
    <div class="feature-content__bot" data-feature-content-bot>
      <svg viewBox="0 0 240 190">
        <g data-feature-content-bot-drone>
          <rect x="176" y="24" width="52" height="38" rx="12" fill="#eb459e" />
          <rect x="188" y="36" width="10" height="12" rx="3" fill="#fff" />
          <rect x="206" y="36" width="10" height="12" rx="3" fill="#fff" />
          <path d="M168 20h68" stroke="#fff" stroke-width="5" stroke-linecap="round" />
          <path d="M202 20v6" stroke="#fff" stroke-width="4" />
        </g>
        <path d="M92 26V8" stroke="#c9c2ff" stroke-width="6" stroke-linecap="round" />
        <circle cx="92" cy="8" r="8" fill="#57f287" />
        <rect x="38" y="24" width="108" height="86" rx="26" fill="#d7d1ff" />
        <rect
          x="38"
          y="24"
          width="108"
          height="86"
          rx="26"
          fill="#b3a8ff"
          opacity="0.55"
          transform="translate(6 5)"
        />
        <rect x="38" y="24" width="108" height="86" rx="26" fill="#d7d1ff" />
        <rect x="52" y="44" width="80" height="42" rx="16" fill="#1a2081" />
        <g data-feature-content-bot-eyes>
          <rect x="68" y="56" width="12" height="18" rx="4" fill="#57f287" />
          <rect x="104" y="56" width="12" height="18" rx="4" fill="#57f287" />
        </g>
        <path d="M44 190v-42a34 34 0 0 1 34-34h28a34 34 0 0 1 34 34v42z" fill="#5865f2" />
        <rect x="70" y="134" width="44" height="30" rx="8" fill="#8f97ff" />
        <path d="M44 150c-18 4-26 18-26 40h22z M140 150c18 4 26 18 26 40h-22z" fill="#4450d8" />
      </svg>
    </div>
    <div class="feature-content__bot-legs" data-decor-front>
      <svg viewBox="0 0 240 70">
        <rect x="58" y="-12" width="30" height="62" rx="15" fill="#d7d1ff" />
        <rect x="52" y="38" width="42" height="26" rx="12" fill="#eb459e" />
        <rect x="100" y="-12" width="30" height="54" rx="15" fill="#d7d1ff" />
        <rect x="94" y="30" width="42" height="26" rx="12" fill="#eb459e" />
        <rect x="6" y="-8" width="34" height="26" rx="12" fill="#d7d1ff" />
        <rect x="148" y="-8" width="34" height="26" rx="12" fill="#d7d1ff" />
      </svg>
    </div>
  </Fragment>
</FeatureBlock>

<style is:global>
  section.feature-content [data-feature-block-slab] {
    background-image:
      radial-gradient(45% 70% at 78% 0%, rgba(205, 150, 225, 0.45), rgba(205, 150, 225, 0) 70%),
      linear-gradient(
        95deg,
        rgba(255, 255, 255, 0.24) 0%,
        rgba(255, 255, 255, 0.13) 60%,
        rgba(255, 255, 255, 0.04) 100%
      );
  }
  .feature-content__lock {
    left: calc(var(--feature-block-cx) - 41px);
    bottom: 37px;
    width: 227px;
    height: 246px;
  }
  .feature-content__bot {
    left: calc(var(--feature-block-cx) + 790px);
    top: calc(var(--feature-block-cy) - 190px);
    width: 240px;
    height: 190px;
  }
  .feature-content__bot-legs {
    left: calc(var(--feature-block-cx) + 790px);
    top: var(--feature-block-cy);
    width: 240px;
    height: 70px;
  }
  .feature-content__bot svg,
  .feature-content__bot-legs svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  @media (max-width: 1439px) {
    .feature-content__lock {
      bottom: 50px;
      width: 142px;
      height: 154px;
    }
    .feature-content__bot {
      left: auto;
      right: calc(var(--feature-block-cx) + 12%);
      top: calc(var(--feature-block-cy) - 124px);
      width: 156px;
      height: 124px;
    }
    .feature-content__bot-legs {
      left: auto;
      right: calc(var(--feature-block-cx) + 12%);
      width: 156px;
      height: 46px;
    }
  }
  @media (max-width: 991px) {
    .feature-content__lock {
      bottom: -34px;
    }
    .feature-content__bot {
      top: calc(var(--feature-block-cy) - 95px);
      width: 120px;
      height: 95px;
    }
    .feature-content__bot-legs {
      width: 120px;
      height: 35px;
    }
  }
  @media (max-width: 767px) {
    .feature-content__lock {
      left: -17px;
      bottom: 12px;
      width: 108px;
      height: 117px;
    }
  }
</style>

<script>
  import { gsap, motion, onPage } from '@lib/motion';
  onPage(() => {
    document.querySelectorAll<HTMLElement>('[data-feature-content-bot]').forEach((bot) => {
      motion(bot, () => {
        const drone = bot.querySelector('[data-feature-content-bot-drone]');
        const eyes = bot.querySelector('[data-feature-content-bot-eyes]');
        const a = gsap.fromTo(
          drone,
          { y: -5 },
          { y: 7, duration: 1.8, ease: 'sine.inOut', repeat: -1, yoyo: true },
        );
        const b = gsap.to(eyes, {
          scaleY: 0.1,
          transformOrigin: '50% 50%',
          duration: 0.09,
          ease: 'none',
          repeat: -1,
          yoyo: true,
          repeatDelay: 2.6,
        });
        return () => {
          a.kill();
          b.kill();
        };
      });
    });
  });
</script>
