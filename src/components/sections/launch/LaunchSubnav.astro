---
// Secondary nav bar. Sticky under the header:
// top 0 from 992px up, top 80px below. Desktop shows 4 glass tabs (one with a hover
// dropdown); <=767px collapses into a single dropdown toggle.
const links = [
  { label: 'Your Launch', href: '/launch', current: true },
  {
    label: 'What We Do',
    drop: [
      { label: 'Websites', href: '#' },
      { label: 'AI Tools & Integrations', href: '#' },
    ],
  },
  { label: 'Success Stories', href: '#launch-stories' },
  { label: 'FAQ', href: '#' },
];
const mobile = [
  { label: 'Websites', href: '#' },
  { label: 'AI Tools & Integrations', href: '#' },
  { label: 'Success Stories', href: '#launch-stories' },
  { label: 'FAQ', href: '#' },
];
---

<div data-section="quests-subnav" class="launch-subnav">
  <nav class="launch-subnav__links" aria-label="Launch pages">
    {links.map((l) =>
      l.drop ? (
        <div class="launch-subnav__drop" data-drop>
          <button
            type="button"
            class="launch-subnav__tab launch-subnav__tab--toggle"
            data-toggle
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>{l.label}</span>
            <svg
              data-chev
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="m4 6 4 4 4-4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <div class="launch-subnav__list" data-droplist hidden>
            <div class="launch-subnav__list-wr" data-dropwr>
              {l.drop.map((d) => (
                <a class="launch-subnav__droplink" data-droplink href={d.href}>
                  {d.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a
          class="launch-subnav__tab launch-subnav__tab--desk"
          data-sublink
          href={l.href}
          aria-current={l.current ? 'page' : undefined}
        >
          <span>{l.label}</span>
        </a>
      ),
    )}

    <div class="launch-subnav__mob" data-mob>
      <button
        type="button"
        class="launch-subnav__tab launch-subnav__tab--mob"
        data-mob-toggle
        aria-expanded="false"
        aria-haspopup="true"
      >
        <span>{links[0].label}</span>
        <svg
          data-mob-chev
          width="12"
          height="12"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="m3 6 5 5 5-5"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <div class="launch-subnav__moblist" data-mob-list hidden>
        {mobile.map((d) => (
          <a class="launch-subnav__tab launch-subnav__tab--mobitem" href={d.href}>
            <span>{d.label}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>
</div>

<style>
  .launch-subnav {
    position: sticky;
    top: 80px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 15px;
  }
  .launch-subnav__links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    max-width: 672px;
    margin: 0 auto;
  }
  /* gradient tile stand-in */
  .launch-subnav {
    --launch-subnav-tab-glow: radial-gradient(
      120% 150% at 50% 118%,
      #8f97ff 0%,
      var(--color-blurple) 42%,
      #4049c0 100%
    );
  }

  .launch-subnav__tab {
    position: relative;
    display: none;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    border: 0;
    margin: 0;
    cursor: pointer;
    color: var(--color-white);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    font-family: var(--font-abc-ginto-discord-nord);
    font-weight: var(--font-weight-bold);
    background-color: rgba(255, 255, 255, 0.01);
    -webkit-backdrop-filter: blur(30px);
    backdrop-filter: blur(30px);
    border-radius: 6px;
    transition: opacity 0.35s;
    overflow: hidden;
  }
  .launch-subnav__tab:focus-visible,
  .launch-subnav__droplink:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }
  .launch-subnav__tab[aria-current='page'],
  .launch-subnav__tab--mob {
    background-image: var(--launch-subnav-tab-glow);
  }
  @media (hover: hover) {
    .launch-subnav__tab--desk:hover,
    .launch-subnav__tab--toggle:hover,
    .launch-subnav__tab--mobitem:hover {
      background-image: var(--launch-subnav-tab-glow);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* <=767: one dropdown toggle */
  .launch-subnav__mob {
    position: relative;
    display: block;
  }
  .launch-subnav__tab--mob {
    display: flex;
    gap: 8px;
    min-width: 160px;
    padding: 11px 20px;
    font-size: 11px;
    line-height: 17px;
  }
  .launch-subnav__moblist {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 100%;
    padding-top: 4px;
  }
  .launch-subnav__moblist:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .launch-subnav__tab--mobitem {
    display: flex;
    padding: 11px 19px;
    font-size: 11px;
    line-height: 15px;
    background-color: #7a7eb4;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  @media (min-width: 480px) {
    .launch-subnav__tab--mob {
      min-width: 140px;
    }
  }

  /* 768+: four tabs */
  .launch-subnav__drop {
    position: relative;
    display: none;
    z-index: 900;
    border-radius: 6px;
  }
  .launch-subnav__list {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    padding-top: 4px;
  }
  .launch-subnav__list-wr {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 6px;
    border-radius: 11px;
    background-color: var(--color-white-10);
    -webkit-backdrop-filter: blur(50px);
    backdrop-filter: blur(50px);
  }
  .launch-subnav__droplink {
    display: block;
    padding: 11px 12px;
    border-radius: 6px;
    color: var(--color-white);
    text-decoration: none;
    font-family: var(--font-abc-ginto-discord);
    font-weight: var(--font-weight-medium);
    font-size: 14px;
    line-height: 20px;
    transition: opacity 0.35s;
  }
  @media (hover: hover) {
    .launch-subnav__droplink:hover {
      background-image: var(--launch-subnav-tab-glow);
    }
  }

  @media (min-width: 768px) {
    .launch-subnav {
      padding-top: 20px;
    }
    .launch-subnav__mob {
      display: none;
    }
    .launch-subnav__drop {
      display: block;
    }
    .launch-subnav__tab--desk {
      display: block;
      min-height: 38px;
      padding: 12px 24px;
      font-size: 10px;
      line-height: 17px;
    }
    .launch-subnav__tab--toggle {
      display: flex;
      gap: 8px;
      min-height: 38px;
      padding: 12px 24px 11px;
      font-size: 11px;
      line-height: 15px;
      overflow: visible;
    }
  }
  @media (min-width: 992px) {
    .launch-subnav {
      top: 0;
      padding-top: 15px;
    }
    .launch-subnav__links {
      max-width: 608px;
    }
    .launch-subnav__tab--desk {
      font-size: 11px;
      line-height: 15px;
    }
  }
  @media (min-width: 1280px) {
    .launch-subnav__links {
      max-width: 960px;
    }
    .launch-subnav__tab--desk {
      min-height: 55px;
      padding: 15.5px 32px;
      font-size: 14px;
      line-height: 24px;
    }
    .launch-subnav__tab--toggle {
      min-height: 55px;
      padding: 15px 32px;
      font-size: 14px;
      line-height: 24px;
    }
    .launch-subnav__tab--toggle svg {
      height: 25px;
    }
    .launch-subnav__list {
      padding-top: 8px;
    }
    .launch-subnav__droplink {
      padding: 11px 14px;
      font-size: var(--text-body);
      line-height: 24px;
    }
  }
</style>

<script>
  import { gsap, ease, onPage, reducedMotion } from '@lib/motion';

  onPage((signal) => {
    document.querySelectorAll<HTMLElement>('[data-section="quests-subnav"]').forEach((root) => {
      const reduce = reducedMotion();

      // desktop dropdown: opens on hover (delay 0) / focus / click; chevron 0 -> 180deg, 100ms ease
      const drop = root.querySelector<HTMLElement>('[data-drop]');
      if (drop) {
        const btn = drop.querySelector<HTMLButtonElement>('[data-toggle]')!;
        const list = drop.querySelector<HTMLElement>('[data-droplist]')!;
        const chev = drop.querySelector<SVGElement>('[data-chev]')!;
        let open = false;
        let openedAt = 0;
        const set = (v: boolean) => {
          if (v === open) return;
          open = v;
          if (v) openedAt = performance.now();
          list.hidden = !v;
          btn.setAttribute('aria-expanded', String(v));
          gsap.to(chev, {
            rotation: v ? 180 : 0,
            duration: reduce ? 0 : 0.1,
            ease: ease.css,
            overwrite: true,
          });
        };
        drop.addEventListener(
          'pointerenter',
          (e) => {
            if (e.pointerType === 'mouse') set(true);
          },
          { signal },
        );
        drop.addEventListener(
          'pointerleave',
          (e) => {
            if (e.pointerType === 'mouse') set(false);
          },
          { signal },
        );
        btn.addEventListener(
          'click',
          (e) => {
            if ((e as PointerEvent).pointerType !== 'mouse' && performance.now() - openedAt > 300)
              set(!open);
          },
          { signal },
        );
        drop.addEventListener('focusin', () => set(true), { signal });
        drop.addEventListener(
          'focusout',
          (e) => {
            if (!drop.contains(e.relatedTarget as Node)) set(false);
          },
          { signal },
        );
        drop.addEventListener(
          'keydown',
          (e) => {
            if (e.key === 'Escape') {
              set(false);
              btn.focus();
            }
          },
          { signal },
        );
      }

      // mobile dropdown: click toggles
      const mob = root.querySelector<HTMLElement>('[data-mob]');
      if (mob) {
        const btn = mob.querySelector<HTMLButtonElement>('[data-mob-toggle]')!;
        const list = mob.querySelector<HTMLElement>('[data-mob-list]')!;
        const chev = mob.querySelector<SVGElement>('[data-mob-chev]')!;
        const set = (v: boolean) => {
          list.hidden = !v;
          btn.setAttribute('aria-expanded', String(v));
          gsap.to(chev, {
            rotation: v ? 180 : 0,
            duration: reduce ? 0 : 0.1,
            ease: ease.css,
            overwrite: true,
          });
        };
        btn.addEventListener('click', () => set(list.hidden === true), { signal });
        document.addEventListener(
          'click',
          (e) => {
            if (!mob.contains(e.target as Node)) set(false);
          },
          { signal },
        );
        mob.addEventListener(
          'keydown',
          (e) => {
            if (e.key === 'Escape') {
              set(false);
              btn.focus();
            }
          },
          { signal },
        );
      }
    });
  });
</script>
