---
// Partner strip.
// Wordmarks are invented placeholder brands, drawn here; not real companies.
const SETS = 5;
---

<section data-section="quests-logos" class="launch-logos">
  <div class="launch-logos__head">
    <h2 class="launch-h2">Trusted by local brands</h2>
  </div>
  <div class="launch-logos__band" aria-hidden="true"></div>
  <div class="launch-logos__clip">
    <div class="launch-logos__track" data-track>
      {Array.from({ length: SETS }).map((_, i) => (
        <div class="launch-logos__set" data-set aria-hidden={i > 0 ? 'true' : undefined}>
          <div class="launch-logos__logo launch-logos__logo--a">
            <svg viewBox="0 0 40 40" aria-hidden="true">
              <path d="M20 2 38 20 20 38 2 20Z" fill="#fff" />
              <path d="M20 12l8 8-8 8-8-8Z" fill="#000" opacity=".55" />
            </svg>
            <span>
              Kestrel<small>&amp; Co.</small>
            </span>
          </div>
          <div class="launch-logos__logo launch-logos__logo--b">
            <span>MOONFERN</span>
          </div>
          <div class="launch-logos__logo launch-logos__logo--c">
            <span>
              Tide
              <br />
              Water
            </span>
          </div>
          <div class="launch-logos__logo launch-logos__logo--d">
            <svg viewBox="0 0 40 40" aria-hidden="true">
              <circle cx="20" cy="20" r="18" fill="none" stroke="#fff" stroke-width="4" />
              <path d="M8 26 20 10l12 16Z" fill="#fff" />
            </svg>
            <span>Oakline</span>
          </div>
          <div class="launch-logos__logo launch-logos__logo--e">
            <span>PIXEL</span>
            <span>HARBOR</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .launch-logos {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 50px 0 32px;
    overflow: clip;
  }
  .launch-logos__head {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    width: 100%;
    max-width: 1360px;
    padding: 0 var(--spacing-16) 24px;
  }
  .launch-logos__head .launch-h2 {
    margin-bottom: var(--spacing-24);
  }
  .launch-logos__band {
    position: absolute;
    left: 0;
    right: 0;
    top: 102px;
    height: 192px;
    filter: blur(5px);
    background: radial-gradient(
      60% 62% at 50% 55%,
      rgba(155, 47, 128, 0.62) 0%,
      rgba(120, 40, 110, 0.36) 45%,
      rgba(74, 23, 61, 0) 100%
    );
  }
  .launch-logos__clip {
    position: relative;
    width: 100%;
    height: 134px;
    overflow: clip;
  }
  .launch-logos__track {
    position: relative;
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }
  .launch-logos__set {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 70px;
    box-sizing: border-box;
    width: 920px;
    min-height: 118px;
    margin: 0 70px 16px 0;
    flex: none;
    --s: 0.673;
  }
  .launch-logos__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(12px * var(--s));
    height: calc(113px * var(--s));
    flex: none;
    color: var(--color-white);
    font-family: var(--font-abc-ginto-discord-nord);
    font-weight: var(--font-weight-extrabold);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .launch-logos__logo svg {
    width: calc(52px * var(--s));
    height: calc(52px * var(--s));
    flex: none;
  }
  .launch-logos__logo--a {
    width: calc(188px * var(--s));
    font-size: calc(24px * var(--s));
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .launch-logos__logo--a span {
    display: flex;
    flex-direction: column;
  }
  .launch-logos__logo--a small {
    font-family: var(--font-abc-ginto-discord);
    font-weight: var(--font-weight-medium);
    font-size: 0.5em;
    letter-spacing: 0.3em;
    margin-top: 4px;
  }
  .launch-logos__logo--b {
    width: calc(254px * var(--s));
    font-size: calc(34px * var(--s));
    letter-spacing: 0.04em;
    transform: skewX(-10deg);
  }
  .launch-logos__logo--c {
    width: calc(188px * var(--s));
    font-size: calc(36px * var(--s));
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .launch-logos__logo--c span {
    padding: calc(10px * var(--s)) calc(14px * var(--s));
    border-radius: calc(12px * var(--s));
    background: var(--color-white);
    color: #2a1030;
  }
  .launch-logos__logo--d {
    width: calc(141px * var(--s));
    flex-direction: column;
    gap: calc(6px * var(--s));
    font-family: var(--font-abc-ginto-discord);
    font-weight: var(--font-weight-medium);
    font-size: calc(20px * var(--s));
    letter-spacing: 0.24em;
  }
  .launch-logos__logo--e {
    width: calc(130px * var(--s));
    flex-direction: column;
    gap: 0;
    font-size: calc(22px * var(--s));
    line-height: 1.05;
  }
  .launch-logos__logo--e span:last-child {
    font-size: 0.78em;
    letter-spacing: 0.08em;
  }
  @media (min-width: 480px) {
    .launch-logos {
      padding-top: 60px;
    }
    .launch-logos__head {
      padding: 0 var(--spacing-24) var(--spacing-40);
    }
    .launch-logos__band {
      top: 104px;
    }
  }
  @media (min-width: 992px) {
    .launch-logos {
      padding-bottom: 60px;
    }
    .launch-logos__band {
      top: 75px;
      height: 240px;
    }
  }
  @media (min-width: 1440px) {
    .launch-logos {
      padding: 80px 0;
    }
    .launch-logos__head {
      padding-bottom: var(--spacing-48);
    }
    .launch-logos__band {
      top: 116px;
    }
    .launch-logos__clip {
      height: 138px;
    }
    .launch-logos__set {
      width: 1350px;
      gap: 110px;
      margin: 0 110px 20px 0;
      --s: 1;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  const mm = gsap.matchMedia();
  // Looping marquee, linear: desktop x 0 -> -50% of the 7300px track in 70s
  // (52.14px/s); tablet 0 -> -780px in 20s (39px/s); phone 0 -> -930px in 20s (46.5px/s).
  // Same velocities here, but the loop distance is exactly one logo set, so it never jumps.
  const run = (speed: number) => () => {
    const tweens: gsap.core.Tween[] = [];
    document
      .querySelectorAll<HTMLElement>('[data-section="quests-logos"] [data-track]')
      .forEach((track) => {
        const set = track.querySelector<HTMLElement>('[data-set]')!;
        const cs = getComputedStyle(set);
        const dist = set.offsetWidth + parseFloat(cs.marginRight);
        tweens.push(
          gsap.fromTo(
            track,
            { x: 0 },
            { x: -dist, duration: dist / speed, ease: 'none', repeat: -1 },
          ),
        );
      });
    return () => tweens.forEach((t) => t.kill());
  };
  mm.add('(min-width: 992px) and (prefers-reduced-motion: no-preference)', run(3650 / 70));
  mm.add(
    '(min-width: 768px) and (max-width: 991px) and (prefers-reduced-motion: no-preference)',
    run(780 / 20),
  );
  mm.add('(max-width: 767px) and (prefers-reduced-motion: no-preference)', run(930 / 20));
</script>
