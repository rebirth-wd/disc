---
// Reference: div.download-banner.is-download.is_new-2026 (1680: y 4803–5523). Centered heading + line + dropdown CTA,
// two floating objects.
// Motion (IX2 a-610 "download-scroll", desktop ≥992 only): while the banner scrolls through the viewport (0→100%),
// left object y 0→120px, right object y -100→30px, linear, smoothing 50. Dropdown chevron: see DlDropdown.
import DlDropdown from './DlDropdown.astro';
import HeroArt from './HeroArt.astro';
const items = [
  'Portfolio',
  'Business landing page',
  'Marketing site',
  'Documentation hub',
  'Personal brand',
  'AI Tools',
  'Maintenance',
  'Something else',
].map((label) => ({ label }));
---

<section data-section="download-banner" class="db text-white">
  <div class="db-pad">
    <div class="db-container">
      <div class="db-box">
        <h2 class="db-h2">
          Ready for <br />a rebirth?
        </h2>
        <div>
          <p class="db-p">
            A focused prototype can be ready in just a few days. Tell us what you need.
          </p>
        </div>
        <div class="db-cta">
          <DlDropdown
            id="db-start"
            label="Start Your Project"
            variant="blurple"
            z={100}
            items={items}
          />
        </div>
        <HeroArt kind="flask" class="db-decor db-decor-1" data-db-decor1 />
        <HeroArt kind="bolt" class="db-decor db-decor-2" data-db-decor2 />
      </div>
    </div>
  </div>
</section>

<style>
  /* reference background image: black at the top easing to indigo (#19174b centre / #121134 edges) at the bottom */
  .db {
    position: relative;
    z-index: 98;
    padding: 150px 0 240px;
    text-align: center;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.3)),
      linear-gradient(
        180deg,
        #000 0%,
        #000 8%,
        #020206 14%,
        #04040d 27%,
        #080717 41%,
        #0c0b24 55%,
        #100f2f 69%,
        #14133d 83%,
        #181648 97%,
        #19174b 100%
      );
  }
  .db-pad {
    padding: 0 6vw;
  }
  .db-container {
    position: relative;
    z-index: 2;
    max-width: 944px;
    margin: 0 auto;
  }
  .db-box {
    position: relative;
    max-width: 400px;
    margin: 0 auto;
  }
  .db-h2 {
    font-family: var(--font-abc-ginto-discord-nord);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    color: var(--color-white);
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.32px;
    margin: 0 0 var(--spacing-16);
  }
  .db-p {
    font-family: var(--font-abc-ginto-discord);
    font-size: var(--text-body);
    line-height: 22px;
    margin: 0;
    color: var(--color-white);
  }
  .db-cta {
    display: inline-flex;
    margin-top: 32px;
    position: relative;
    z-index: 100;
  }
  .db :global(.db-decor) {
    position: absolute;
    width: 120px;
    height: 120px;
    will-change: transform;
  }
  .db :global(.db-decor-1) {
    z-index: 1;
    top: 0;
    left: 0;
    margin: -148.8px 0 0 -8px;
    rotate: 15deg;
  }
  .db :global(.db-decor-2) {
    right: -24px;
    bottom: -136px;
  }

  @media (min-width: 768px) {
    .db {
      padding: 140px 0 288px;
    }
    .db-pad {
      padding: 0 var(--spacing-40);
    }
    .db-box {
      max-width: 590px;
    }
    .db-h2 {
      font-size: 56px;
      letter-spacing: -1.68px;
      margin-bottom: var(--spacing-24);
    }
    .db-p {
      font-size: var(--text-body-xl);
      line-height: 26px;
    }
    .db-cta {
      margin-top: var(--spacing-40);
    }
    .db :global(.db-decor) {
      width: 160px;
      height: 160px;
    }
    .db :global(.db-decor-1) {
      margin: -140px 0 0 -72px;
      rotate: 12deg;
    }
    .db :global(.db-decor-2) {
      right: -84.8px;
      bottom: -122.4px;
    }
  }
  @media (min-width: 992px) {
    .db-pad {
      padding: 0 80px;
    }
    .db :global(.db-decor) {
      width: 180px;
      height: 180px;
    }
    .db :global(.db-decor-1) {
      margin: -140px 0 0 -180px;
      rotate: none;
    }
    .db :global(.db-decor-2) {
      right: -180px;
    }
  }
  @media (min-width: 1440px) {
    .db {
      padding: 160px 0 288px;
    }
    .db-pad {
      padding: 0 120px;
    }
    .db-container {
      max-width: 1538px;
    }
    .db-box {
      max-width: 897px;
    }
    .db-h2 {
      font-size: 72px;
      line-height: 0.9;
      letter-spacing: -2.16px;
    }
    .db :global(.db-decor) {
      width: 200px;
      height: 200px;
    }
    .db :global(.db-decor-1) {
      margin: -100px 0 0 -187px;
    }
    .db :global(.db-decor-2) {
      right: -199px;
      bottom: -104px;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const root = document.querySelector<HTMLElement>('[data-section="download-banner"]');
  if (root) {
    const mm = gsap.matchMedia();
    mm.add(
      '(min-width: 992px)',
      () => {
        // resting state on the reference (also with reduced motion): right object sits at y -100
        gsap.set('[data-db-decor2]', { y: -100 });
      },
      root,
    );
    mm.add(
      '(prefers-reduced-motion: no-preference) and (min-width: 992px)',
      () => {
        gsap
          .timeline({
            defaults: { ease: 'none' },
            scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: 0.5 },
          })
          .fromTo('[data-db-decor1]', { y: 0 }, { y: 120 }, 0)
          .fromTo('[data-db-decor2]', { y: -100 }, { y: 30 }, 0);
      },
      root,
    );
  }
</script>
