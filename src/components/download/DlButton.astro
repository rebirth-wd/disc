---
// 48px-tall button used on the "get started" page (reference: .btn-download.is_white, 48px, 16px/500/24px).
// The shared global Button is the 65px home CTA; this page's reference buttons measure 48px, so they live here.
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'a'> {
  href?: string;
  radius?: 12 | 8;
  class?: string;
}
const { href = '#', radius = 12, class: cls = '', ...rest } = Astro.props;
---

<a href={href} class:list={['dl-btn', radius === 8 && 'dl-btn--r8', cls]} {...rest}>
  {Astro.slots.has('icon') && (
    <span class="dl-btn__icon" aria-hidden="true">
      <slot name="icon" />
    </span>
  )}
  <span>
    <slot />
  </span>
</a>

<style>
  .dl-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-8);
    box-sizing: border-box;
    max-height: 48px;
    padding: 13.5px var(--spacing-20);
    border-radius: var(--radius-buttons);
    background-color: var(--surface-white-control);
    color: var(--color-black);
    font-family: var(--font-abc-ginto-discord);
    font-size: var(--text-nav);
    font-weight: var(--font-weight-medium);
    line-height: 24px;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.3s;
  }
  .dl-btn--r8 {
    border-radius: 8px;
  }
  .dl-btn__icon {
    display: flex;
    width: 24px;
    height: 24px;
    flex: none;
  }
  .dl-btn__icon :global(svg) {
    width: 24px;
    height: 24px;
    display: block;
  }
  .dl-btn:focus-visible {
    outline: 2px solid var(--color-signal-green);
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .dl-btn:hover {
      background-color: var(--color-fog);
    }
  }
  @media (min-width: 992px) {
    .dl-btn {
      padding: 13.5px var(--spacing-24);
    }
  }
</style>
