---
// Reference: div.download_hero.is_download (1680: y 0–1347). h1 + copy + CTA + device visual, with three floating objects.
// Motion (IX2):
//  a-888 "scroll-downloads 3" — while .download_layout scrolls through the viewport, progress 65%→100%:
//        token y 0→150px, rocket y 0→120px (linear, smoothing 50). Desktop ("main", ≥992px) only.
//  a-612 "downloads-hero-wumpus" — looping: tuft skewY 0→10deg, rotate 0→10deg, scale 1→1.1 over 2000ms, back over 2000ms (linear),
//        started when the visual scrolls into view. ≥768px.
//  CSS  — CTA glow: opacity 0→1, 0.5s ease on hover/focus/active.
import HeroVisual from './HeroVisual.astro';
import HeroArt from './HeroArt.astro';
---
<section data-section="download-hero" data-nav-trigger class="dh bg-black text-white">
  <div class="dh-bg" aria-hidden="true"></div>
  <div class="dh-pad">
    <div class="dh-container">
      <div class="dh-layout" data-dh-layout>
        <div class="dh-title-wr">
          <HeroArt kind="token" class="dh-token" data-dh-token />
          <div class="dh-title">
            <h1 class="dh-h1 font-abc-ginto-discord-nord font-bold uppercase text-white">
              Start your<br class="dh-br" /> <span class="dh-web">web</span>site wherever<br class="dh-br" /> you work
            </h1>
          </div>
          <div class="dh-copy">
            <p class="dh-p font-abc-ginto-discord font-normal text-white">
              Rebirth Online builds fast, secure, static-first websites on a modern web architecture. Start on
              desktop, mobile or by phone.
            </p>
            <div class="dh-spacer"></div>
          </div>
          <div class="dh-btn-wr">
            <a href="#download-platforms" class="dh-btn">
              <svg class="dh-btn-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M10 2.5v10m0 0 4-4m-4 4-4-4M3.5 16.5h13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="dh-btn-text">Start Your Project</span>
            </a>
            <span class="dh-btn-hover"></span>
            <span class="dh-btn-bg"></span>
          </div>
        </div>
      </div>
      <div class="dh-visual" data-dh-visual>
        <HeroArt kind="rocket" class="dh-rocket" data-dh-rocket />
        <HeroVisual />
        <div class="dh-egg-wr">
          <HeroArt kind="tuft" class="dh-tuft" data-dh-tuft />
          <HeroArt kind="egg" class="dh-egg" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dh { position: relative; display: flex; justify-content: center; align-items: flex-start; padding-top: 112px; text-align: center; }
  /* reference BG-downloads.webp: blurple glow at the top centre falling to black by ~1000px (sampled from the capture) */
  .dh-bg {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.32) 0%, rgba(0, 0, 0, 0.08) 28%, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.08) 72%, rgba(0, 0, 0, 0.32) 100%),
      linear-gradient(180deg, #4b57d1 0px, #4551c2 100px, #3e49b0 200px, #37409a 300px, #2e3682 400px, #252b68 500px, #1b1f4d 600px, #121534 700px, #0b0d22 800px, #030308 1000px, #000 1100px);
  }
  .dh-pad { position: relative; flex: 1; width: 100%; padding: 0 6vw; box-sizing: border-box; }
  .dh-container { position: relative; z-index: 2; max-width: 944px; margin: 0 auto; }
  .dh-layout { display: flex; flex-direction: column; align-items: center; }
  .dh-title-wr { position: relative; display: flex; flex-direction: column; align-items: center; max-width: 710px; }
  .dh-title { width: 100%; max-width: 710px; margin: 0 auto; }
  .dh-h1 { font-size: min(9.75vw, 38px); line-height: 1; letter-spacing: -0.03em; margin: 0 0 16px; text-align: center; }
  .dh-br { display: none; }
  .dh-p { font-size: var(--text-body); line-height: 22px; margin: 0; }
  .dh-spacer { padding-bottom: 32px; }

  .dh-btn-wr {
    position: relative; display: flex; justify-content: center; align-items: center; overflow: hidden;
    padding: 2px; border-radius: var(--radius-buttons); color: var(--color-white);
    font-size: 14px; font-weight: var(--font-weight-medium); line-height: 1.3; white-space: nowrap;
  }
  .dh-btn { position: relative; z-index: 2; display: flex; align-items: center; box-sizing: border-box; height: 48px; padding: 15px var(--spacing-24) 14px; border-radius: var(--radius-buttons); color: inherit; text-decoration: none; }
  .dh-btn:focus-visible { outline: 2px solid var(--color-signal-green); outline-offset: -2px; }
  .dh-btn-icon { width: 18px; height: 18px; margin-right: 7px; flex: none; }
  .dh-btn-text { position: relative; z-index: 3; }
  .dh-btn-hover {
    position: absolute; z-index: 1; top: 85%; width: 150%; height: 71px; border-radius: 100%;
    background-color: #1f1d5d; filter: blur(30px); opacity: 0; transition: opacity 0.5s ease; pointer-events: none;
  }
  .dh-btn-wr:hover .dh-btn-hover, .dh-btn-wr:active .dh-btn-hover, .dh-btn-wr:focus-within .dh-btn-hover { opacity: 1; }
  .dh-btn-bg { position: absolute; inset: 0; margin: 2px; border-radius: var(--radius-buttons); background-color: var(--surface-blurple-action); }

  .dh-visual { position: relative; margin-top: 56px; }
  .dh :global(.dh-token) { display: none; position: absolute; top: 0; left: 0; will-change: transform; }
  .dh :global(.dh-rocket) { position: absolute; z-index: 1; top: 0; right: -22.4px; width: 89px; height: 89px; margin-top: -46.4px; will-change: transform; }
  .dh-egg-wr { display: none; position: absolute; z-index: 2; left: 0; bottom: 0; text-align: left; }
  .dh :global(.dh-tuft) { display: block; position: relative; top: 19px; left: 11px; width: 41%; height: auto; margin-bottom: -16px; will-change: transform; }
  .dh :global(.dh-egg) { display: block; width: 100%; height: auto; }

  @media (min-width: 768px) {
    .dh { padding-top: 160px; }
    .dh-pad { padding: 0 var(--spacing-40); }
    .dh-h1 { font-size: 56px; letter-spacing: -1.68px; margin-bottom: 20px; }
    .dh-p { font-size: var(--text-body-xl); line-height: 26px; }
    .dh-btn-wr { font-size: var(--text-nav); }
    .dh-btn-icon { width: 20px; height: 20px; margin-right: 8.5px; }
    .dh-visual { margin-top: 87px; }
    .dh :global(.dh-token) { display: block; width: 128px; height: 128px; margin: -93.8px 0 0 -59.2px; }
    .dh :global(.dh-rocket) { right: -30px; width: 150px; height: 150px; margin-top: -160px; }
    .dh-egg-wr { display: block; width: 192px; margin: 0 0 -51.2px -41.4px; }
  }
  @media (min-width: 992px) {
    .dh-pad { padding: 0 80px; }
    .dh-title-wr { max-width: 774px; }
    .dh-br { display: inline; }
    .dh-web { display: none; }
    .dh-spacer { padding-bottom: var(--spacing-40); }
    .dh :global(.dh-token) { width: 137px; height: 137px; margin: -73px 0 0 -93.2px; }
    .dh :global(.dh-rocket) { margin-top: -201.2px; }
    .dh-egg-wr { margin-bottom: -33.6px; }
  }
  @media (min-width: 1440px) {
    .dh { padding-top: var(--spacing-176); }
    .dh-pad { padding: 0 120px; }
    .dh-container { max-width: 1538px; }
    .dh-title-wr, .dh-title { max-width: 924px; }
    .dh-h1 { font-size: 72px; line-height: 0.9; letter-spacing: -2.16px; margin-bottom: var(--spacing-24); }
    .dh-btn-icon { margin-right: 13.5px; }
    .dh-visual { max-width: 961px; margin: 120px auto 0; }
    .dh :global(.dh-token) { width: 170px; height: 170px; margin: -68px 0 0 -186px; }
    .dh :global(.dh-rocket) { right: -82px; width: 170px; height: 170px; margin-top: -169.6px; }
    .dh-egg-wr { width: 282px; margin: 0 0 -73.6px -78px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('[data-section="download-hero"]');
  if (root) {
    const mm = gsap.matchMedia();
    // a-888: SCROLLING_IN_VIEW on the title layout. Webflow progress = (viewportBottom - elTop) / (viewportH + elH);
    // that is exactly start "top bottom" → end "bottom top". Keyframes: 65% → y 0, 100% → y 150 / 120 (linear).
    mm.add('(prefers-reduced-motion: no-preference) and (min-width: 992px)', () => {
      const layout = root.querySelector('[data-dh-layout]');
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: layout, start: 'top bottom', end: 'bottom top', scrub: 0.5 },
      });
      tl.to({}, { duration: 0.65 })
        .fromTo('[data-dh-token]', { y: 0 }, { y: 150, duration: 0.35 }, 0.65)
        .fromTo('[data-dh-rocket]', { y: 0 }, { y: 120, duration: 0.35 }, 0.65);
    }, root);
    // a-612: looping tuft wobble, 2s out + 2s back, linear; starts when the visual enters the viewport.
    mm.add('(prefers-reduced-motion: no-preference) and (min-width: 768px)', () => {
      const tuft = root.querySelector('[data-dh-tuft]');
      gsap.set(tuft, { transformOrigin: '50% 50%' });
      const loop = gsap.timeline({ repeat: -1, paused: true, defaults: { ease: 'none', duration: 2 } })
        .fromTo(tuft, { skewY: 0, rotation: 0, scale: 1 }, { skewY: 10, rotation: 10, scale: 1.1 })
        .to(tuft, { skewY: 0, rotation: 0, scale: 1 });
      ScrollTrigger.create({
        trigger: root.querySelector('[data-dh-visual]'), start: 'top bottom', end: 'bottom top',
        onEnter: () => loop.play(), onEnterBack: () => loop.play(), onLeave: () => loop.pause(), onLeaveBack: () => loop.pause(),
      });
    }, root);
  }
</script>
