---
// Original floating objects for the hero (replace the reference's 3D coin / robot / mascot renders).
// kind: 'token' (spark coin) | 'rocket' | 'egg' (hatchling body) | 'tuft' (the animated feather above the egg)
//       'flask' | 'bolt' (banner decorations)
interface Props { kind: 'token' | 'rocket' | 'egg' | 'tuft' | 'flask' | 'bolt'; class?: string; [key: string]: any }
const { kind, class: cls = '', ...rest } = Astro.props;
---
{kind === 'token' && (
  <svg class={cls} {...rest} viewBox="0 0 170 170" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="dl-tk-a" x1="40" y1="20" x2="130" y2="150" gradientUnits="userSpaceOnUse"><stop stop-color="#f3ecff" /><stop offset="1" stop-color="#b9a4ff" /></linearGradient>
      <linearGradient id="dl-tk-b" x1="30" y1="40" x2="150" y2="150" gradientUnits="userSpaceOnUse"><stop stop-color="#eb459e" /><stop offset="1" stop-color="#7a5cff" /></linearGradient>
    </defs>
    <g transform="rotate(-16 85 85)">
      <ellipse cx="93" cy="90" rx="54" ry="64" fill="url(#dl-tk-b)" />
      <path d="M85 26h8v128h-8z" fill="url(#dl-tk-b)" />
      <ellipse cx="82" cy="86" rx="54" ry="64" fill="url(#dl-tk-a)" />
      <ellipse cx="82" cy="86" rx="42" ry="51" fill="#d9ccff" />
      <path d="M82 50l9 25 24 11-24 11-9 25-9-25-24-11 24-11 9-25Z" fill="#5865f2" />
      <path d="M60 52c6-8 14-13 22-14" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".8" />
    </g>
  </svg>
)}
{kind === 'rocket' && (
  <svg class={cls} {...rest} viewBox="0 0 170 170" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="dl-rk-a" x1="50" y1="20" x2="120" y2="120" gradientUnits="userSpaceOnUse"><stop stop-color="#ffffff" /><stop offset="1" stop-color="#c9ccff" /></linearGradient>
      <linearGradient id="dl-rk-f" x1="85" y1="118" x2="85" y2="165" gradientUnits="userSpaceOnUse"><stop stop-color="#fee75c" /><stop offset="1" stop-color="#eb459e" /></linearGradient>
    </defs>
    <g transform="rotate(-24 85 85)">
      <path d="M70 120l15 44 15-44-15 10-15-10Z" fill="url(#dl-rk-f)" />
      <path d="M52 92 30 124l28-8 4-22-10-2ZM118 92l22 32-28-8-4-22 10-2Z" fill="#eb459e" />
      <path d="M85 8c22 18 34 44 34 72v40H51V80C51 52 63 26 85 8Z" fill="url(#dl-rk-a)" />
      <path d="M85 8c10 8 18 18 24 29H61C67 26 75 16 85 8Z" fill="#5865f2" />
      <rect x="67" y="56" width="36" height="36" rx="10" fill="#1a2081" />
      <path d="M85 62l4 9 9 3-9 4-4 9-4-9-9-4 9-3 4-9Z" fill="#57f287" />
      <rect x="51" y="108" width="68" height="12" fill="#5865f2" />
    </g>
  </svg>
)}
{kind === 'tuft' && (
  <svg class={cls} {...rest} viewBox="0 0 127 102" fill="none" aria-hidden="true">
    <defs><linearGradient id="dl-tf" x1="20" y1="10" x2="110" y2="95" gradientUnits="userSpaceOnUse"><stop stop-color="#fee75c" /><stop offset="1" stop-color="#eb459e" /></linearGradient></defs>
    <path d="M14 98C2 66 18 34 48 22c-6 18-2 30 8 38C58 34 76 12 108 6c-12 22-10 40 2 54-22-4-36 4-44 22-10-14-28-10-52 16Z" fill="url(#dl-tf)" />
    <path d="M26 86c6-22 18-36 36-44M70 68c6-18 16-32 30-42" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".55" />
  </svg>
)}
{kind === 'egg' && (
  <svg class={cls} {...rest} viewBox="0 0 282 343" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="dl-eg-a" x1="70" y1="30" x2="230" y2="300" gradientUnits="userSpaceOnUse"><stop stop-color="#8ea0ff" /><stop offset="1" stop-color="#4a3df0" /></linearGradient>
      <linearGradient id="dl-eg-b" x1="60" y1="170" x2="230" y2="330" gradientUnits="userSpaceOnUse"><stop stop-color="#ffffff" /><stop offset="1" stop-color="#cfd3ff" /></linearGradient>
    </defs>
    <path d="M96 300v34h30v-30ZM162 304v30h30v-34Z" fill="#3b2fd6" />
    <path d="M141 12c62 0 106 76 106 158 0 84-44 142-106 142S35 254 35 170C35 88 79 12 141 12Z" fill="url(#dl-eg-a)" />
    <path d="M35 176l30-22 26 30 30-34 28 34 30-32 28 30 40-12c-2 82-46 142-106 142S35 256 35 176Z" fill="url(#dl-eg-b)" />
    <path d="M70 226l22 12 22-12 22 12 22-12 22 12 22-12" stroke="#b9bfff" stroke-width="5" stroke-linejoin="round" />
    <rect x="92" y="98" width="30" height="38" rx="15" fill="#11145c" />
    <rect x="160" y="98" width="30" height="38" rx="15" fill="#11145c" />
    <circle cx="112" cy="110" r="6" fill="#fff" /><circle cx="180" cy="110" r="6" fill="#fff" />
    <path d="M124 146c10 10 24 10 34 0" stroke="#11145c" stroke-width="7" stroke-linecap="round" />
    <path d="M247 170l30-26 5 16-30 34ZM35 172 8 190l4 16 26-12Z" fill="#6f7bff" />
    <path d="M78 62c14-22 34-34 56-36" stroke="#fff" stroke-width="8" stroke-linecap="round" opacity=".45" />
  </svg>
)}
{kind === 'flask' && (
  <svg class={cls} {...rest} viewBox="0 0 200 200" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="dl-fl-a" x1="60" y1="30" x2="150" y2="180" gradientUnits="userSpaceOnUse"><stop stop-color="#ffffff" /><stop offset="1" stop-color="#c2c6ff" /></linearGradient>
      <linearGradient id="dl-fl-b" x1="50" y1="110" x2="150" y2="180" gradientUnits="userSpaceOnUse"><stop stop-color="#eb459e" /><stop offset="1" stop-color="#7a5cff" /></linearGradient>
    </defs>
    <g transform="rotate(-14 100 100)">
      <path d="M78 26h44v14h-8v40l44 78c6 12-2 24-14 24H56c-12 0-20-12-14-24l44-78V40h-8V26Z" fill="url(#dl-fl-a)" />
      <path d="M68 120h64l22 40c4 8-2 14-10 14H56c-8 0-14-6-10-14l22-40Z" fill="url(#dl-fl-b)" />
      <circle cx="88" cy="146" r="8" fill="#fff" opacity=".7" /><circle cx="116" cy="134" r="5" fill="#fff" opacity=".7" />
      <path d="M112 2c14 0 22 10 20 22-12 2-22-6-20-22Z" fill="#57f287" /><circle cx="96" cy="12" r="6" fill="#fee75c" />
    </g>
  </svg>
)}
{kind === 'bolt' && (
  <svg class={cls} {...rest} viewBox="0 0 200 200" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="dl-bt-a" x1="40" y1="30" x2="160" y2="180" gradientUnits="userSpaceOnUse"><stop stop-color="#e9ebff" /><stop offset="1" stop-color="#9aa3ff" /></linearGradient>
      <linearGradient id="dl-bt-b" x1="70" y1="50" x2="130" y2="150" gradientUnits="userSpaceOnUse"><stop stop-color="#fee75c" /><stop offset="1" stop-color="#eb459e" /></linearGradient>
    </defs>
    <g transform="rotate(12 100 100)">
      <path d="M100 14l70 40v84l-70 44-70-44V54l70-40Z" fill="#5865f2" transform="translate(8 8)" />
      <path d="M100 14l70 40v84l-70 44-70-44V54l70-40Z" fill="url(#dl-bt-a)" />
      <path d="M112 44 70 106h28l-10 50 44-64h-28l8-48Z" fill="url(#dl-bt-b)" />
    </g>
  </svg>
)}
