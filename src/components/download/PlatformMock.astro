---
// Original UI mock-ups that sit inside the gradient media frames (reference: product screenshots .image-all).
// kind 'desktop' 1096×1544 crop of a window · 'phone' 329×605 handset · 'edge' 409×506 panel over a photo · 'chat' assistant panel.
import { Image } from 'astro:assets';
import workspace from '../../assets/photos/download-workspace.jpg';
import street from '../../assets/photos/download-street.jpg';
import city from '../../assets/photos/download-city.jpg';
import room from '../../assets/photos/download-room.jpg';
import neon from '../../assets/photos/download-neon.jpg';
import LogoMark from '../global/LogoMark.astro';
interface Props { kind: 'desktop' | 'phone' | 'edge' | 'chat' }
const { kind } = Astro.props;
const sections = ['Headers', 'Heros', 'Features', 'Content', 'Call-to-Action', 'Pricing', 'Testimonial', 'Contact', 'Footers'];
const tones = ['#eb459e', '#5865f2', '#57f287', '#fee75c', '#eb459e', '#5865f2'];
---
{kind === 'desktop' && (
  <div class="pm pm-desktop" aria-hidden="true">
    <div class="pm-rail">
      <b class="is-on"><LogoMark size={20} /></b>
      {tones.map((t) => <b style={`background:${t}`}></b>)}
    </div>
    <div class="pm-list">
      <div class="pm-list-photo"><Image src={neon} alt="" widths={[200, 400]} sizes="160px" /><span>The Stack</span></div>
      <ul>{sections.map((s, i) => <li class:list={[i === 2 && 'is-on']}><em>#</em>{s}</li>)}</ul>
    </div>
    <div class="pm-feed">
      <div class="pm-feed-head"><em>#</em> features <span>Showcase your services</span></div>
      <div class="pm-msg"><i style="background:#eb459e"></i><p><strong>Astro</strong>Zero unnecessary JavaScript</p></div>
      <div class="pm-feed-photo"><Image src={workspace} alt="" widths={[400, 800]} sizes="260px" /></div>
      <div class="pm-msg"><i style="background:#57f287"></i><p><strong>GitHub</strong>Every change tracked</p></div>
      <div class="pm-score"><b>100</b><span>Performance</span></div>
      <div class="pm-msg"><i style="background:#5865f2"></i><p><strong>Cloudflare</strong>Served from the edge</p></div>
      <div class="pm-msg"><i style="background:#fee75c"></i><p><strong>Reb</strong>Loads in under a second</p></div>
      <div class="pm-msg"><i style="background:#eb459e"></i><p><strong>Astro</strong>Scores 90-100 by default</p></div>
    </div>
  </div>
)}
{kind === 'phone' && (
  <div class="pm pm-phone" aria-hidden="true">
    <div class="pm-phone-in">
      <div class="pm-phone-head"><span>←</span><p><strong># rebirth</strong><small><i></i>Loads in under a second</small></p></div>
      <div class="pm-phone-photo"><Image src={street} alt="" widths={[320, 640]} sizes="300px" /></div>
      <div class="pm-msg"><i style="background:#eb459e"></i><p><strong>Heros</strong>Bold first impressions</p></div>
      <div class="pm-msg"><i style="background:#57f287"></i><p><strong>Call-to-Action</strong>Bookings, enquiries, calls</p></div>
      <div class="pm-input">+ Message Reb</div>
      <div class="pm-tabs"><span class="is-on">Pages</span><span>Blog</span><span>Contact</span></div>
      <div class="pm-swatches">{[...tones, ...tones].map((t) => <i style={`background:${t}`}></i>)}</div>
    </div>
  </div>
)}
{kind === 'edge' && (
  <div class="pm pm-edge" aria-hidden="true">
    <Image src={city} alt="" widths={[420, 840]} sizes="410px" class="pm-edge-photo" />
    <div class="pm-edge-panel">
      <div class="pm-edge-head"><LogoMark size={26} /><p><strong>Rebirth</strong><small>Edge / Cloudflare network</small></p></div>
      <ul>
        <li class="is-title">Delivery</li>
        <li><i style="background:#57f287"></i>Static pages</li>
        <li><i style="background:#eb459e"></i>Nearest node</li>
        <li><i style="background:#5865f2"></i>Backups<small>Automatic</small></li>
        <li class="is-bar"><b></b><span>100</span></li>
        <li>Security scanning</li>
        <li>Uptime monitoring</li>
        <li>Instant alerts</li>
        <li><i style="background:#fee75c"></i>Updates</li>
        <li><i style="background:#57f287"></i>Preview deploy</li>
      </ul>
    </div>
  </div>
)}
{kind === 'chat' && (
  <div class="pm pm-chat" aria-hidden="true">
    <div class="pm-chat-head">⌄ <strong>ask reb</strong></div>
    <div class="pm-chat-grid">
      <div class="is-ghost"><span>Ask Reb</span></div>
      <div class="is-photo is-on"><Image src={room} alt="" widths={[240, 480]} sizes="160px" /></div>
      <div style="background:#f5c9ff"></div>
      <div class="is-photo"><Image src={neon} alt="" widths={[240, 480]} sizes="160px" /></div>
      <div style="background:#a259ff"><LogoMark size={40} /></div>
    </div>
    <div class="pm-chat-tools"><i></i><i></i><i></i><i></i><i class="is-hot"></i></div>
  </div>
)}

<style>
  .pm { container-type: inline-size; width: 100%; font-family: var(--font-abc-ginto-discord); color: var(--color-white); text-align: left; overflow: hidden; box-sizing: border-box; }
  .pm :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pm-msg { display: flex; gap: 2.6cqw; align-items: flex-start; }
  .pm-msg i { width: 7cqw; height: 7cqw; border-radius: 50%; flex: none; }
  .pm-msg p { margin: 0; font-size: 2.9cqw; line-height: 1.35; color: rgba(255, 255, 255, 0.85); white-space: nowrap; }
  .pm-msg strong { display: block; font-weight: 500; color: #f47fff; }

  /* desktop window crop: 409×577 at 1680, radius 24 0 0 0, bleeds right + bottom */
  .pm-desktop { aspect-ratio: 1096 / 1544; background: #0b0b10; border-radius: 24px 0 0 0; display: flex; position: relative; bottom: -1px; right: -1px; }
  .pm-rail { width: 12cqw; flex: none; display: flex; flex-direction: column; align-items: center; gap: 2.4cqw; padding-top: 4.5cqw; }
  .pm-rail b { width: 7.4cqw; height: 7.4cqw; border-radius: 2.2cqw; background: #1c1d26; display: grid; place-items: center; }
  .pm-rail b.is-on { background: var(--color-blurple); }
  .pm-rail b :global(svg) { width: 4.6cqw; height: 4.6cqw; }
  .pm-list { width: 38cqw; flex: none; background: #121218; margin-top: 4.5cqw; border-radius: 2.4cqw 0 0 0; overflow: hidden; }
  .pm-list-photo { position: relative; height: 20cqw; }
  .pm-list-photo span { position: absolute; left: 2.6cqw; top: 2.6cqw; font-size: 2.6cqw; font-weight: 500; }
  .pm-list ul, .pm-edge ul { list-style: none; margin: 0; padding: 3cqw 2cqw; display: flex; flex-direction: column; gap: 0.8cqw; }
  .pm-list li { font-size: 2.5cqw; line-height: 1; padding: 1.7cqw 2cqw; border-radius: 1.4cqw; color: rgba(255, 255, 255, 0.55); display: flex; gap: 1.6cqw; white-space: nowrap; }
  .pm-list li em, .pm-feed-head em { font-style: normal; opacity: 0.6; }
  .pm-list li.is-on { background: rgba(255, 255, 255, 0.1); color: var(--color-white); }
  .pm-feed { flex: 1; min-width: 0; margin-top: 4.5cqw; background: #17171f; display: flex; flex-direction: column; gap: 3.4cqw; padding: 0 0 0 3cqw; }
  .pm-feed-head { height: 9cqw; flex: none; display: flex; align-items: center; gap: 1.6cqw; font-size: 2.6cqw; font-weight: 500; white-space: nowrap; }
  .pm-feed-head span { font-weight: 400; opacity: 0.5; font-size: 2.2cqw; }
  .pm-feed-photo { height: 24cqw; flex: none; margin-left: 9.6cqw; border-radius: 2cqw 0 0 2cqw; overflow: hidden; }
  .pm-score { margin-left: 9.6cqw; display: flex; align-items: center; gap: 2.4cqw; font-size: 2.6cqw; }
  .pm-score b { width: 13cqw; height: 13cqw; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-abc-ginto-discord-nord); font-weight: 800; font-size: 3.4cqw; color: var(--color-spring-green); box-shadow: inset 0 0 0 1.2cqw var(--color-spring-green); }

  /* phone: 329×605 at 1680, bleeds past the frame bottom */
  .pm-phone { aspect-ratio: 329.4 / 605.2; background: #050507; border-radius: 12% 12% 0 0 / 6.5% 6.5% 0 0; padding: 2.4% 2.4% 0; }
  .pm-phone-in { height: 100%; background: #17171f; border-radius: 9.8cqw 9.8cqw 0 0; padding: 7cqw 5cqw 0; box-sizing: border-box; display: flex; flex-direction: column; gap: 5cqw; overflow: hidden; }
  .pm-phone .pm-msg { gap: 4cqw; } .pm-phone .pm-msg i { width: 10.5cqw; height: 10.5cqw; } .pm-phone .pm-msg p { font-size: 4cqw; }
  .pm-phone-head { display: flex; gap: 4cqw; align-items: center; font-size: 4.6cqw; padding-bottom: 4cqw; }
  .pm-phone-head p { margin: 0; line-height: 1.3; } .pm-phone-head strong { display: block; font-weight: 500; }
  .pm-phone-head small { font-size: 3.4cqw; opacity: 0.7; display: flex; align-items: center; gap: 1.4cqw; }
  .pm-phone-head small i { width: 2cqw; height: 2cqw; border-radius: 50%; background: var(--color-spring-green); }
  .pm-phone-photo { height: 34cqw; flex: none; border-radius: 3cqw; overflow: hidden; }
  .pm-input { background: #23232c; border-radius: 6cqw; padding: 4cqw 5cqw; font-size: 4cqw; color: rgba(255, 255, 255, 0.5); }
  .pm-tabs { display: flex; background: #101016; border-radius: 3cqw; padding: 1cqw; font-size: 3.4cqw; text-align: center; margin-top: 3cqw; }
  .pm-tabs span { flex: 1; padding: 2.4cqw 0; border-radius: 2.4cqw; color: rgba(255, 255, 255, 0.6); } .pm-tabs .is-on { background: #2c2c36; color: #fff; }
  .pm-swatches { display: grid; grid-template-columns: repeat(6, 1fr); gap: 3cqw; }
  .pm-swatches i { aspect-ratio: 1; border-radius: 2.4cqw; }

  /* edge panel: 409×506 at 1680, bleeds right */
  .pm-edge { aspect-ratio: 409.4 / 505.8; position: relative; border-radius: 16px 0 0 16px; }
  .pm-edge :global(.pm-edge-photo) { position: absolute; inset: 0; }
  .pm-edge-panel { position: absolute; left: 7cqw; top: 4cqw; bottom: 0; width: 65cqw; background: rgba(24, 24, 28, 0.94); border-radius: 1.4cqw 1.4cqw 0 0; overflow: hidden; }
  .pm-edge-head { display: flex; gap: 3cqw; align-items: center; padding: 3.6cqw 3.6cqw; background: #26262c; }
  .pm-edge-head p { margin: 0; line-height: 1.25; font-size: 3cqw; } .pm-edge-head strong { display: block; font-size: 3.8cqw; font-weight: 500; } .pm-edge-head small { font-size: 2.8cqw; opacity: 0.75; }
  .pm-edge-head :global(svg) { width: 7cqw; height: 7cqw; flex: none; }
  .pm-edge ul { padding: 4cqw 3.6cqw; gap: 4.6cqw; }
  .pm-edge li { font-size: 3cqw; line-height: 1; display: flex; align-items: center; gap: 2.4cqw; white-space: nowrap; }
  .pm-edge li i { width: 7.6cqw; height: 7.6cqw; border-radius: 50%; flex: none; margin: -1.4cqw 0; }
  .pm-edge li small { opacity: 0.6; font-size: 2.6cqw; }
  .pm-edge li.is-title { padding-bottom: 3cqw; box-shadow: 0 1px 0 rgba(255, 255, 255, 0.1); }
  .pm-edge li.is-bar b { flex: 1; height: 0.8cqw; border-radius: 1cqw; background: var(--color-spring-green); } .pm-edge li.is-bar span { font-size: 2.2cqw; opacity: 0.7; }

  /* assistant panel inside the indigo frame */
  .pm-chat { height: 100%; background: #000; border-radius: 24px 0 0 24px; padding: 5.4% 0 0 10%; display: flex; flex-direction: column; }
  .pm-chat-head { font-size: 2.4cqw; display: flex; gap: 3cqw; opacity: 0.9; } .pm-chat-head strong { font-weight: 500; }
  .pm-chat-grid { display: grid; grid-template-columns: repeat(6, 18.2cqw); grid-auto-rows: 35cqw; gap: 1.6cqw; margin: 5cqw 0 0 12cqw; }
  .pm-chat-grid > div { grid-column: span 2; border-radius: 1.6cqw; overflow: hidden; display: grid; place-items: center; box-sizing: border-box; }
  .pm-chat-grid > div:nth-child(4) { grid-column: 2 / span 2; } .pm-chat-grid > div:nth-child(5) { grid-column: 4 / span 2; }
  .pm-chat-grid .is-ghost { background: #6b6b76; } .pm-chat-grid .is-ghost span { background: #fff; color: #000; font-size: 2cqw; font-weight: 500; padding: 1.2cqw 2cqw; border-radius: 1cqw; }
  .pm-chat-grid .is-on { box-shadow: inset 0 0 0 0.6cqw var(--color-spring-green); padding: 0.6cqw; }
  .pm-chat-grid .is-on :global(img) { border-radius: 1.2cqw; }
  .pm-chat-tools { margin: 3cqw 4cqw 0 auto; display: flex; gap: 2.2cqw; background: #17171d; padding: 1.6cqw 3cqw; border-radius: 2cqw; }
  .pm-chat-tools i { width: 5.6cqw; height: 5.6cqw; border-radius: 1.6cqw; background: #2a2a33; } .pm-chat-tools i.is-hot { background: #f23f42; }
</style>
