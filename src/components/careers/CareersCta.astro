---
// careers-cta — reference: div.download-banner.bottom-small.is-update (618px tall @1680):
// closing headline + CTA with two objects that drift in opposite directions on scroll.
import CareersGlowButton from './CareersGlowButton.astro';
import CareersObject from './CareersObject.astro';
import Starfield from '../global/Starfield.astro';
---
<section data-section="careers-cta" class="careers-cta relative overflow-clip py-[150px] text-center md:py-[140px] [@media(min-width:1440px)]:py-[160px]">
  <Starfield density={0.5} seed={41} class="careers-cta__stars" />
  <div class="px-[6vw] md:px-40 xl:px-[80px] [@media(min-width:1440px)]:px-[120px]">
    <div class="relative z-2 mx-auto max-w-[944px] [@media(min-width:1440px)]:max-w-[1800px]">
      <div class="relative mx-auto flex max-w-full flex-col items-center md:max-w-[550px] [@media(min-width:1440px)]:max-w-[582px]">
        <h2 class="mb-16 font-abc-ginto-discord-nord text-[32px] leading-none font-bold tracking-[-0.01em] text-white uppercase md:mb-24 md:text-[56px] md:tracking-[-0.03em] [@media(min-width:1440px)]:text-[72px] [@media(min-width:1440px)]:leading-[0.9]">Start your project</h2>
        <p class="font-abc-ginto-discord text-[16px] leading-[22px] text-white md:text-body-xl md:leading-[26px]">Modern websites, built to last. Start your project and see what makes Rebirth a special place to build!</p>
        <div class="h-[32px] md:h-40"></div>
        <div data-careers-float="cta-a" class="pointer-events-none absolute top-[-140px] left-[-8px] w-[120px] md:top-[-160px] md:left-[-101px] md:w-[144px] xl:top-[-100px] xl:left-[-259px] xl:w-[180px] [@media(min-width:1440px)]:left-[-334px] [@media(min-width:1440px)]:w-[200px]">
          <CareersObject kind="cursor" class="h-auto w-full" />
        </div>
        <div data-careers-float="cta-b" class="pointer-events-none absolute top-[232px] right-[-16px] w-[120px] md:top-[228px] md:right-[-101px] md:w-[144px] xl:top-[200px] xl:right-[-207px] xl:w-[180px] [@media(min-width:1440px)]:top-[198px] [@media(min-width:1440px)]:right-[-300px] [@media(min-width:1440px)]:w-[200px]">
          <CareersObject kind="cube" class="h-auto w-full" />
        </div>
        <CareersGlowButton variant="blurple" href="#" size="md">Learn More</CareersGlowButton>
      </div>
    </div>
  </div>
</section>
<style>
  .careers-cta { background: linear-gradient(180deg, #000 0%, #020208 22%, #0a0a22 62%, #11112e 100%); }
  .careers-cta :global(.careers-cta__stars) { opacity: 0.25; -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 60%); mask-image: linear-gradient(180deg, transparent 0%, #000 60%); }
</style>
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const root = document.querySelector<HTMLElement>('[data-section="careers-cta"]');
  if (root) {
    // IX2 "careers-scroll" (SCROLLING_IN_VIEW on the banner, smoothing 50), 0% -> 100%:
    // left object y -45 -> 150px, right object y -150 -> 30px.
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      const st = { trigger: root, start: 'top bottom', end: 'bottom top', scrub: 0.5 };
      gsap.fromTo(root.querySelector('[data-careers-float="cta-a"]'), { y: -45 }, { y: 150, ease: 'none', scrollTrigger: st });
      gsap.fromTo(root.querySelector('[data-careers-float="cta-b"]'), { y: -150 }, { y: 30, ease: 'none', scrollTrigger: { ...st } });
    });
  }
</script>
