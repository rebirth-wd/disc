---
// Compact CTA used across the careers page: the shared Button primitive at the size measured on the
// reference careers page (48–57px tall, 16px/500 label) plus the "circle-hover" glow that fades in on hover.
import Button from '@components/global/Button.astro';
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'a'> {
  variant?: 'white' | 'blurple';
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  glow?: boolean;
  class?: string;
}
const {
  variant = 'blurple',
  href = '#',
  size = 'sm',
  glow = true,
  class: cls = '',
  ...rest
} = Astro.props;
const sizes = {
  sm: 'h-[48px]! px-24! py-0!', // 48px — hero "See All Jobs", FAQ "See All"
  md: 'h-[40px]! px-16! py-0! text-[14px]! leading-[18px]! md:h-[52px]! md:px-20! md:text-[16px]! md:leading-[24px]! xl:px-24!', // closing CTA
  lg: 'h-[54px]! px-24! py-0! md:h-[57px]!', // banner
};
---

<span
  data-glow-btn
  class:list={['careers-glow-btn relative inline-flex overflow-clip rounded-md', cls]}
>
  <Button
    variant={variant}
    href={href}
    class={`text-[16px]! leading-[24px]! font-medium! tracking-normal! ${sizes[size]}`}
    {...rest}
  >
    <slot />
  </Button>
  {glow && <span data-glow class="careers-glow-btn__glow" aria-hidden="true"></span>}
</span>
<style>
  .careers-glow-btn :global(.rb-btn__label) {
    position: relative;
    z-index: 3;
  }
  .careers-glow-btn :global(.rb-btn--white:hover) {
    background-color: var(--color-fog);
  }
  .careers-glow-btn__glow {
    position: absolute;
    left: 50%;
    top: 45px;
    width: 200%;
    height: 70px;
    margin-left: -100%;
    border-radius: 50%;
    background: #1f1d5d;
    filter: blur(30px);
    opacity: 0;
    pointer-events: none;
    z-index: 2;
  }
</style>
<script>
  import gsap from 'gsap';
  // IX2 "Hover-btn-circle": opacity 0 -> 1 in 200ms on mouseover, 1 -> 0 in 200ms on mouseout (linear)
  document.querySelectorAll<HTMLElement>('[data-glow-btn]').forEach((btn) => {
    const glow = btn.querySelector<HTMLElement>('[data-glow]');
    if (!glow) return;
    btn.addEventListener('mouseenter', () =>
      gsap.to(glow, { opacity: 1, duration: 0.2, ease: 'none', overwrite: true }),
    );
    btn.addEventListener('mouseleave', () =>
      gsap.to(glow, { opacity: 0, duration: 0.2, ease: 'none', overwrite: true }),
    );
  });
</script>
