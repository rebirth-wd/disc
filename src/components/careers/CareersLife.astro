---
// careers-life — reference: short div.careers-section.is-update holding only the centred section heading (256px @1680).
---
<section data-section="careers-life" class="relative pt-[100px] md:pt-[120px] [@media(min-width:1440px)]:pt-[160px]">
  <div class="px-[6vw] md:px-40 xl:px-[80px] [@media(min-width:1440px)]:px-[120px]">
    <div class="mx-auto max-w-[1538px] px-24 md:px-40">
      <div class="mx-auto flex max-w-full flex-col items-center text-center md:max-w-[90%] xl:max-w-[870px] [@media(min-width:1440px)]:max-w-[958px]">
        <h2 class="mb-16 font-abc-ginto-discord-nord text-[8.2vw] leading-none font-bold tracking-[-0.01em] text-white uppercase md:mb-24 md:text-[40px] md:tracking-[-0.02em] [@media(min-width:1440px)]:text-heading-lg">Life with&nbsp;Rebirth</h2>
      </div>
      <div class="h-16 md:h-24"></div>
    </div>
  </div>
</section>
