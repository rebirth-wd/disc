---
// Original flat icon set used by the benefit cards (bare) and the stack carousel (inside a gradient badge).
interface Props { name: string; badge?: number | null; size?: number; class?: string }
const { name, badge = null, size = 72, class: cls = '' } = Astro.props;
// palettes: [badge from, badge to, main, accent]
const palettes = [
  ['#8f99ff', '#5865f2', '#ffffff', '#57f287'],
  ['#ff7ad1', '#a13fd6', '#ffffff', '#fee75c'],
  ['#3b3fc4', '#1a2081', '#b9b4ff', '#eb459e'],
  ['#57f287', '#1fa35c', '#0f1250', '#ffffff'],
  ['#c7a6ff', '#7a4df0', '#ffffff', '#35ed7e'],
  ['#fee75c', '#f29a3f', '#1a2081', '#eb459e'],
];
const p = badge === null ? ['', '', '#8f99ff', '#eb459e'] : palettes[badge % palettes.length];
const main = badge === null ? 'url(#cg-main)' : p[2];
const acc = p[3];
const glyphs: Record<string, string> = {
  spark: `<path d="m24 4 5.2 14.8L44 24l-14.8 5.2L24 44l-5.2-14.8L4 24l14.8-5.2Z" fill="${main}"/><rect x="36" y="6" width="6" height="6" fill="${acc}"/>`,
  bolt: `<path d="M28 3 9 27h11l-4 18 22-26H26Z" fill="${main}"/><path d="M20 27 16 45l8-18Z" fill="${acc}"/>`,
  layers: `<path d="m24 5 19 10-19 10L5 15Z" fill="${acc}"/><path d="m5 23 19 10 19-10v7L24 40 5 30Z" fill="${main}"/><path d="m5 32 19 10 19-10" stroke="${main}" stroke-width="3" fill="none" opacity=".55"/>`,
  shield: `<path d="M24 4 42 10v13c0 11-7 18-18 21C13 41 6 34 6 23V10Z" fill="${main}"/><path d="m16 23 6 6 11-12" stroke="${acc}" stroke-width="5" fill="none" stroke-linecap="square"/>`,
  globe: `<circle cx="24" cy="24" r="19" fill="${main}"/><path d="M5 24h38M24 5c-9 9-9 29 0 38M24 5c9 9 9 29 0 38" stroke="${acc}" stroke-width="3" fill="none"/>`,
  chat: `<path d="M6 8h36v24H22l-10 9v-9H6Z" fill="${main}"/><rect x="14" y="17" width="5" height="5" fill="${acc}"/><rect x="22" y="17" width="5" height="5" fill="${acc}"/><rect x="30" y="17" width="5" height="5" fill="${acc}"/>`,
  code: `<path d="M17 10 4 24l13 14 5-5-8-9 8-9ZM31 10l13 14-13 14-5-5 8-9-8-9Z" fill="${main}"/><rect x="21" y="20" width="6" height="8" fill="${acc}"/>`,
  rocket: `<path d="M24 3c9 7 12 17 9 29H15C12 20 15 10 24 3Z" fill="${main}"/><path d="M15 26 7 36h9ZM33 26l8 10h-9Z" fill="${acc}"/><circle cx="24" cy="18" r="5" fill="${acc}"/><path d="m19 35 5 10 5-10Z" fill="${acc}"/>`,
  gauge: `<path d="M4 34a20 20 0 1 1 40 0Z" fill="${main}"/><path d="m24 34 10-16-5 17Z" fill="${acc}"/><rect x="4" y="37" width="40" height="5" fill="${acc}"/>`,
  heart: `<path d="M8 8h12v4h8V8h12v4h4v14h-4v4h-4v4h-4v4h-4v4h-8v-4h-4v-4h-4v-4H8v-4H4V12h4Z" fill="${main}"/><rect x="12" y="13" width="6" height="6" fill="${acc}"/>`,
  window: `<rect x="4" y="7" width="40" height="34" rx="6" fill="${main}"/><rect x="4" y="7" width="40" height="10" rx="5" fill="${acc}"/><rect x="10" y="23" width="12" height="12" fill="${acc}" opacity=".7"/><rect x="26" y="23" width="12" height="4" fill="${acc}" opacity=".7"/><rect x="26" y="31" width="8" height="4" fill="${acc}" opacity=".7"/>`,
  cube: `<path d="m24 3 18 10v22L24 45 6 35V13Z" fill="${main}"/><path d="m24 3 18 10-18 10L6 13Z" fill="${acc}"/><path d="M24 23v22" stroke="${acc}" stroke-width="3"/>`,
  tag: `<path d="M4 6h20l20 20-18 18L6 24Z" fill="${main}"/><rect x="11" y="12" width="7" height="7" fill="${acc}"/>`,
  mail: `<path d="M4 9h40v30H4Z" fill="${main}"/><path d="m4 9 20 16L44 9" stroke="${acc}" stroke-width="4" fill="none"/>`,
  pin: `<path d="M24 3c9 0 15 6 15 15 0 10-15 27-15 27S9 28 9 18C9 9 15 3 24 3Z" fill="${main}"/><rect x="19" y="13" width="10" height="10" fill="${acc}"/>`,
  star: `<path d="m24 3 6 14 15 1-11 10 4 15-14-8-14 8 4-15L3 18l15-1Z" fill="${main}"/><rect x="21" y="19" width="6" height="6" fill="${acc}"/>`,
};
const body = glyphs[name] ?? glyphs.spark;
---
{badge === null ? (
  <svg class={cls} width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
    <defs><linearGradient id="cg-main" x1="6" y1="4" x2="42" y2="44" gradientUnits="userSpaceOnUse"><stop stop-color="#a9b0ff" /><stop offset="1" stop-color="#5865f2" /></linearGradient></defs>
    <Fragment set:html={body} />
  </svg>
) : (
  <svg class={cls} width={size} height={size} viewBox="0 0 120 120" fill="none" aria-hidden="true" focusable="false">
    <defs><linearGradient id={`cg-b${badge}`} x1="10" y1="6" x2="110" y2="114" gradientUnits="userSpaceOnUse"><stop stop-color={p[0]} /><stop offset="1" stop-color={p[1]} /></linearGradient></defs>
    <circle cx="60" cy="60" r="60" fill={`url(#cg-b${badge})`} />
    <g transform="translate(30 30) scale(1.25)"><Fragment set:html={body} /></g>
  </svg>
)}
