---
// careers-values — reference: first div.careers-section.is-update (y 1061–3172 @1680):
// centred intro with a parallax object, then two alternating photo / text rows.
import CareersObject from './CareersObject.astro';
import CareersPhoto from './CareersPhoto.astro';
import developer from '../../assets/photos/careers-values-developer.jpg';
import collab from '../../assets/photos/careers-values-collab.jpg';
const h3 = 'mb-16 font-abc-ginto-discord-nord text-[6.16vw] leading-[1.1] font-bold tracking-[-0.01em] text-white uppercase md:mb-24 md:text-[32px] md:leading-none [@media(min-width:1440px)]:text-heading';
const body = 'font-abc-ginto-discord text-[16px] leading-[22px] text-white md:text-body-xl md:leading-[26px]';
const photo = 'aspect-[648/872] w-full rounded-[56px] md:rounded-[64px] [@media(min-width:1440px)]:w-[85%] [@media(min-width:1440px)]:rounded-[72px]';
---
<section id="careers-values" data-section="careers-values" class="relative pt-[100px] md:pt-[120px] [@media(min-width:1440px)]:pt-[160px]">
  <div class="px-[6vw] md:px-40 xl:px-[80px] [@media(min-width:1440px)]:px-[120px]">
    <div class="relative z-2 mx-auto max-w-[944px] [@media(min-width:1440px)]:max-w-[1538px]">
      <div class="relative mx-auto flex max-w-[697px] flex-col items-center [@media(min-width:1440px)]:max-w-[897px]">
        <h2 class="mb-16 text-center font-abc-ginto-discord-nord text-[8.2vw] leading-none font-bold tracking-[-0.01em] text-white uppercase md:mb-24 md:text-[40px] md:tracking-[-0.02em] [@media(min-width:1440px)]:text-heading-lg">Modern tech, proven at scale</h2>
        <div data-careers-float="bot" class="pointer-events-none absolute top-[-180px] right-[-20px] w-[122px] md:top-[-234px] md:right-[-48px] md:w-[160px] xl:right-[-100px] [@media(min-width:1440px)]:top-[-205px] [@media(min-width:1440px)]:right-[-113px]">
          <CareersObject kind="window" class="h-auto w-full" />
        </div>
        <p class:list={[body, 'text-center']}>Now that Astro is part of Cloudflare's world-class suite, your website is built and hosted by a single infrastructure powerhouse — one of the internet's core backbones, trusted by millions of businesses worldwide.</p>
      </div>
      <div class="h-[100px] xl:h-[120px] [@media(min-width:1440px)]:h-[100px]"></div>
      <div>
        <div class="careers-row mb-56 md:mb-[80px] [@media(min-width:1440px)]:mb-[120px]">
          <CareersPhoto src={developer} alt="A developer smiling at his laptop" sizes="(min-width: 1440px) 570px, (min-width: 768px) 432px, 88vw" position="52% 50%" class={photo} />
          <div>
            <h3 class={h3}>A direct line to the developer</h3>
            <p class={body}>You work with the person writing the code — not an account manager, not an offshore team. Architecture decisions, changes, and fixes come from one Bundaberg-based developer who knows your entire stack, from the first sketch to the day it ships.</p>
          </div>
        </div>
        <div class="careers-row">
          <div class="order-2 md:order-none">
            <h3 class={h3}>Maintained, not left to rot</h3>
            <p class={body}>Astro, dependencies, and integrations are kept current — security patches and framework updates are tested against a preview deploy before they ever hit production.</p>
          </div>
          <CareersPhoto src={collab} alt="Two colleagues talking through ideas at a laptop" sizes="(min-width: 1440px) 570px, (min-width: 768px) 432px, 88vw" position="60% 50%" class={`${photo} md:justify-self-end`} />
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .careers-row { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center; position: relative; }
  @media (min-width: 768px) { .careers-row { grid-template-columns: 1fr 1fr; gap: 80px; } }
  @media (min-width: 1440px) { .careers-row { gap: 100px; } }
</style>
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const root = document.querySelector<HTMLElement>('[data-section="careers-values"]');
  if (root) {
    // IX2 "Parallax-job-cloud" (SCROLLING_IN_VIEW on the section, smoothing 50): 0% -> 50%: y 0 -> 100px, then holds.
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: 0.5 } })
        .to(root.querySelector('[data-careers-float="bot"]'), { y: 100, duration: 0.5 })
        .to({}, { duration: 0.5 });
    });
  }
</script>
