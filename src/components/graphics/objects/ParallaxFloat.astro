---
import type { HTMLAttributes } from 'astro/types';
/**
 * A floating decor object with scroll parallax (smoothing 80):
 * translateY goes `from` → `to` while an invisible 2000px-tall trigger travels through the viewport
 * (progress 0 when the trigger's top meets the viewport bottom, 1 when its bottom leaves the top).
 * The inner element carries an idle float loop (the parallax itself only moves with scroll).
 *
 * Position the object with `class` (styles live in the Feature component). `triggerTop` is a CSS length for the
 * trigger's offset from the section top (the decor layer spans the section).
 */
interface Props extends HTMLAttributes<'div'> {
  class?: string;
  from: number;
  to: number;
  ease?: 'none' | 'ease';
  triggerTop: string;
  triggerHeight?: number;
  front?: boolean;
  floatY?: number;
  floatRot?: number;
  floatDur?: number;
}
const {
  class: cls = '',
  from,
  to,
  ease = 'none',
  triggerTop,
  triggerHeight = 2000,
  front = false,
  floatY = 8,
  floatRot = 3,
  floatDur = 3.6,
  ...rest
} = Astro.props;
---

<div
  class="parallax-float__trigger"
  data-parallax-float-trigger
  style={`top:${triggerTop};height:${triggerHeight}px;`}
></div>
<div
  class:list={['parallax-float', cls]}
  data-parallax-float
  data-from={from}
  data-to={to}
  data-ease={ease}
  data-float-y={floatY}
  data-float-rot={floatRot}
  data-float-dur={floatDur}
  {...(front ? { 'data-decor-front': '' } : {})}
  {...rest}
>
  <div class="parallax-float__inner" data-parallax-float-inner>
    <slot />
  </div>
</div>

<style>
  .parallax-float__trigger {
    position: absolute;
    left: 0;
    width: 0;
    pointer-events: none;
  }
  .parallax-float {
    will-change: transform;
  }
  .parallax-float__inner {
    width: 100%;
    height: 100%;
  }
  .parallax-float__inner :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>

<script>
  import { gsap, ease, motion, onPage, MQ } from '@lib/motion';

  onPage(() => {
    document.querySelectorAll<HTMLElement>('[data-parallax-float]').forEach((el, i) => {
      const trigger = el.previousElementSibling as HTMLElement | null;
      const inner = el.querySelector<HTMLElement>('[data-parallax-float-inner]');
      const from = Number(el.dataset.from);
      const to = Number(el.dataset.to);

      // scroll parallax — runs on ≥768 only
      motion(
        el,
        () => {
          if (!trigger) return;
          const tween = gsap.fromTo(
            el,
            { y: from },
            {
              y: to,
              // CSS `ease` — the easing between the coin's two keyframes
              ease: el.dataset.ease === 'ease' ? ease.css : 'none',
              scrollTrigger: { trigger, start: 'top bottom', end: 'bottom top', scrub: 0.8 },
            },
          );
          return () => {
            tween.scrollTrigger?.kill();
            tween.kill();
            gsap.set(el, { clearProps: 'transform' });
          };
        },
        MQ.md,
      );

      // idle float
      motion(el, () => {
        if (!inner) return;
        const dy = Number(el.dataset.floatY) || 0;
        const rot = Number(el.dataset.floatRot) || 0;
        const dur = Number(el.dataset.floatDur) || 3.6;
        const tween = gsap.fromTo(
          inner,
          { y: -dy, rotation: -rot },
          {
            y: dy,
            rotation: rot,
            duration: dur,
            ease: 'sine.inOut',
            repeat: -1,
            yoyo: true,
            delay: -i * 0.9,
          },
        );
        return () => {
          tween.kill();
          gsap.set(inner, { clearProps: 'transform' });
        };
      });
    });
  });
</script>
