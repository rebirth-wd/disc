---
// Original floating objects for the feature sections (soft 3D-ish, chunky, flat-shaded).
//  orb    – blurred ringed planet (far field)        222×244
//  cube   – blurred code cube (far field)            270×276
//  stack  – sharp isometric server stack (near)      217×208
//  peeker – sharp star critter that peeks and blinks 147×94 (looping, GIF-like)
interface Props {
  kind: 'orb' | 'cube' | 'stack' | 'peeker';
}
const { kind } = Astro.props;
---

{kind === 'orb' && (
  <svg
    class="feature-objects feature-objects--blur"
    viewBox="0 0 222 244"
    width="222"
    height="244"
    aria-hidden="true"
  >
    <defs>
      <radialGradient id="feature-objects-orb-g" cx="0.36" cy="0.3" r="0.8">
        <stop offset="0" stop-color="#d9b8ff" />
        <stop offset="0.55" stop-color="#8a6cf2" />
        <stop offset="1" stop-color="#4a3cc0" />
      </radialGradient>
    </defs>
    <ellipse
      cx="111"
      cy="128"
      rx="104"
      ry="30"
      fill="none"
      stroke="#49d6c8"
      stroke-width="14"
      transform="rotate(-18 111 128)"
      opacity="0.9"
    />
    <circle cx="111" cy="122" r="78" fill="url(#feature-objects-orb-g)" />
    <circle cx="84" cy="96" r="17" fill="#49b9d6" opacity="0.85" />
    <circle cx="138" cy="150" r="24" fill="#49b9d6" opacity="0.75" />
    <circle cx="150" cy="92" r="9" fill="#49b9d6" opacity="0.7" />
    <circle cx="78" cy="160" r="10" fill="#49b9d6" opacity="0.7" />
    <path
      d="M12 160c40 26 150 0 200-58"
      fill="none"
      stroke="#49d6c8"
      stroke-width="14"
      stroke-linecap="round"
      opacity="0.9"
    />
  </svg>
)}
{kind === 'cube' && (
  <svg
    class="feature-objects feature-objects--blur"
    viewBox="0 0 270 276"
    width="270"
    height="276"
    aria-hidden="true"
  >
    <path d="M135 22l104 54v118l-104 60L31 194V76z" fill="#8f7bf7" />
    <path d="M135 22l104 54-104 58L31 76z" fill="#c9b8ff" />
    <path d="M135 134l104-58v118l-104 60z" fill="#e85ad0" />
    <path
      d="M74 132l-18 22 18 30M100 146l18 30-18 22"
      fill="none"
      stroke="#fff"
      stroke-width="9"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.85"
    />
    <circle cx="188" cy="150" r="16" fill="#fff" opacity="0.7" />
  </svg>
)}
{kind === 'stack' && (
  <svg class="feature-objects" viewBox="0 0 217 208" width="217" height="208" aria-hidden="true">
    <g transform="rotate(-8 108 104)">
      {[0, 1, 2].map((i) => (
        <g transform={`translate(0 ${100 - i * 42})`}>
          <path d="M108 0l88 34v30l-88 38-88-38V34z" fill={['#6d5ad6', '#8f7bf7', '#b9a8ff'][i]} />
          <path d="M108 0l88 34-88 38-88-38z" fill={['#a999ff', '#cfc2ff', '#efeaff'][i]} />
          <path d="M108 72l88-38v30l-88 38z" fill={['#c23bd0', '#dd4fe0', '#f070ea'][i]} />
          <circle cx="42" cy="58" r="5" fill="#35ed7e" data-led />
          <circle cx="60" cy="66" r="5" fill="#35ed7e" data-led />
          <path
            d="M128 78l44-19"
            stroke="#fff"
            stroke-width="5"
            stroke-linecap="round"
            opacity="0.75"
          />
        </g>
      ))}
    </g>
  </svg>
)}
{kind === 'peeker' && (
  <svg
    class="feature-objects"
    data-feature-objects-peeker
    viewBox="0 0 147 94"
    width="147"
    height="94"
    aria-hidden="true"
    style="overflow:visible"
  >
    <g data-peek-body>
      <path
        d="M73.500 4l17 30 34 6-24 25 5 35-32-16-32 16 5-35-24-25 34-6z"
        fill="#fee75c"
        stroke="#fee75c"
        stroke-width="12"
        stroke-linejoin="round"
      />
      <path
        d="M73.500 12l12 24"
        stroke="#fff"
        stroke-width="5"
        stroke-linecap="round"
        opacity="0.55"
      />
      <g data-peek-eyes fill="#23272a">
        <ellipse cx="60" cy="56" rx="5" ry="7" />
        <ellipse cx="87" cy="56" rx="5" ry="7" />
      </g>
      <path
        d="M66 70q7.500 6 15 0"
        fill="none"
        stroke="#23272a"
        stroke-width="3.200"
        stroke-linecap="round"
      />
      <circle cx="50" cy="68" r="5" fill="#eb459e" opacity="0.6" />
      <circle cx="97" cy="68" r="5" fill="#eb459e" opacity="0.6" />
    </g>
  </svg>
)}

<style>
  .feature-objects {
    display: block;
    max-width: none;
  }
  .feature-objects--blur {
    filter: blur(5px);
  }
</style>

<script>
  import gsap from 'gsap';
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<SVGElement>('[data-feature-objects-peeker]').forEach((svg) => {
      const body = svg.querySelector('[data-peek-body]');
      const eyes = svg.querySelector('[data-peek-eyes]');
      // 3.2s GIF-like loop: pop up, look around, blink twice, duck back
      const tl = gsap.timeline({ repeat: -1, defaults: { ease: 'sine.inOut' } });
      tl.fromTo(
        body,
        { y: 60, rotation: -6, svgOrigin: '73.5 94' },
        { y: 0, rotation: 0, duration: 0.45, ease: 'back.out(1.8)' },
      )
        .to(body, { rotation: 7, duration: 0.5 }, 0.6)
        .to(body, { rotation: -7, duration: 0.6 }, 1.1)
        .to(body, { rotation: 0, duration: 0.4 }, 1.7)
        .to(
          eyes,
          {
            scaleY: 0.1,
            svgOrigin: '73.5 56',
            duration: 0.07,
            yoyo: true,
            repeat: 3,
            repeatDelay: 0.12,
          },
          0.8,
        )
        .to(body, { y: -7, duration: 0.25, yoyo: true, repeat: 1 }, 2.1)
        .to(body, { y: 60, rotation: -6, duration: 0.4, ease: 'power2.in' }, 2.8);
    });
    document.querySelectorAll('.feature-objects [data-led]').forEach((led, i) => {
      gsap.to(led, {
        opacity: 0.25,
        duration: 0.5,
        repeat: -1,
        yoyo: true,
        delay: (i % 3) * 0.3,
        ease: 'steps(1)',
      });
    });
  });
</script>
