---
/**
 * Media loop for the leads feature — original "live enquiry feed": a cursor walks down a list of scored leads and a
 * detail card opens beside the hovered row. 7.4s seamless GSAP loop.
 */
import LoopStage from './LoopStage.astro';
const leads = [
  {
    n: 'Olivia M.',
    s: 'Chat · wants a quote',
    c: '#c4a7ff',
    i: 'OM',
    score: 92,
    note: 'Needs a 6-page site before March. Budget confirmed.',
    tag: 'Ready to buy',
  },
  {
    n: "Dan's Diesel",
    s: 'Form · new website',
    c: '#57f287',
    i: 'DD',
    score: 88,
    note: 'Old site is slow on mobile. Asked for a call back.',
    tag: 'Ready to buy',
  },
  {
    n: 'Reef Tours',
    s: 'Call-back · bookings',
    c: '#6fb1ff',
    i: 'RT',
    score: 81,
    note: 'Wants online bookings live before peak season.',
    tag: 'Warm lead',
  },
  {
    n: 'Marlo Café',
    s: 'Chat · menu update',
    c: '#e3e4ea',
    i: 'MC',
    score: 64,
    note: 'Existing client. Small content change requested.',
    tag: 'Quick win',
  },
];
const idle = ['Guest 2214', 'Guest 0937', 'Guest 5120'];
const idleC = ['#5b6fb8', '#3f8f6b', '#8a5aa0'];
---

<LoopStage>
  <div class="lead-feed" data-lead-feed>
    <div class="lead-feed__panel">
      <div class="lead-feed__head">
        <span>Hot leads — 4</span>
        <svg viewBox="0 0 12 12" width="12" height="12">
          <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </div>
      {leads.map((l, k) => (
        <div class="lead-feed__row" style={`top:${46 + k * 45}px`}>
          <i class="lead-feed__hl" data-lead-feed-hl></i>
          <span class="lead-feed__av" style={`background:${l.c}`}>
            {l.i}
            <b></b>
          </span>
          <span class="lead-feed__txt">
            <em style={`color:${l.c}`}>{l.n}</em>
            <small>{l.s}</small>
          </span>
        </div>
      ))}
      <div class="lead-feed__head lead-feed__head--2">
        <span>Just browsing — 3</span>
      </div>
      {idle.map((n, k) => (
        <div class="lead-feed__row is-idle" style={`top:${277 + k * 42}px`}>
          <span class="lead-feed__av" style={`background:${idleC[k]}`}></span>
          <span class="lead-feed__txt">
            <em style={`color:${idleC[k]}`}>{n}</em>
          </span>
        </div>
      ))}
    </div>
    {leads.map((l, k) => (
      <div class="lead-feed__pop" data-lead-feed-pop style={`top:${60 + k * 45}px`}>
        <div class="lead-feed__pop-top">
          <span class="lead-feed__av lead-feed__av--sm" style={`background:${l.c}`}>
            {l.i}
          </span>
          <span class="lead-feed__pop-name">
            {l.n}
            <small>{l.tag}</small>
          </span>
          <span class="lead-feed__score">{l.score}</span>
        </div>
        <p>{l.note}</p>
        <div class="lead-feed__bar">
          <i style={`width:${l.score}%`}></i>
        </div>
        <div class="lead-feed__reply">Reply drafted</div>
      </div>
    ))}
    <svg class="lead-feed__cursor" data-lead-feed-cursor viewBox="0 0 36 36" width="36" height="36">
      <path
        d="M4 3 31 16 19 20 14 32Z"
        fill="#fff"
        stroke="#15151c"
        stroke-width="2.5"
        stroke-linejoin="round"
      />
    </svg>
  </div>
</LoopStage>

<style>
  .lead-feed {
    position: absolute;
    inset: 0;
    color: #fff;
  }
  .lead-feed__panel {
    position: absolute;
    left: 89px;
    top: 45px;
    width: 274px;
    height: 447px;
    border-radius: 16px;
    background: #1b1b22;
  }
  .lead-feed__head {
    position: absolute;
    left: 21px;
    right: 18px;
    top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    line-height: 16px;
    color: #b9bac6;
  }
  .lead-feed__head--2 {
    top: 247px;
  }
  .lead-feed__row {
    position: absolute;
    left: 20px;
    width: 233px;
    height: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 4px;
  }
  .lead-feed__row.is-idle {
    opacity: 0.55;
  }
  .lead-feed__hl {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    opacity: 0;
  }
  .lead-feed__av {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 500;
    color: #1b1b22;
  }
  .lead-feed__av b {
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-signal-green);
    outline: 3px solid #1b1b22;
  }
  .lead-feed__av--sm {
    width: 24px;
    height: 24px;
    font-size: 9px;
  }
  .lead-feed__txt {
    position: relative;
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .lead-feed__txt em {
    font-style: normal;
    font-size: 16px;
  }
  .lead-feed__txt small {
    font-size: 11.5px;
    color: #c9cad3;
    margin-top: 2px;
  }
  .lead-feed__pop {
    position: absolute;
    left: 382px;
    width: 230px;
    padding: 10px 12px 12px;
    border-radius: 10px;
    background: #24242c;
    opacity: 0;
  }
  .lead-feed__pop-top {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lead-feed__pop-name {
    flex: 1;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.15;
    display: flex;
    flex-direction: column;
  }
  .lead-feed__pop-name small {
    font-size: 9.5px;
    font-weight: 400;
    color: #b9bac6;
  }
  .lead-feed__score {
    font-size: 11px;
    font-weight: 500;
    color: #10321f;
    background: var(--color-spring-green);
    border-radius: 6px;
    padding: 2px 6px;
  }
  .lead-feed__pop p {
    margin: 9px 0 8px;
    font-size: 10.5px;
    line-height: 1.35;
    color: #dcdde4;
  }
  .lead-feed__bar {
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .lead-feed__bar i {
    display: block;
    height: 100%;
    background: var(--color-fuchsia);
    border-radius: 2px;
  }
  .lead-feed__reply {
    margin-top: 9px;
    font-size: 10px;
    text-align: center;
    padding: 5px 0;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: #b9bac6;
  }
  .lead-feed__cursor {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(318px, 232px);
    overflow: visible;
  }
</style>

<script>
  import { gsap, media, motion, onPage, playWhileInView, MOTION_REDUCE } from '@lib/motion';

  onPage(() => {
    document.querySelectorAll<HTMLElement>('[data-lead-feed]').forEach((root) => {
      const cursor = root.querySelector('[data-lead-feed-cursor]');
      const hls = gsap.utils.toArray<HTMLElement>('[data-lead-feed-hl]', root);
      const pops = gsap.utils.toArray<HTMLElement>('[data-lead-feed-pop]', root);
      motion(root, () => {
        const STEP = 1.85; // 4 rows × 1.85s = 7.4s
        const pos = (k: number) => ({ x: 318 - (k % 2) * 14, y: 97 + k * 45 });
        gsap.set(cursor, pos(3)); // loop starts where it ends
        gsap.set(pops, { opacity: 0, y: 8, scale: 0.96, transformOrigin: '0% 20%' });
        const tl = gsap.timeline({ repeat: -1, paused: true });
        hls.forEach((hl, k) => {
          const t = k * STEP;
          tl.to(cursor, { ...pos(k), duration: 0.5, ease: 'power2.inOut' }, t)
            .to(hl, { opacity: 1, duration: 0.15, ease: 'none' }, t + 0.4)
            .to(
              pops[k],
              { opacity: 1, y: 0, scale: 1, duration: 0.28, ease: 'power2.out' },
              t + 0.5,
            )
            .to(
              pops[k],
              { opacity: 0, y: 8, scale: 0.96, duration: 0.2, ease: 'power1.in' },
              t + STEP - 0.2,
            )
            .to(hl, { opacity: 0, duration: 0.15, ease: 'none' }, t + STEP - 0.05);
        });
        // last highlight fades during the first 0.1s of the next cycle → wrap it so the loop is exact
        tl.set(hls[hls.length - 1], { opacity: 0 }, 4 * STEP);
        const st = playWhileInView(root, tl);
        return () => {
          st.kill();
          tl.kill();
        };
      });
      // reduced motion / no JS: show the first lead's card
      media(
        root,
        () => {
          gsap.set(cursor, { x: 318, y: 97 });
          gsap.set(hls[0], { opacity: 1 });
          gsap.set(pops[0], { opacity: 1 });
        },
        MOTION_REDUCE,
      );
    });
  });
</script>
