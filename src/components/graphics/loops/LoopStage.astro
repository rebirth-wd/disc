---
/**
 * Fixed-size design stage (727×554 = the media inset at desktop) that scales uniformly with its parent,
 * so the animated graphics keep their proportions when the inset shrinks on smaller viewports.
 */
interface Props {
  w?: number;
  h?: number;
  class?: string;
}
const { w = 727, h = 554, class: cls = '' } = Astro.props;
---

<div class:list={['loop-stage__wrap', cls]} data-loop-stage-wrap data-w={w} aria-hidden="true">
  <div class="loop-stage" data-loop-stage style={`width:${w}px;height:${h}px;`}>
    <slot />
  </div>
</div>

<style>
  .loop-stage__wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .loop-stage {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    transform: scale(var(--loop-stage-s, 1));
    font-family: var(--font-body);
  }
</style>

<script>
  import { onPage, disposeOn } from '@lib/motion';

  onPage((signal) => {
    document.querySelectorAll<HTMLElement>('[data-loop-stage-wrap]').forEach((wrap) => {
      const w = Number(wrap.dataset.w) || 727;
      const apply = () => {
        const cw = wrap.clientWidth;
        if (cw) wrap.style.setProperty('--loop-stage-s', String(cw / w));
      };
      apply();
      const ro = new ResizeObserver(apply);
      ro.observe(wrap);
      disposeOn(signal, ro);
    });
  });
</script>
