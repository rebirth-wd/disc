---
// Deterministic (seeded) starfield: square "pixel" stars + plus-shaped sparkles.
// Fills its positioned parent; pointer-events none.
interface Props {
  density?: number;
  class?: string;
  seed?: number;
}
const { density = 1, class: cls = '', seed = 7 } = Astro.props;

function mulberry32(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(seed);
const r2 = (n: number) => Math.round(n * 100) / 100;
const nStars = Math.round(70 * density);
const nPlus = Math.round(14 * density);
const stars = Array.from({ length: nStars }, () => ({
  x: r2(rnd() * 100),
  y: r2(rnd() * 100),
  s: [2, 2, 2, 3, 3, 4][Math.floor(rnd() * 6)],
  o: r2(0.35 + rnd() * 0.65),
  d: r2(rnd() * 6),
  t: r2(2.4 + rnd() * 3.6),
  tw: rnd() < 0.3,
}));
const plus = Array.from({ length: nPlus }, () => ({
  x: r2(rnd() * 100),
  y: r2(rnd() * 100),
  s: [10, 12, 14, 18, 22][Math.floor(rnd() * 5)],
  o: r2(0.6 + rnd() * 0.4),
  d: r2(rnd() * 6),
  t: r2(3 + rnd() * 4),
  tw: rnd() < 0.6,
}));
---

<div data-starfield class:list={['starfield', cls]} aria-hidden="true">
  <div class="starfield__layer" data-star-layer="far">
    {stars.map((s) => (
      <i
        class:list={['starfield__star', s.tw && 'starfield__star--tw']}
        style={`left:${s.x}%;top:${s.y}%;width:${s.s}px;height:${s.s}px;--o:${s.o};--d:-${s.d}s;--t:${s.t}s`}
      />
    ))}
  </div>
  <div class="starfield__layer" data-star-layer="near">
    {plus.map((p) => (
      <i
        class:list={['starfield__plus', p.tw && 'starfield__plus--tw']}
        style={`left:${p.x}%;top:${p.y}%;width:${p.s}px;height:${p.s}px;--o:${p.o};--d:-${p.d}s;--t:${p.t}s`}
      />
    ))}
  </div>
</div>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .starfield__layer {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .starfield__star,
  .starfield__plus {
    position: absolute;
    display: block;
    background: var(--color-white);
    opacity: var(--o);
  }
  .starfield__plus {
    /* plus-shaped sparkle */
    clip-path: polygon(
      42% 0,
      58% 0,
      58% 42%,
      100% 42%,
      100% 58%,
      58% 58%,
      58% 100%,
      42% 100%,
      42% 58%,
      0 58%,
      0 42%,
      42% 42%
    );
    transform: translate(-50%, -50%);
  }
  /* Twinkle: opacity 0 -> (1s wait) -> 1 over 0.5s easeIn -> hold 2s (or 1s)
     -> 0 over 0.5s easeIn, looping. 4s cycle (variant b: 3s on-phase split). */
  .starfield__star--tw,
  .starfield__plus--tw {
    animation: starfield__twinkle 4s ease-in var(--d) infinite;
  }
  .starfield__star--tw:nth-child(3n),
  .starfield__plus--tw:nth-child(2n) {
    animation-name: starfield__twinkle-b;
    animation-duration: 7s;
  }
  @keyframes starfield__twinkle {
    0%,
    25% {
      opacity: 0;
    }
    37.5%,
    87.5% {
      opacity: var(--o);
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes starfield__twinkle-b {
    0%,
    14.3% {
      opacity: 0;
    }
    21.4%,
    35.7% {
      opacity: var(--o);
    }
    42.9%,
    57.1% {
      opacity: 0;
    }
    64.3%,
    92.9% {
      opacity: var(--o);
    }
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .starfield__star--tw,
    .starfield__plus--tw {
      animation: none;
    }
  }
</style>
