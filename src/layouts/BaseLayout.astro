---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
interface Props { title: string; description?: string; active?: string; chrome?: boolean }
const { title, description = 'Rebirth Web Design — fast, secure, static-first websites.', active = '', chrome = true } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
  </head>
  <body>
    <div class="page-wrapper">
      {chrome && <Header active={active} />}
      <main><slot /></main>
      {chrome && <Footer />}
    </div>
  </body>
</html>
