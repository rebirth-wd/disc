---
// /ads/quests — "Launch your website with us". Layout + motion follow the reference
// B2B page; copy from content/rebirth-copy.md. Sections live in src/components/quests/.
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuestsSubnav from '../../components/quests/QuestsSubnav.astro';
import QuestsHero from '../../components/quests/QuestsHero.astro';
import QuestsSteps from '../../components/quests/QuestsSteps.astro';
import QuestsSolutions from '../../components/quests/QuestsSolutions.astro';
import QuestsImpact from '../../components/quests/QuestsImpact.astro';
import QuestsPlatform from '../../components/quests/QuestsPlatform.astro';
import QuestsLogos from '../../components/quests/QuestsLogos.astro';
import QuestsStories from '../../components/quests/QuestsStories.astro';
import QuestsCta from '../../components/quests/QuestsCta.astro';
---
<BaseLayout title="Launch your site — Rebirth Web Design" active="quests">
  <!--
    --q-canvas is the page canvas every edge-fade in the sections blends into.
    DESIGN.md gives the canvas as Deep Indigo; the reference page itself is #000.
    Change this one value to switch.
  -->
  <div class="quests-page" data-page="quests">
    <div class="quests-spacer" data-section="quests-spacer" aria-hidden="true"></div>
    <QuestsSubnav />
    <QuestsHero />
    <QuestsSteps />
    <QuestsSolutions />
    <QuestsImpact />
    <QuestsPlatform />
    <QuestsLogos />
    <QuestsStories />
    <QuestsCta />
  </div>
</BaseLayout>

<style>
  .quests-page {
    --q-canvas: var(--color-black);
    position: relative;
    background: var(--q-canvas);
    color: var(--color-white);
  }
  /* reference: div.navbar_spacer 80px, removed below 992px */
  .quests-spacer { display: none; height: 80px; }
  @media (min-width: 992px) { .quests-spacer { display: block; } }
  /* reference: main gets padding-top 80px at <=479px */
  @media (max-width: 479px) { .quests-page { padding-top: 80px; } }
</style>

<style is:global>
  /* Shared section scaffolding for the quests page (reference classes
     .testimonials-section.is-60 / .padding-global.is_2026 / .container-944px / .heading--h2-new / .body-text-new--xll) */
  .quests-page .q-sec { position: relative; padding: 50px 0; }
  .quests-page .q-pad { box-sizing: border-box; padding: 0 6vw; }
  .quests-page .q-wrap { position: relative; max-width: 944px; margin: 0 auto; }
  .quests-page .q-h2 {
    margin: 0 0 var(--spacing-16);
    text-align: center;
    color: var(--color-white);
    font-family: var(--font-abc-ginto-discord-nord);
    font-weight: var(--font-weight-bold);
    font-size: 8.2vw;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .quests-page .q-lead { margin: 0 auto; text-align: center; color: var(--color-white); font-size: var(--text-body); line-height: 22px; }
  .quests-page .q-title { margin-bottom: 32px; }
  @media (min-width: 480px) {
    .quests-page .q-sec { padding: 60px 0; }
    .quests-page .q-pad { padding: 0 var(--spacing-40); }
    .quests-page .q-h2 { font-size: 40px; line-height: 40px; letter-spacing: -0.4px; }
    .quests-page .q-lead { font-size: var(--text-body-xl); line-height: 26px; }
    .quests-page .q-title { margin-bottom: var(--spacing-48); }
  }
  @media (min-width: 992px) {
    .quests-page .q-pad { padding: 0 80px; }
    .quests-page .q-h2 { margin-bottom: var(--spacing-20); }
  }
  @media (min-width: 1440px) {
    .quests-page .q-sec { padding: 80px 0; }
    .quests-page .q-pad { padding: 0 120px; }
    .quests-page .q-wrap { max-width: 1200px; }
    .quests-page .q-h2 { margin-bottom: var(--spacing-24); font-size: var(--text-heading-lg); line-height: 48px; letter-spacing: -0.96px; }
    .quests-page .q-title { margin-bottom: var(--spacing-64); }
  }
</style>
