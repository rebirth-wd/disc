---
// Home page assembly.
//
// Stacking: HomeBackground is an absolutely positioned z-index:0 layer, first in the DOM. Every section root
// is positioned (z-index auto or higher) so it paints above it in tree order. The wrapper itself must NOT
// create a stacking context: the closing banner's character block (z-index 100) has to beat the footer
// (z-index 98) in the root context.
import BaseLayout from '@layouts/BaseLayout.astro';
import HomeBackground from '@components/sections/home/HomeBackground.astro';
import Hero from '@components/sections/home/Hero.astro';
import FeatureAssistant from '@components/sections/home/FeatureAssistant.astro';
import FeatureSpeed from '@components/sections/home/FeatureSpeed.astro';
import FeatureMonitoring from '@components/sections/home/FeatureMonitoring.astro';
import Marquee from '@components/sections/home/Marquee.astro';
import FeatureLeads from '@components/sections/home/FeatureLeads.astro';
import FeatureContent from '@components/sections/home/FeatureContent.astro';
import FeatureDevices from '@components/sections/home/FeatureDevices.astro';
import ClosingBanner from '@components/sections/home/ClosingBanner.astro';
---

<BaseLayout title="Rebirth Web Design — High-performance websites" active="index">
  <div class="home-root">
    <HomeBackground />
    <Hero />
    <FeatureAssistant />
    <FeatureSpeed />
    <FeatureMonitoring />
    <Marquee />
    <FeatureLeads />
    <FeatureContent />
    <FeatureDevices />
    <ClosingBanner />
  </div>
</BaseLayout>

<style>
  .home-root {
    position: relative;
  }
  /* guard: a non-positioned section would paint underneath the background layer */
  .home-root > :global([data-section]) {
    position: relative;
  }
</style>
