---
import BaseLayout from '@layouts/BaseLayout.astro';
import { pages } from '@data/pages';
import CareersHero from '@components/sections/careers/CareersHero.astro';
import CareersValues from '@components/sections/careers/CareersValues.astro';
import CareersBanner from '@components/sections/careers/CareersBanner.astro';
import CareersLife from '@components/sections/careers/CareersLife.astro';
import CareersCards from '@components/sections/careers/CareersCards.astro';
import CareersParty from '@components/sections/careers/CareersParty.astro';
import CareersFaq from '@components/sections/careers/CareersFaq.astro';
import CareersCta from '@components/sections/careers/CareersCta.astro';
---

<BaseLayout page={pages['/careers']} active="careers">
  <div data-page="careers" class="bg-black text-white">
    <CareersHero />
    <CareersValues />
    <!-- job-listings section intentionally omitted (DECISIONS #9) -->
    <CareersBanner />
    <CareersLife />
    <CareersCards />
    <CareersParty />
    <CareersFaq />
    <CareersCta />
  </div>
</BaseLayout>
