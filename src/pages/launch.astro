---
// /launch — "Launch your website with us". Copy from docs/source-copy.md. Sections live in src/components/sections/launch/.
import BaseLayout from '@layouts/BaseLayout.astro';
import LaunchSubnav from '@components/sections/launch/LaunchSubnav.astro';
import LaunchHero from '@components/sections/launch/LaunchHero.astro';
import LaunchSteps from '@components/sections/launch/LaunchSteps.astro';
import LaunchSolutions from '@components/sections/launch/LaunchSolutions.astro';
import LaunchImpact from '@components/sections/launch/LaunchImpact.astro';
import LaunchPlatform from '@components/sections/launch/LaunchPlatform.astro';
import LaunchLogos from '@components/sections/launch/LaunchLogos.astro';
import LaunchStories from '@components/sections/launch/LaunchStories.astro';
import LaunchCta from '@components/sections/launch/LaunchCta.astro';
---

<BaseLayout title="Launch your site — Rebirth Web Design" active="launch">
  <!--
    --launch-canvas is the page canvas every edge-fade in the sections blends into.
    DESIGN.md gives the canvas as Deep Indigo; the page itself is #000.
    Change this one value to switch.
  -->
  <div class="launch-page" data-page="launch">
    <div class="launch-spacer" data-section="quests-spacer" aria-hidden="true"></div>
    <LaunchSubnav />
    <LaunchHero />
    <LaunchSteps />
    <LaunchSolutions />
    <LaunchImpact />
    <LaunchPlatform />
    <LaunchLogos />
    <LaunchStories />
    <LaunchCta />
  </div>
</BaseLayout>

<style>
  .launch-page {
    --launch-canvas: var(--color-black);
    position: relative;
    background: var(--launch-canvas);
    color: var(--color-white);
  }
  /* 80px header spacer, removed below 992px */
  .launch-spacer {
    display: none;
    height: 80px;
  }
  @media (min-width: 992px) {
    .launch-spacer {
      display: block;
    }
  }
  /* padding-top 80px at <=479px */
  @media (max-width: 479px) {
    .launch-page {
      padding-top: 80px;
    }
  }
</style>

<style is:global>
  /* Shared section scaffolding for the launch page */
  .launch-page .launch-section {
    position: relative;
    padding: 50px 0;
  }
  .launch-page .launch-pad {
    box-sizing: border-box;
    padding: 0 6vw;
  }
  .launch-page .launch-wrap {
    position: relative;
    max-width: 944px;
    margin: 0 auto;
  }
  .launch-page .launch-h2 {
    margin: 0 0 var(--spacing-16);
    text-align: center;
    color: var(--color-white);
    font-family: var(--font-abc-ginto-discord-nord);
    font-weight: var(--font-weight-bold);
    font-size: 8.2vw;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .launch-page .launch-lead {
    margin: 0 auto;
    text-align: center;
    color: var(--color-white);
    font-size: var(--text-body);
    line-height: 22px;
  }
  .launch-page .launch-title {
    margin-bottom: 32px;
  }
  @media (min-width: 480px) {
    .launch-page .launch-section {
      padding: 60px 0;
    }
    .launch-page .launch-pad {
      padding: 0 var(--spacing-40);
    }
    .launch-page .launch-h2 {
      font-size: 40px;
      line-height: 40px;
      letter-spacing: -0.4px;
    }
    .launch-page .launch-lead {
      font-size: var(--text-body-xl);
      line-height: 26px;
    }
    .launch-page .launch-title {
      margin-bottom: var(--spacing-48);
    }
  }
  @media (min-width: 992px) {
    .launch-page .launch-pad {
      padding: 0 80px;
    }
    .launch-page .launch-h2 {
      margin-bottom: var(--spacing-20);
    }
  }
  @media (min-width: 1440px) {
    .launch-page .launch-section {
      padding: 80px 0;
    }
    .launch-page .launch-pad {
      padding: 0 120px;
    }
    .launch-page .launch-wrap {
      max-width: 1200px;
    }
    .launch-page .launch-h2 {
      margin-bottom: var(--spacing-24);
      font-size: var(--text-heading-lg);
      line-height: 48px;
      letter-spacing: -0.96px;
    }
    .launch-page .launch-title {
      margin-bottom: var(--spacing-64);
    }
  }
</style>
